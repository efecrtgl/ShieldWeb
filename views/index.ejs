<%- include('partials/header') %>

  <main class="container">
    <section id="about" class="hero" aria-labelledby="home-title">
      <div class="home-hero">
      <div>
      <h1 class="hero-title" id="home-title">EmpireV RolePlay</h1>
      <p class="hero-subtitle">
        Özel scriptler, yüksek FPS optimizasyonu, dengeli ekonomi ve profesyonel yönetim kadrosuyla kendinizi benzersiz bir FiveM rol dünyasının merkezinde bulun.
      </p>

      <div class="hero-actions">
        <a href="<%= locals.discordInviteUrl || 'https://discord.gg/starv' %>" rel="noopener" target="_blank" class="btn btn-primary">
          <i class="fa-brands fa-discord" aria-hidden="true"></i> Discord topluluğuna katıl
        </a>
        <% if (!locals.user) { %>
          <a href="/auth/login" class="btn btn-secondary">Whitelist başvurusu</a>
        <% } else if (user.isSuperuser || (locals.userPermissions && Object.values(locals.userPermissions).some(v => v === true))) { %>
          <a href="/admin/dashboard" class="btn btn-secondary">Yönetim paneli</a>
        <% } else { %>
          <a href="/applications" class="btn btn-secondary">Başvurularım</a>
        <% } %>
      </div>
      </div>
      <img class="home-hero-img" src="/images/screen1.jpg" alt="Los Santos, gece: kumarhane önünde sıralanmış modifiyeli araçlar" width="1024" height="1024" fetchpriority="high">
      </div>

      <% if (!locals.modules || locals.modules.stats !== false) { %>
      <!-- Live server status, read from /api/stats. Unknown values stay a dash; nothing is estimated. -->
      <div class="home-status" id="home-status" aria-live="polite">
        <div>
          <div class="label">Sunucu</div>
          <span class="value" data-home="server">—</span>
          <div class="note" data-home="server-note">Durum alınıyor…</div>
        </div>
        <div>
          <div class="label">Oyundaki oyuncular</div>
          <span class="value" data-home="players">—</span>
          <div class="note" data-home="players-note">&nbsp;</div>
        </div>
        <div>
          <div class="label">Whitelist'li oyuncular</div>
          <span class="value" data-home="whitelist">—</span>
          <div class="note">Discord üzerinden onaylı</div>
        </div>
      </div>

      <div class="home-pillars">
        <div>
          <h2>Özel script altyapısı</h2>
          <p>EmpireV ekibi tarafından özel olarak geliştirilen, sıfır gecikmeli ve yüksek performanslı scriptler.</p>
        </div>
        <div>
          <h2>Dengeli ekonomi</h2>
          <p>Legal ve illegal meslekler arasında tam adalet sağlayan, uzun soluklu ve gerçekçi finansal altyapı.</p>
        </div>
        <div>
          <h2>Kesintisiz destek</h2>
          <p>Taleplerinize yanıt veren yetkili ve teknik destek ekibiyle güvenli oyun ortamı.</p>
        </div>
      </div>

      <div class="content-panel" style="text-align: left; max-width: 900px; margin: 0 0 80px; padding: 32px;">
        <h2 style="font-size: 22px; font-weight: 600; margin-bottom: 14px;">Karakterinizin hikayesi burada başlıyor</h2>
        <p style="color: var(--text-secondary); font-size: 16px; line-height: 1.7; margin-bottom: 14px;">
          EmpireV, rol kalitesini ve oyuncu memnuniyetini en üst seviyede tutmak için tasarlanmış seçkin bir FiveM topluluğudur.
          Sunucumuzda yer alan özel legal/illegal meslek dalları, çete ve holding mekanikleri sayesinde kendi hikayenizi özgürce çizebilirsiniz.
        </p>
        <p style="color: var(--text-secondary); font-size: 16px; line-height: 1.7; margin: 0;">
          Her saniyesinden keyif alacağınız rol ortamını, gelişmiş teknik altyapımız ve kesintisiz sunucu optimizasyonlarımızla destekliyoruz.
        </p>
      </div>

      <script>
        (function () {
          const el = name => document.querySelector(`[data-home="${name}"]`);
          const fmt = n => Number(n).toLocaleString("tr-TR");
          async function load() {
            if (document.hidden) return;
            try {
              const res = await fetch("/api/stats", { headers: { Accept: "application/json" } });
              if (!res.ok) throw new Error(String(res.status));
              const d = await res.json();
              el("server").textContent = d.serverOnline ? "Çevrimiçi" : "Çevrimdışı";
              el("server-note").textContent = d.serverOnline ? "Canlı veri" : (d.lastPollAt ? "Oyun sunucusuna şu anda ulaşılamıyor" : "Durum bilgisi yok");
              el("players").innerHTML = d.serverOnline && d.activePlayers !== null
                ? fmt(d.activePlayers) + (d.maxPlayers ? `<span class="unit"> / ${fmt(d.maxPlayers)}</span>` : "")
                : "—";
              el("players-note").textContent = d.serverOnline ? (d.maxPlayers ? "Slot sayısına göre" : " ") : "Sunucu çevrimdışıyken bilinmez";
              el("whitelist").textContent = d.totalWhitelist !== null && d.totalWhitelist !== undefined ? fmt(d.totalWhitelist) : "—";
            } catch (err) {
              el("server-note").textContent = "Durum şu anda alınamadı";
            }
          }
          load();
          setInterval(load, 30000);
        })();
      </script>
      <% } %>

      <!-- Changelog Section -->
      <div class="changelog-container" style="max-width: 900px; margin: 0 auto; text-align: left;">
        <div class="changelog-header" style="margin-bottom: 36px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end;">
          <div>
            <h3 style="font-family: var(--font-display); font-size: 20px; font-weight: 600; margin-bottom: 6px;  color: #fff; display: flex; align-items: center; gap: 10px;">
              <i class="fa-solid fa-bullhorn" style="color: var(--primary-light);"></i> Güncelleme Notları
            </h3>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Sistem güncellemeleri ve sunucu yenilikleri</p>
          </div>
          <span class="badge badge-primary"><i class="fa-solid fa-clock-rotate-left"></i> Son Güncellemeler</span>
        </div>

        <div class="timeline-wrapper">
          <div class="timeline-line"></div>

          <% if (updates && updates.length > 0) { %>
            <% updates.forEach((update, index) => { %>
              <div class="timeline-item">
                <div class="timeline-dot-container">
                  <div class="timeline-dot <%= index === 0 ? 'active' : '' %>"></div>
                </div>

                <div class="timeline-content-card">
                  <div class="timeline-card-header">
                    <div class="timeline-version-badge">
                      <i class="fa-solid fa-code-commit" style="font-size: 13px; margin-right: 6px;"></i><%= update.title %>
                    </div>
                    <span class="timeline-date"><i class="fa-regular fa-calendar-days"></i>
                      <%= new Date(update.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                    </span>
                  </div>

                  <div class="timeline-card-body">
                    <%- update.description %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="glass-card" style="text-align: center; padding: 40px; color: var(--text-muted);">
              <i class="fa-solid fa-hourglass-empty" style="font-size: 32px; color: var(--primary-light); margin-bottom: 12px; display: inline-block;"></i>
              <p style="margin: 0; font-size: 14px;">Henüz yayınlanmış güncelleme notu bulunmuyor.</p>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>
