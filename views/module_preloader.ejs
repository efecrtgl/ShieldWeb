<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= moduleName %> — Hazırlanıyor</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
  <% if (locals.themeColor) { %>
    <style>
      :root {
        --primary: <%= locals.themeColor %>;
        --primary-glow: rgba(<%= locals.themeColorRgb %>, 0.15);
        --border-focus: rgba(<%= locals.themeColorRgb %>, 0.4);
      }
    </style>
  <% } %>
</head>
<body style="background-color: var(--bg-primary); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px;">
  
  <div style="background: rgba(12, 13, 16, 0.6); border: 1px solid var(--border-color); border-radius: 20px; padding: 48px 32px; text-align: center;   max-width: 500px; width: 100%;">
    
    <!-- Premium Loader -->
    <div style="position: relative; width: 80px; height: 80px; margin: 0 auto 28px auto; display: flex; align-items: center; justify-content: center;">
      <div style="position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 3px solid rgba(0, 113, 227, 0.1); border-top-color: var(--primary); animation: spin 1.2s linear infinite;"></div>
      <div style="color: var(--primary); font-size: 24px;">
        <% if (moduleKey === 'applications') { %>
          <i class="fa-solid fa-file-signature"></i>
        <% } else if (moduleKey === 'donate') { %>
          <i class="fa-solid fa-coins"></i>
        <% } else if (moduleKey === 'gallery') { %>
          <i class="fa-solid fa-images"></i>
        <% } else if (moduleKey === 'stats') { %>
          <i class="fa-solid fa-chart-simple"></i>
        <% } else if (moduleKey === 'team') { %>
          <i class="fa-solid fa-users"></i>
        <% } else if (moduleKey === 'faq') { %>
          <i class="fa-solid fa-circle-question"></i>
        <% } else { %>
          <i class="fa-solid fa-screwdriver-wrench"></i>
        <% } %>
      </div>
    </div>

    <span style="font-size: 11px; font-weight: 600;   color: var(--primary); display: block; margin-bottom: 8px;"><%= moduleName %></span>
    
    <h1 style="font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: var(--text-main); margin-bottom: 12px;">
      Yapım Aşamasında!
    </h1>
    
    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 32px;">
      <%= customMessage || "Bu bölüm şu anda yapım aşamasındadır. En kısa sürede sizlerin hizmetine sunulacaktır. Gösterdiğiniz sabır için teşekkür ederiz." %>
    </p>

    <div style="border-top: 1px solid var(--border-color); padding-top: 24px;">
      <a href="/" class="btn btn-secondary" style="padding: 10px 24px; font-size: 12px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255,255,255,0.02); color: var(--text-main); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: var(--transition);">
        <i class="fa-solid fa-arrow-left"></i> Ana Sayfaya Dön
      </a>
    </div>

  </div>

  <style>
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>

</body>
</html>
