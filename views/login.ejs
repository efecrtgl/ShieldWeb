<%- include('partials/header') %>

<main class="container" style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 200px); padding-top: 140px; padding-bottom: 80px;">
  <div class="content-panel" style="width: 100%; max-width: 400px; text-align: center; display: flex; flex-direction: column; align-items: center;">
    <div style="font-size: 48px; color: var(--primary); margin-bottom: 20px; display: flex; justify-content: center;">
      <i class="fa-brands fa-discord animate-pulse"></i>
    </div>
    <h1 class="panel-title" style="border-left: none; padding-left: 0; justify-content: center; margin-bottom: 12px; display: flex; width: 100%;">
      Shield Giriş
    </h1>
    <p style="color: var(--text-muted); font-size: 13px; line-height: 1.6; margin-bottom: 28px;">
      Geliştirici paneline ve admin araçlarına erişmek için lütfen Discord hesabınızla kimlik doğrulaması gerçekleştirin.
    </p>
    <% if (locals.loginError) { %>
      <div role="alert" style="width: 100%; margin-bottom: 18px; padding: 10px 14px; border-radius: 10px; font-size: 13px; color: #fecaca; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35);">
        <i class="fa-solid fa-circle-exclamation"></i> <%= loginError %>
      </div>
    <% } %>
    <a href="/auth/login<%= (locals.next && locals.next !== '/') ? '?next=' + encodeURIComponent(locals.next) : '' %>" class="btn btn-discord-large" style="width: 100%;">
      <i class="fa-solid fa-sign-in-alt"></i> Discord ile Giriş Yap
    </a>
  </div>
</main>

<%- include('partials/footer') %>
