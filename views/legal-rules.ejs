<style>
  .rules-container {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 40px;
    margin-top: 40px;
    align-items: start;
  }

  .rules-sidebar {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    background: rgba(12, 13, 16, 0.6);
    
    
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 20px;
  }

  .rules-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .rules-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
  }

  .rules-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rules-menu-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .rules-menu-link:hover, .rules-menu-link.active {
    background: rgba(255, 255, 255, 0.03);
    color: var(--primary);
  }
  
  .rules-menu-link.active {
    border-left: 2px solid var(--primary);
    border-radius: 0 8px 8px 0;
    padding-left: 10px;
  }

  .rules-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .rule-section {
    scroll-margin-top: 100px;
  }

  .rule-card {
    background: rgba(12, 13, 16, 0.45);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px;
  }

  .rule-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    margin-top: 0;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rule-title span {
    background: var(--primary);
    
    color: #fff;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    
  }

  .rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .rules-list li {
    font-size: 14px;
    color: var(--text-main);
    line-height: 1.6;
    position: relative;
    padding-left: 20px;
  }

  .rules-list li::before {
    content: "•";
    color: var(--primary);
    font-weight: bold;
    position: absolute;
    left: 0;
    top: 0;
  }

  .rules-alert {
    background: rgba(245, 158, 11, 0.03);
    border: 1px solid rgba(245, 158, 11, 0.15);
    padding: 16px;
    border-radius: 10px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .rules-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }

  .rules-table th, .rules-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    font-size: 13px;
  }

  .rules-table th {
    color: var(--text-muted);
    font-weight: 600;
    background: rgba(255,255,255,0.01);
  }

  .rules-table td {
    color: var(--text-main);
  }

  .badge-hard {
    background: rgba(59, 130, 246, 0.15);
    color: var(--primary);
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 11px;
    
  }

  .badge-arcade {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 11px;
    
  }

  .dept-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .dept-card {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    transition: all 0.2s;
  }

  .dept-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .faq-item {
    border-bottom: 1px solid var(--border-color);
    padding: 16px 0;
  }

  .faq-question {
    font-weight: 700;
    color: #fff;
    font-size: 14.5px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .faq-answer {
    color: var(--text-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .accent-bar {
    background: var(--primary);
    height: 8px;
    border-radius: 4px;
    margin-top: 20px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }

  .accent-bar::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 20%;
    background: #eab308;
  }

  @media (max-width: 991px) {
    .rules-container {
      grid-template-columns: 1fr;
    }
    .rules-sidebar {
      position: static;
      max-height: 300px;
    }
  }
</style>

