<%- include('partials/header') %>

<style>
  @keyframes pulse-red {
    0% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 4px rgba(239, 68, 68, 0);
    }
    100% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
  }
  .live-indicator {
    background-color: #ef4444;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    animation: pulse-red 2s infinite;
  }
</style>

<main class="container">
  <section id="stats" class="section">
    <h2 class="panel-title"><i class="fa-solid fa-chart-simple"></i> Oyun İstatistikleri</h2>
    <div class="main-layout" style="margin-bottom: 30px;">
      <div class="content-panel stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-users"></i>
        </div>
        <div class="stat-info">
          <div class="stat-header">
            <span class="stat-value"><%= stats.activePlayers %> / <%= stats.maxPlayers %></span>
            <span class="stat-label" style="display: flex; align-items: center; gap: 6px;">
              Aktif Oyuncular
              <span class="live-indicator" title="Canlı Güncelleniyor"></span>
            </span>
          </div>
          <% let fillPercent = Math.min(100, Math.max(0, (stats.activePlayers / stats.maxPlayers) * 100)) || 0; %>
          <div class="progress-track">
            <div class="progress-fill" style="width: <%= fillPercent %>%;"></div>
          </div>
        </div>
      </div>

      <div class="content-panel stat-card">
        <div class="stat-icon" style="color: #5865F2;">
          <i class="fa-brands fa-discord"></i>
        </div>
        <div class="stat-info">
          <div class="stat-header">
            <span class="stat-value"><%= stats.totalWhitelist.toLocaleString() %></span>
            <span class="stat-label" style="display: flex; align-items: center; gap: 6px;">
              Discord Whitelist Sayısı
              <span class="live-indicator" title="Canlı Güncelleniyor"></span>
            </span>
          </div>
          <div class="progress-track">
            <div class="progress-fill" style="width: 100%; background-color: #5865F2;"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    async function updateLiveStats() {
      try {
        const response = await fetch("/api/stats");
        const data = await response.json();
        if (data && data.success) {
          // Update player count text
          const valueSpan = document.querySelector(".stat-card:first-child .stat-value");
          if (valueSpan) {
            valueSpan.innerHTML = `${data.activePlayers} / ${data.maxPlayers}`;
          }

          // Update progress bar
          const fillPercent = Math.min(100, Math.max(0, (data.activePlayers / data.maxPlayers) * 100)) || 0;
          const progressFill = document.querySelector(".stat-card:first-child .progress-fill");
          if (progressFill) {
            progressFill.style.width = `${fillPercent}%`;
          }

          // Update whitelist count
          const wlSpan = document.querySelector(".stat-card:nth-child(2) .stat-value");
          if (wlSpan) {
            wlSpan.innerHTML = data.totalWhitelist.toLocaleString();
          }
        }
      } catch (err) {
        console.error("Live stats sync error:", err);
      }
    }

    // Poll live statistics every 3 seconds
    setInterval(updateLiveStats, 3000);
  });
</script>

<%- include('partials/footer') %>
