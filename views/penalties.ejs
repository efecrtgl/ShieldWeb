<script>
  function switchRulesTab(tabName) {
    document.querySelectorAll(".rules-tab-content").forEach(el => {
      el.style.display = "none";
    });
    
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.classList.remove("active");
    });
    
    const targetContent = document.getElementById("rules-" + tabName);
    if (targetContent) {
      targetContent.style.display = "block";
      // Add subtle fade-in animation
      targetContent.style.animation = "fadeUp 0.4s ease-out forwards";
    }
    
    const targetBtn = document.getElementById("tab-" + tabName);
    if (targetBtn) {
      targetBtn.classList.add("active");
    }
  }

  window.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    const activeTab = urlParams.get("tab");
    if (activeTab) {
      switchRulesTab(activeTab);
    }
  });
</script>

