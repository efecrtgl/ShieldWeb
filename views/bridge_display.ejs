<%- include('partials/header') %>

<main class="container" style="max-width: 1400px; margin: 40px auto; padding: 0 20px; font-family: 'Inter', sans-serif; color: #fff;">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
    
    <section style="background: rgba(12, 13, 16, 0.4); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; backdrop-filter: blur(20px); display: flex; flex-direction: column; min-height: 480px;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 20px;">
        <h3 style="margin: 0; font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-gamepad text-primary" style="color: var(--primary);"></i> Aktif Oyuncu Listesi
        </h3>
        <span id="player-count-badge" style="background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #34d399; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700;">0 Oyuncu</span>
      </div>

      <div id="players-grid" style="display: grid; grid-template-columns: 1fr; gap: 12px; max-height: 420px; overflow-y: auto; padding-right: 4px;">
        <div style="text-align: center; color: var(--text-muted); padding: 40px 0;">Sunucudan veri bekleniyor...</div>
      </div>
    </section>

    <section style="background: rgba(12, 13, 16, 0.4); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; backdrop-filter: blur(20px); display: flex; flex-direction: column; min-height: 480px;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 20px;">
        <h3 style="margin: 0; font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-list-check" style="color: var(--primary);"></i> Köprü İşlem Kuyruğu & Komut Gönder
        </h3>
      </div>

      <div style="margin-bottom: 20px; background: rgba(0,0,0,0.2); padding: 16px; border-radius: 12px; border: 1px solid var(--border-color);">
        <h4 style="margin: 0 0 12px 0; font-size: 13px; font-weight: 700;">Yeni Oyun İçi Komut Gönder</h4>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <select id="cmd-action" onchange="adjustFormFields()" style="background: rgba(12,13,16,0.6); border: 1px solid var(--border-color); color: #fff; padding: 8px; border-radius: 6px; font-size: 12px;">
              <option value="execute_command">Konsol Komutu Çalıştır</option>
              <option value="trigger_event">Lua Event'i Fırlat</option>
            </select>
            <input type="text" id="cmd-target" placeholder="Oyuncu ID (İsteğe Bağlı)" style="background: rgba(12,13,16,0.6); border: 1px solid var(--border-color); color: #fff; padding: 8px; border-radius: 6px; font-size: 12px;">
          </div>
          <input type="text" id="cmd-string" placeholder="Komut (Örn: kick 2 'Kural İhlali')" style="background: rgba(12,13,16,0.6); border: 1px solid var(--border-color); color: #fff; padding: 8px; border-radius: 6px; font-size: 12px;">
          <button onclick="submitCommand()" style="background: var(--primary); border: none; color: #fff; padding: 10px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; transition: opacity 0.2s;">
            Komutu Kuyruğa Gönder
          </button>
        </div>
      </div>

      <h4 style="margin: 0 0 10px 0; font-size: 13px; font-weight: 700; color: var(--text-muted);">Kuyrukta Bekleyen İstekler</h4>
      <div id="queue-list" style="display: flex; flex-direction: column; gap: 8px; max-height: 180px; overflow-y: auto; padding-right: 4px;">
        <div style="text-align: center; color: var(--text-muted); padding: 20px 0;">Kuyruk boş.</div>
      </div>
    </section>

  </div>

  <section style="background: rgba(12, 13, 16, 0.4); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; backdrop-filter: blur(20px);">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 20px;">
      <h3 style="margin: 0; font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-server" style="color: var(--primary);"></i> Canlı İstek ve Yanıt Günlüğü
      </h3>
      <span id="logs-count" style="font-size: 12px; color: var(--text-muted);">0 Günlük Kaydı</span>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border-color); color: #fff; font-weight: 700;">
            <th style="padding: 10px 12px;">ZAMAN</th>
            <th style="padding: 10px 12px;">METOD</th>
            <th style="padding: 10px 12px;">ROTA</th>
            <th style="padding: 10px 12px;">İSTEMCİ IP</th>
            <th style="padding: 10px 12px;">DURUM</th>
            <th style="padding: 10px 12px;">GECİKME</th>
            <th style="padding: 10px 12px; text-align: right;">GÖSTER</th>
          </tr>
        </thead>
        <tbody id="logs-list">
          <tr>
            <td colspan="7" style="padding: 20px; text-align: center; color: var(--text-muted);">Veri bekleniyor...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</main>

<script>
  function adjustFormFields() {
    const action = document.getElementById('cmd-action').value;
    const stringField = document.getElementById('cmd-string');
    if (action === 'execute_command') {
      stringField.placeholder = "Komut (Örn: kick 2 'Kural İhlali')";
    } else {
      stringField.placeholder = "Event İsmi (Örn: esx:giveInventoryItem)";
    }
  }

  async function submitCommand() {
    const action = document.getElementById('cmd-action').value;
    const target = document.getElementById('cmd-target').value;
    const cmdStr = document.getElementById('cmd-string').value;

    if (!cmdStr) {
      alert("Komut alanını doldurmalısınız.");
      return;
    }

    try {
      const res = await fetch('/api/fivem/bridge/command', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: action,
          command: cmdStr,
          targetPlayer: target ? parseInt(target, 10) : undefined
        })
      });
      const data = await res.json();
      if (data.success) {
        document.getElementById('cmd-string').value = '';
        document.getElementById('cmd-target').value = '';
        updateDashboard();
      } else {
        alert(data.message || "Hata oluştu.");
      }
    } catch (err) {
      alert("Sunucuya erişilemedi: " + err.message);
    }
  }

  async function quickAction(actionType, targetPlayerId) {
    let cmdStr = "";
    if (actionType === "kick") {
      cmdStr = `kick ${targetPlayerId} 'Yonetici tarafindan oyundan cikarildiniz.'`;
    } else if (actionType === "announcement") {
      const msg = prompt("Duyuru mesajı:");
      if (!msg) return;
      cmdStr = `say ${msg}`;
    }

    try {
      await fetch('/api/fivem/bridge/command', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: "execute_command",
          command: cmdStr
        })
      });
      updateDashboard();
    } catch (err) {
      console.error(err);
    }
  }

  async function updateDashboard() {
    try {
      const playersRes = await fetch('/api/fivem/active-players');
      const queueRes = await fetch('/api/fivem/bridge/queue');
      const logsRes = await fetch('/api/json');

      if (playersRes.ok && queueRes.ok && logsRes.ok) {
        const playersData = await playersRes.json();
        const queueData = await queueRes.json();
        const logsData = await logsRes.json();

        renderPlayers(playersData.players || []);
        renderQueue(queueData.queue || []);
        renderLogs(logsData || []);
      }
    } catch (err) {
      console.error("Dashboard refresh error: ", err);
    }
  }

  function renderPlayers(players) {
    const badge = document.getElementById('player-count-badge');
    badge.innerText = `${players.length} Oyuncu`;

    const container = document.getElementById('players-grid');
    if (players.length === 0) {
      container.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 40px 0;">Sunucuda aktif oyuncu yok.</div>`;
      return;
    }

    let html = '';
    players.forEach((p, idx) => {
      const discId = p.identifiers.find(id => id.startsWith("discord:"))?.split(":")[1] || "";
      const steamId = p.identifiers.find(id => id.startsWith("steam:")) || "Steam Yok";
      const license = p.identifiers.find(id => id.startsWith("license:")) || "Lisans Yok";

      html += `
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 8px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span style="background: var(--primary); color: #fff; padding: 2px 8px; border-radius: 6px; font-weight: 700; font-size: 11px;">ID: ${p.id}</span>
              <span style="font-weight: 700; color: #fff;">${p.name}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 11px; font-family: monospace; color: ${p.ping < 50 ? '#34d399' : '#f87171'};">⚡ ${p.ping}ms</span>
              <button onclick="quickAction('kick', ${p.id})" style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #f87171; padding: 3px 8px; border-radius: 6px; font-size: 11px; cursor: pointer;">
                Kov (Kick)
              </button>
            </div>
          </div>
          <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; display: flex; flex-direction: column; gap: 2px; background: rgba(0,0,0,0.2); padding: 8px; border-radius: 6px;">
            <div>Discord: ${discId ? discId : "Yok"}</div>
            <div>Steam: ${steamId}</div>
            <div>License: ${license}</div>
          </div>
        </div>
      `;
    });
    container.innerHTML = html;
  }

  function renderQueue(queue) {
    const container = document.getElementById('queue-list');
    if (queue.length === 0) {
      container.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 20px 0;">Kuyruk boş.</div>`;
      return;
    }

    let html = '';
    queue.forEach(item => {
      html += `
        <div style="background: rgba(255, 158, 11, 0.08); border: 1px solid #f59e0b; border-radius: 8px; padding: 10px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-weight: 700; font-size: 12px; color: #f59e0b;">${item.action.toUpperCase()}</div>
            <div style="font-family: monospace; font-size: 11px; color: #fff;">${item.command}</div>
          </div>
          <span style="font-size: 10px; color: var(--text-muted); font-family: monospace;">Kuyrukta</span>
        </div>
      `;
    });
    container.innerHTML = html;
  }

  function renderLogs(logs) {
    const filterLogs = logs.filter(l => l.url && l.url.includes("/api/fivem/bridge/"));
    document.getElementById('logs-count').innerText = `${filterLogs.length} Köprü Kaydı`;

    const container = document.getElementById('logs-list');
    if (filterLogs.length === 0) {
      container.innerHTML = `<tr><td colspan="7" style="padding: 20px; text-align: center; color: var(--text-muted);">Köprüye ait henüz hiçbir istek alınmadı.</td></tr>`;
      return;
    }

    let html = '';
    filterLogs.forEach((req, idx) => {
      const isPost = req.method === 'POST';
      const isError = req.statusCode >= 400;

      html += `
        <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted);">
          <td style="padding: 10px 12px; font-family: monospace;">${req.timestamp}</td>
          <td style="padding: 10px 12px;">
            <span style="padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 10px; background: ${isPost ? 'rgba(59, 130, 246, 0.15)' : 'rgba(16, 185, 129, 0.15)'}; color: ${isPost ? '#60a5fa' : '#34d399'};">
              ${req.method}
            </span>
          </td>
          <td style="padding: 10px 12px; color: #fff; font-weight: 600;">${req.url}</td>
          <td style="padding: 10px 12px; font-family: monospace;">${req.ip}</td>
          <td style="padding: 10px 12px;">
            <span style="padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 10px; background: ${isError ? 'rgba(239, 68, 68, 0.15)' : 'rgba(16, 185, 129, 0.15)'}; color: ${isError ? '#f87171' : '#34d399'};">
              ${req.statusCode}
            </span>
          </td>
          <td style="padding: 10px 12px; font-family: monospace;">${req.duration}ms</td>
          <td style="padding: 10px 12px; text-align: right;">
            <button onclick="toggleDetails(${idx})" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 10px; cursor: pointer;">
              Detay
            </button>
          </td>
        </tr>
        <tr id="details-row-${idx}" style="display: none; background: rgba(0, 0, 0, 0.2);">
          <td colspan="7" style="padding: 12px; border-bottom: 1px solid var(--border-color);">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <div style="font-weight: 700; margin-bottom: 4px; font-size: 11px;">Body (Gövde)</div>
                <pre style="margin: 0; background: rgba(0,0,0,0.4); padding: 8px; border-radius: 6px; font-family: monospace; font-size: 10px; color: #34d399; overflow-x: auto;">${escapeHtml(JSON.stringify(req.body, null, 2))}</pre>
              </div>
              <div>
                <div style="font-weight: 700; margin-bottom: 4px; font-size: 11px;">Headers (Başlıklar)</div>
                <pre style="margin: 0; background: rgba(0,0,0,0.4); padding: 8px; border-radius: 6px; font-family: monospace; font-size: 10px; color: #60a5fa; overflow-x: auto;">${escapeHtml(JSON.stringify(req.headers, null, 2))}</pre>
              </div>
            </div>
          </td>
        </tr>
      `;
    });
    container.innerHTML = html;
  }

  function toggleDetails(idx) {
    const el = document.getElementById('details-row-' + idx);
    el.style.display = el.style.display === 'none' ? 'table-row' : 'none';
  }

  function escapeHtml(text) {
    if (!text) return '';
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  updateDashboard();
  setInterval(updateDashboard, 2000);
</script>

<%- include('partials/footer') %>
