<%- include('partials/header') %>

<main class="container">
  
  <!-- Hero Section -->
  <div style="text-align: center; margin-bottom: 72px; position: relative;">
    <div style="display: inline-flex; justify-content: center; align-items: center; width: 64px; height: 64px; background: rgba(56, 189, 248, 0.15); border-radius: 20px; border: 1px solid rgba(56, 189, 248, 0.3); margin-bottom: 20px; ">
      <i class="fa-solid fa-users-gear" style="font-size: 26px; color: var(--primary-light);"></i>
    </div>
    <h1 style="font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 600; margin-bottom: 12px; color: #fff; ">
      Yönetim Ekibi
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 650px; margin: 0 auto; line-height: 1.7;">
      EmpireV'in geliştirilmesi ve düzeninin sağlanması için çalışan değerli yönetim kadromuz.
    </p>
  </div>

  <% if (groupedStaff && groupedStaff.length > 0) { %>
    <% groupedStaff.forEach(group => { %>
      <div style="margin-bottom: 64px;">
        <h2 style="font-family: var(--font-display); font-size: 22px; font-weight: 600; color: <%= group.rankColor || '#fff' %>; margin-bottom: 24px; display: flex; align-items: center; justify-content: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.05);">
          <%= group.rankName %>
        </h2>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 32px; padding: 0 10px;">
          <% group.members.forEach(member => { %>
            <!-- Team Card -->
            <div class="team-card glass-card" style="position: relative; overflow: hidden; padding: 32px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; flex: 1 1 280px; max-width: 320px;">
              
              <!-- Decorative Glow -->
              <div style="position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 140px; height: 140px; background: <%= group.rankColor || 'var(--primary-glow)' %>; opacity: 0.15; filter: blur(40px); border-radius: 50%; pointer-events: none;"></div>
    
              <!-- Avatar -->
              <div style="position: relative; margin-bottom: 24px;">
                <div style="width: 100px; height: 100px; border-radius: 50%; padding: 4px; background: <%= group.rankColor || '#38bdf8' %>; transition: transform 0.4s ease;" class="avatar-container">
                  <img src="<%= member.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="<%= member.username %>" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid rgba(13, 16, 26, 0.9);">
                </div>
                <!-- Role Icon Badge -->
                <div style="position: absolute; bottom: -6px; right: -6px; width: 34px; height: 34px; border-radius: 50%; background: <%= group.rankColor || '#38bdf8' %>; border: 3px solid var(--panel-bg); display: flex; align-items: center; justify-content: center; ">
                  <i class="fa-solid fa-shield-halved" style="color: #fff; font-size: 13px;"></i>
                </div>
              </div>
    
              <!-- Info -->
              <h3 style="font-family: var(--font-display); font-size: 20px; font-weight: 600; color: #fff; margin-bottom: 6px;"><%= member.username %></h3>
              <span style="font-size: 11px; font-weight: 600;   color: <%= group.rankColor || '#38bdf8' %>; background: <%= group.rankColor ? group.rankColor + '15' : 'rgba(56, 189, 248, 0.1)' %>; padding: 4px 10px; border-radius: 6px; margin-bottom: 16px;">
                <%= group.rankName %>
              </span>
              
              <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 24px; font-style: italic;">
                "<%= member.description || 'Yönetim ekibi üyesi.' %>"
              </p>
    
              <!-- Edit Button for Admins -->
              <% if (locals.userPermissions && (userPermissions.isSuperuser || userPermissions.isProjectLeader || userPermissions.editUsers)) { %>
                <button class="btn btn-outline edit-desc-btn" 
                        onclick="handleEditDescClick(this)"
                        data-discord-id="<%= member.discordId %>" 
                        data-desc="<%= member.description %>"
                        style="margin-top: auto; width: 100%; font-size: 12px; padding: 10px; border-color: rgba(255,255,255,0.1);">
                  <i class="fa-solid fa-pen-to-square"></i> Açıklamayı Düzenle
                </button>
              <% } %>
    
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
      <i class="fa-solid fa-user-shield" style="font-size: 42px; margin-bottom: 16px; opacity: 0.3;"></i>
      <p style="margin: 0; font-size: 15px;">Şu an için gösterilecek bir yetkili bulunmuyor.</p>
    </div>
  <% } %>

</main>

<style>
  .team-card {
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .team-card:hover {
    transform: translateY(-8px);
    
    border-color: rgba(255,255,255,0.15) !important;
  }
  .team-card:hover .avatar-container {
    transform: scale(1.05) rotate(5deg);
  }
</style>

<% if (locals.userPermissions && (userPermissions.isSuperuser || userPermissions.isProjectLeader || userPermissions.editUsers)) { %>
  <script>
    function handleEditDescClick(btn) {
      const discordId = btn.getAttribute("data-discord-id");
      const currentDesc = btn.getAttribute("data-desc") || "";
      const newDesc = prompt("Bu ekip üyesi için yeni açıklama girin:", currentDesc);
      
      if (newDesc === null) return;
      
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Kaydediliyor...';
      btn.disabled = true;

      fetch("/team/update-description", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ discordId, description: newDesc })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.reload();
        } else {
          alert("Hata: " + (data.error || "Açıklama güncellenemedi."));
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      })
      .catch(err => {
        console.error(err);
        alert("Bir hata oluştu.");
        btn.innerHTML = originalText;
        btn.disabled = false;
      });
    }
  </script>
<% } %>

<%- include('partials/footer') %>
