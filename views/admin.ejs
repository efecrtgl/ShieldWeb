        <i class="fa-solid fa-magnifying-glass" style="color: var(--primary); font-size: 18px;"></i>
        <input type="text" id="cmd-palette-search"
          placeholder="Sekme, komut veya işlem arayın... (ör. Karakterler, Oyuncular, Ban)"
          oninput="filterCommandPalette()"
          style="background: transparent; border: none; outline: none; color: #ffffff; font-size: 15px; font-family: var(--font-body); width: 100%; font-weight: 500;">
        <span
          style="font-size: 11px; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border-color); padding: 4px 10px; border-radius: 6px; color: var(--text-muted); font-family: monospace; font-weight: 700;">ESC</span>
      </div>

      <!-- Results List -->
      <div id="cmd-palette-results"
        style="max-height: 400px; overflow-y: auto; padding: 12px 14px; display: flex; flex-direction: column; gap: 6px;">
        <!-- Results generated via JavaScript -->
      </div>

      <!-- Footer -->
      <div
        style="padding: 12px 24px; border-top: 1px solid var(--border-color); background: rgba(0, 0, 0, 0.25); display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-muted);">
        <span style="display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-keyboard" style="color: var(--primary);"></i> Gezinmek için arama yapın veya bir öğeye
          tıklayın
        </span>
        <span style="font-family: monospace; opacity: 0.8;">EmpireV v11</span>
      </div>
    </div>
  </div>

  <script>
    // Command Palette Commands Array
    const cmdPaletteItems = [
      { name: 'Genel Bakış Analitikleri', category: 'Genel', icon: 'fa-chart-pie', action: function () { window.location.hash = '#overview'; } },
      { name: 'Aktif Oyuncular (FiveM Live)', category: 'Oyun', icon: 'fa-gamepad', action: function () { window.location.hash = '#active-players-mgmt'; } },
      { name: 'Karakter Listesi (Veritabanı)', category: 'Oyun', icon: 'fa-person-circle-check', action: function () { window.location.hash = '#character-management'; } },
      { name: 'Kullanıcı Yönetimi', category: 'Kullanıcılar', icon: 'fa-users', action: function () { window.location.hash = '#users-settings'; } },
      { name: 'Ekip Yönetimi', category: 'Kullanıcılar', icon: 'fa-people-group', action: function () { window.location.hash = '#teams-settings'; } },
      { name: 'Ceza Paneli & İnfazlar', category: 'Moderasyon', icon: 'fa-gavel', action: function () { window.location.hash = '#punishment-settings'; } },
      { name: 'Yasaklı Kullanıcılar (Banned)', category: 'Moderasyon', icon: 'fa-ban', action: function () { window.location.hash = '#banned-users'; } },
      { name: 'Kara Liste (Blacklist)', category: 'Moderasyon', icon: 'fa-user-slash', action: function () { window.location.hash = '#blacklist-users'; } },
      { name: 'Discord Bot Kontrol Merkezi', category: 'Sistem', icon: 'fa-robot', action: function () { window.location.hash = '#bots-settings'; } },
      { name: 'Sunucu Ayarları (Başlat, Kapat, Restart)', category: 'Sistem', icon: 'fa-server', action: function () { window.location.hash = '#server-settings'; } },
      { name: 'Yetki & İzin Matrisi (Ranks)', category: 'Güvenlik', icon: 'fa-shield-halved', action: function () { window.location.hash = '#ranks-settings'; } }
    ];

    window.openCommandPalette = function () {
      const modal = document.getElementById('command-palette-modal');
      const input = document.getElementById('cmd-palette-search');
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        input.value = '';
        input.focus();
        filterCommandPalette();
      }
    };

    window.closeCommandPalette = function () {
      const modal = document.getElementById('command-palette-modal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    };

    window.filterCommandPalette = function () {
      const query = (document.getElementById('cmd-palette-search').value || '').toLowerCase().trim();
      const listEl = document.getElementById('cmd-palette-results');
      if (!listEl) return;

      const filtered = cmdPaletteItems.filter(item => item.name.toLowerCase().includes(query) || item.category.toLowerCase().includes(query));

      if (filtered.length === 0) {
        listEl.innerHTML = '<div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px;">Sonuç bulunamadı.</div>';
        return;
      }

      listEl.innerHTML = filtered.map((item, idx) => `
        <div onclick="execCmdPaletteItem(${idx})" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-radius: 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); cursor: pointer; transition: all 0.2s ease; color: var(--text-main);"
          onmouseover="this.style.background='var(--primary-glow)'; this.style.borderColor='var(--primary)'; this.style.transform='translateX(4px)';"
          onmouseout="this.style.background='rgba(255, 255, 255, 0.02)'; this.style.borderColor='var(--border-color)'; this.style.transform='translateX(0)';">
          <span style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0, 113, 227, 0.12); border: 1px solid rgba(0, 113, 227, 0.25); display: flex; align-items: center; justify-content: center;">
              <i class="fa-solid ${item.icon}" style="color: var(--primary); font-size: 14px;"></i>
            </div>
            <span style="font-weight: 600; font-size: 13.5px;">${item.name}</span>
          </span>
          <span style="font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 20px; background: rgba(255, 255, 255, 0.05); color: var(--text-muted); border: 1px solid var(--border-color); font-family: var(--font-display);">
            ${item.category}
          </span>
        </div>
      `).join('');

      window._currentFilteredCmds = filtered;
    };

    window.execCmdPaletteItem = function (idx) {
      if (window._currentFilteredCmds && window._currentFilteredCmds[idx]) {
        window._currentFilteredCmds[idx].action();
        closeCommandPalette();
      }
    };

    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openCommandPalette();
      } else if (e.key === 'Escape') {
        closeCommandPalette();
      }
    });
  </script>

  <%- include('partials/admin/chat') %>
</body>

</html>
