  <!-- Submission Review Modal -->
  <div id="review-modal" class="modal-overlay"
    style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; align-items: center; justify-content: center; padding: 20px;">
    <div class="content-panel"
      style="width: 100%; max-width: 700px; max-height: 90vh; overflow-y: auto; padding: 32px; display: flex; flex-direction: column; gap: 24px; position: relative;">
      <button type="button"
        style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer;"
        onclick="closeReviewModal()"><i class="fa-solid fa-xmark"></i></button>

      <h3
        style="font-family: var(--font-display); font-size: 18px; font-weight: 700; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin: 0; color: var(--text-main);">
        <i class="fa-solid fa-file-invoice-dollar" style="color: var(--primary);"></i> Başvuru İncelemesi
      </h3>

      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; background: rgba(255,255,255,0.01); border: 1px solid var(--border-color); padding: 16px; border-radius: 8px;">
        <div>
          <span style="display: block; font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Başvuran
            Kullanıcı</span>
          <span id="review-username" style="font-weight: 600; color: var(--text-main);">-</span>
        </div>
        <div>
          <span style="display: block; font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Başvuru
            Tipi</span>
          <span id="review-app-title" style="font-weight: 600; color: var(--text-main);">-</span>
        </div>
        <div>
          <span style="display: block; font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Hızlı
            İşlemler</span>
          <button type="button" id="review-voice-btn" class="btn"
            style="background: rgba(0, 191, 255, 0.1); color: #00bfff; border: 1px solid rgba(0, 191, 255, 0.2); font-size: 10px; padding: 6px 12px; border-radius: 6px; margin-top: 4px; display: inline-flex; align-items: center; gap: 4px;"
            onclick="toggleReviewVoiceSupport()"><i class="fa-solid fa-microphone"></i> Sesli Destek</button>
        </div>
      </div>

      <!-- Answers Container -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <h4
          style="font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--text-main); margin: 0;">
          Soru ve Cevaplar</h4>
        <div id="review-answers-container"
          style="display: flex; flex-direction: column; gap: 16px; max-height: 300px; overflow-y: auto; padding-right: 8px;">
          <!-- Answers will be dynamically listed here -->
        </div>
      </div>

      <!-- Review Actions Form -->
      <form id="review-form" action="" method="POST"
        style="border-top: 1px solid var(--border-color); padding-top: 20px; display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" name="status" id="review-status-input">
        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <label class="form-label" style="margin-bottom: 0;">Değerlendirme Notu (Başvuru sahibine görünecek)</label>
            <div style="display: flex; gap: 8px;">
              <button type="button" style="padding: 3px 8px; font-size: 10px; font-weight: 600; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 4px; cursor: pointer;" onclick="document.getElementById('review-notes').value = '<@' + activeReviewDiscordId + '> Tebrikler, başvurunuz başarıyla onaylandı!'">Oto Onay Mesajı</button>
              <button type="button" style="padding: 3px 8px; font-size: 10px; font-weight: 600; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 4px; cursor: pointer;" onclick="document.getElementById('review-notes').value = '<@' + activeReviewDiscordId + '> Başvurunuz yetersiz görüldüğü için maalesef reddedilmiştir.'">Oto Ret Mesajı</button>
            </div>
          </div>
          <textarea name="reviewerNotes" id="review-notes"
            placeholder="Tebrikler, whitelist başvurunuz onaylandı! / Başvurunuz yetersiz görüldüğü için reddedilmiştir."
            class="form-input" style="min-height: 80px; resize: vertical;"></textarea>
        </div>

        <div
          style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; flex-wrap: wrap; gap: 12px;">
          <button type="button" class="btn btn-secondary"
            style="background: rgba(239, 68, 68, 0.15); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.3);"
            onclick="deleteCurrentSubmission()"><i class="fa-solid fa-trash-can"></i> Başvuruyu Sil</button>
          <div style="display: flex; gap: 12px;" id="review-action-buttons">
            <button type="button" class="btn btn-secondary"
              style="background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2);"
              onclick="submitReview('rejected')"><i class="fa-solid fa-xmark"></i> Başvuruyu Reddet</button>
            <button type="button" class="btn btn-primary"
              style="background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.2);"
              onclick="submitReview('approved')"><i class="fa-solid fa-check"></i> Başvuruyu Onayla</button>
          </div>
        </div>
        <div id="review-status-display" style="display: none; text-align: right; font-weight: 700; font-size: 14px;">
          <!-- Displays already reviewed status -->
        </div>
      </form>
    </div>
  </div>

  <!-- Create/Edit Application Modal -->
  <div id="create-app-modal" class="modal-overlay"
    style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; align-items: center; justify-content: center; padding: 20px;">
    <div class="content-panel"
      style="width: 100%; max-width: 800px; max-height: 90vh; overflow-y: auto; padding: 32px; display: flex; flex-direction: column; gap: 24px; position: relative;">
      <button type="button"
        style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer;"
        onclick="closeCreateAppModal()"><i class="fa-solid fa-xmark"></i></button>

      <h3
        style="font-family: var(--font-display); font-size: 18px; font-weight: 700; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin: 0; color: var(--text-main);">
        <i class="fa-solid fa-folder-plus" style="color: var(--primary);"></i> <span id="form-action-text">Yeni Başvuru
          Şablonu Oluştur</span>
      </h3>

      <form id="form-builder" action="/admin/applications/add" method="POST" onsubmit="return prepareQuestionsJSON()"
        style="display: flex; flex-direction: column; gap: 20px;">
        <input type="hidden" name="questionsJson" id="questionsJson">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Başvuru Başlığı</label>
            <input type="text" name="title" id="app-title" placeholder="Örn: Whitelist Başvurusu" class="form-input"
              required>
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Kısa Açıklama (Kartta görünecek)</label>
            <input type="text" name="shortDescription" id="app-shortDesc" placeholder="Örn: Whitelist başvurusu yapın."
              class="form-input" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span><i class="fa-solid fa-paragraph" style="color: var(--primary); margin-right: 4px;"></i> Detaylı
