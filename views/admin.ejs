    let currentReviewSubmissionId = null;

    function openReviewModal(sub) {
      activeReviewDiscordId = sub.discordId;
      currentReviewSubmissionId = sub._id;
      document.getElementById("review-form").action = "/admin/submissions/review/" + sub._id;
      document.getElementById("review-username").innerText = sub.username + " (" + sub.discordId + ")";
      document.getElementById("review-app-title").innerText = sub.applicationId ? sub.applicationId.title : "Silinmiş Başvuru";
      document.getElementById("review-notes").value = sub.reviewerNotes || "";

      const answersContainer = document.getElementById("review-answers-container");
      if (answersContainer) {
        answersContainer.innerHTML = "";
        if (sub.answers && sub.answers.length > 0) {
          sub.answers.forEach((ans, index) => {
            const ansDiv = document.createElement("div");
            ansDiv.style = "border-bottom: 1px solid var(--border-color); padding-bottom: 12px; margin-bottom: 12px;";

            let valText = "";
            if (Array.isArray(ans.value)) {
              valText = ans.value.map(v => `<span style="background: rgba(255,255,255,0.05); color: var(--text-main); margin-right: 6px; padding: 4px 8px; border-radius: 4px; font-size: 12.5px; border: 1px solid rgba(255,255,255,0.08);">${v}</span>`).join("");
            } else {
              valText = `<span style="color: var(--text-main); white-space: pre-wrap; font-size: 13.5px; line-height: 1.6;">${ans.value}</span>`;
            }

            ansDiv.innerHTML = `
              <span style="display: block; font-weight: 700; color: var(--text-main); font-size: 13px; margin-bottom: 6px;">${index + 1}. ${ans.label}</span>
              <div style="margin-top: 4px;">${valText}</div>
            `;
            answersContainer.appendChild(ansDiv);
          });
        } else {
          answersContainer.innerHTML = `<p style="color: var(--text-muted); font-size: 12px;">Cevap bulunmuyor.</p>`;
        }
      }

      const actionBtns = document.getElementById("review-action-buttons");
      const statusDisplay = document.getElementById("review-status-display");
      const notesInput = document.getElementById("review-notes");

      if (sub.status === "pending") {
        if (actionBtns) actionBtns.style.display = "flex";
        if (statusDisplay) statusDisplay.style.display = "none";
        if (notesInput) notesInput.readOnly = false;
      } else {
        if (actionBtns) actionBtns.style.display = "none";
        if (statusDisplay) {
          statusDisplay.style.display = "block";
          if (sub.status === "approved") {
            statusDisplay.innerHTML = `<span class="status-badge online" style="padding: 6px 12px; border-radius: 6px; font-size: 12px; display: inline-block;">✔ ONAYLANDI (Bu başvuru daha önce sonuçlandırılmıştır)</span>`;
          } else {
            statusDisplay.innerHTML = `<span class="status-badge error" style="padding: 6px 12px; border-radius: 6px; font-size: 12px; display: inline-block;">✖ REDDEDİLDİ (Bu başvuru daha önce sonuçlandırılmıştır)</span>`;
          }
        }
        if (notesInput) notesInput.readOnly = true;
      }

      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      document.body.style.paddingRight = scrollbarWidth + "px";

      document.getElementById("review-modal").style.display = "flex";
    }

    async function toggleReviewVoiceSupport() {
      if (!activeReviewDiscordId) return;
      const btn = document.getElementById("review-voice-btn");
      btn.disabled = true;
      const originalText = btn.innerHTML;
      btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i>`;
      try {
        const response = await fetch("/admin/users/voice-support/toggle/" + activeReviewDiscordId, { method: "POST" });
        const data = await response.json();
        if (data.success) {
          showAdminToast(data.message, "success");
        } else {
          showAdminToast(data.message || "Bir hata oluştu.", "error");
        }
      } catch (err) {
        showAdminToast("Bağlantı hatası oluştu.", "error");
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

