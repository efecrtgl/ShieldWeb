  <script>
    window.toggleMobileSidebar = function () {
      const sidebar = document.querySelector('.sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (sidebar) {
        const isOpen = sidebar.classList.toggle('mobile-open');
        if (backdrop) {
          if (isOpen) backdrop.classList.add('active');
          else backdrop.classList.remove('active');
        }
      }
    };

    window.closeMobileSidebar = function () {
      const sidebar = document.querySelector('.sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (sidebar) sidebar.classList.remove('mobile-open');
      if (backdrop) backdrop.classList.remove('active');
    };

    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.sidebar-link').forEach(function (link) {
        link.addEventListener('click', function () {
          if (window.innerWidth <= 1024) {
            window.closeMobileSidebar();
          }
        });
      });
    });
    function toggleSensitiveBlur(enabled) {
      const badge = document.getElementById("sensitive-badge");
      const icon = document.getElementById("sensitive-icon");
      if (enabled) {
        document.body.classList.add("blur-sensitive-data");
        localStorage.setItem("sensitiveBlur", "true");
        if (badge) {
          badge.textContent = "GİZLİ";
          badge.className = "badge-sensitive active";
        }
        if (icon) {
          icon.className = "fa-solid fa-eye-slash";
          icon.style.color = "var(--warning)";
        }
      } else {
        document.body.classList.remove("blur-sensitive-data");
        localStorage.setItem("sensitiveBlur", "false");
        if (badge) {
          badge.textContent = "AÇIK";
          badge.className = "badge-sensitive inactive";
        }
        if (icon) {
          icon.className = "fa-solid fa-eye";
          icon.style.color = "var(--text-muted)";
        }
      }
      fetch("/admin/users/sensitive-toggle", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ enabled })
      }).catch(err => console.error("Sensitive toggle log failed:", err));
    }

    document.addEventListener("DOMContentLoaded", () => {
      const isBlurred = localStorage.getItem("sensitiveBlur") === "true";
      const toggle = document.getElementById("toggle-sensitive-blur");
      if (toggle) {
        toggle.checked = isBlurred;
        toggleSensitiveBlur(isBlurred);
      }
    });
  </script>

