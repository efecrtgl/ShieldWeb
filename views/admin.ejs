    // Drag and Drop & Image Preview Setup
    window.addEventListener("DOMContentLoaded", () => {
      const dropZone = document.getElementById("drop-zone");
      const fileUpload = document.getElementById("file-upload");

      if (dropZone && fileUpload) {
        dropZone.addEventListener("click", () => fileUpload.click());

        dropZone.addEventListener("dragover", (e) => {
          e.preventDefault();
          dropZone.style.borderColor = "var(--primary)";
          dropZone.style.background = "rgba(0, 113, 227, 0.05)";
        });

        dropZone.addEventListener("dragleave", () => {
          dropZone.style.borderColor = "var(--border-color)";
          dropZone.style.background = "rgba(0,0,0,0.1)";
        });

        dropZone.addEventListener("drop", (e) => {
          e.preventDefault();
          dropZone.style.borderColor = "var(--border-color)";
          dropZone.style.background = "rgba(0,0,0,0.1)";

          if (e.dataTransfer.files.length > 0) {
            handleImageFile(e.dataTransfer.files[0]);
          }
        });

        fileUpload.addEventListener("change", (e) => {
          if (e.target.files.length > 0) {
            handleImageFile(e.target.files[0]);
          }
        });
      }
    });

    function handleImageFile(file) {
      if (!file.type.startsWith("image/")) {
        alert("Lütfen sadece bir resim dosyası seçin.");
        return;
      }

      const reader = new FileReader();
      reader.onload = function (e) {
        const base64Data = e.target.result;
        updateImageSource(base64Data, 'file', file.name);
      };
      reader.readAsDataURL(file);
    }

    function updateImageSource(value, source, fileName = '') {
      const imageUrlHidden = document.getElementById("app-imageUrl");
      const imageUrlInput = document.getElementById("app-imageUrl-input");
      const imagePreviewContainer = document.getElementById("image-preview-container");
      const imagePreview = document.getElementById("image-preview");
      const dropZoneText = document.getElementById("drop-zone-text");

      if (imageUrlHidden) imageUrlHidden.value = value;

      if (source === 'url') {
        if (value.trim()) {
          if (imagePreview) imagePreview.src = value;
          if (imagePreviewContainer) imagePreviewContainer.style.display = "block";
        } else {
          if (imagePreviewContainer) imagePreviewContainer.style.display = "none";
        }
      } else if (source === 'file') {
        if (imagePreview) imagePreview.src = value;
        if (imagePreviewContainer) imagePreviewContainer.style.display = "block";
        if (imageUrlInput) imageUrlInput.value = "";
        if (dropZoneText) dropZoneText.innerText = fileName || "Resim Yüklendi";
      }
    }

    function clearSelectedImage() {
      const imageUrlHidden = document.getElementById("app-imageUrl");
      const imageUrlInput = document.getElementById("app-imageUrl-input");
      const fileUpload = document.getElementById("file-upload");
      const imagePreviewContainer = document.getElementById("image-preview-container");
      const imagePreview = document.getElementById("image-preview");
      const dropZoneText = document.getElementById("drop-zone-text");

      if (imageUrlHidden) imageUrlHidden.value = "";
      if (imageUrlInput) imageUrlInput.value = "";
      if (fileUpload) fileUpload.value = "";
      if (imagePreviewContainer) imagePreviewContainer.style.display = "none";
      if (imagePreview) imagePreview.src = "";
      if (dropZoneText) dropZoneText.innerText = "Dosya seç veya sürükle";
    }

    document.querySelectorAll(".sidebar-link").forEach(link => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          e.preventDefault();
          try {
            document.querySelectorAll(".sidebar-link").forEach(l => l.classList.remove("active"));
            document.querySelectorAll(".admin-section").forEach(s => s.classList.remove("active"));

            link.classList.add("active");
            const targetId = href.substring(1);
            const targetSection = document.getElementById(targetId);
            if (targetSection) {
              targetSection.classList.add("active");
            }
          } catch (err) {
            console.error("Navigation error:", err);
          }
        }
      });
    });

    const activeHash = window.location.hash;
    if (activeHash) {
      const activeLink = document.querySelector(`.sidebar-link[href="${activeHash}"]`);
      if (activeLink) {
        activeLink.click();
        if (activeHash === "#faq-settings" || activeHash === "#gallery-settings") {
          if (webMenu) webMenu.classList.add("active");
        }
        if (activeHash === "#users-mgmt" || activeHash === "#punishment-mgmt" || activeHash === "#banned-users" || activeHash === "#blacklist-users" || activeHash === "#character-management") {
          if (usersMenu) usersMenu.classList.add("active");
          if (usersTrigger) usersTrigger.classList.add("active");
        }

        if (activeHash === "#team-list" || activeHash === "#business-list") {
          if (teamsMenu) teamsMenu.classList.add("active");
          if (teamsTrigger) teamsTrigger.classList.add("active");
        }

        if (activeHash === "#fivem-items" || activeHash === "#fivem-jobs" || activeHash === "#fivem-gangs" || activeHash === "#fivem-vehicles") {
          if (fivemMenu) fivemMenu.classList.add("active");
