    // Dynamic Form Builder
    let questionCount = 0;

    function addQuestion(qData = null) {
      questionCount++;
      const container = document.getElementById("questions-builder-container");
      if (!container) return;

      const qId = qData ? qData.id : "q_" + Date.now() + "_" + Math.floor(Math.random() * 1000);

      const qDiv = document.createElement("div");
      qDiv.className = "question-card";
      qDiv.id = "q-card-" + qId;
      qDiv.style = "background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 20px; border-radius: 8px; display: flex; flex-direction: column; gap: 12px; position: relative; margin-bottom: 12px;";

      qDiv.innerHTML = `
        <div style="position: absolute; top: 12px; right: 12px; display: flex; gap: 6px; align-items: center;">
          <button type="button" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 12px; padding: 4px; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--text-muted)'" onclick="moveQuestionUp('${qId}')" title="Yukarı Taşı"><i class="fa-solid fa-arrow-up"></i></button>
          <button type="button" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 12px; padding: 4px; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--text-muted)'" onclick="moveQuestionDown('${qId}')" title="Aşağı Taşı"><i class="fa-solid fa-arrow-down"></i></button>
          <button type="button" style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 12px; padding: 4px; transition: opacity 0.2s; opacity: 0.85;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'" onclick="removeQuestion('${qId}')" title="Sil"><i class="fa-solid fa-trash-can"></i></button>
        </div>
        <input type="hidden" class="q-id" value="${qId}">
        
        <div style="display: grid; grid-template-columns: 1fr 180px; gap: 16px;">
          <div class="form-group">
            <label class="form-label" style="font-size: 11px;">Soru Başlığı (Soru Metni)</label>
            <input type="text" class="form-input q-label" placeholder="Soru yazınız..." value="${qData ? qData.label : ''}" required style="padding: 8px 12px; font-size: 13px;">
          </div>
          <div class="form-group">
            <label class="form-label" style="font-size: 11px;">Soru Tipi</label>
            <select class="form-input q-type" onchange="toggleOptions(this)" style="padding: 8px 12px; font-size: 13px;">
              <option value="short" ${qData && qData.type === 'short' ? 'selected' : ''}>Kısa Metin</option>
              <option value="long" ${qData && qData.type === 'long' ? 'selected' : ''}>Paragraf (Uzun Metin)</option>
              <option value="select" ${qData && qData.type === 'select' ? 'selected' : ''}>Açılır Liste (Select)</option>
              <option value="radio" ${qData && qData.type === 'radio' ? 'selected' : ''}>Tekli Seçim (Radio)</option>
              <option value="checkbox" ${qData && qData.type === 'checkbox' ? 'selected' : ''}>Çoklu Seçim (Checkbox)</option>
            </select>
          </div>
        </div>

        <div class="options-builder-wrapper" style="display: ${qData && ['select', 'radio', 'checkbox'].includes(qData.type) ? 'block' : 'none'}; border-top: 1px dashed rgba(255,255,255,0.05); padding-top: 12px;">
          <label class="form-label" style="font-size: 11px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span>Seçenekler</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="addOptionToQuestion('${qId}')" style="padding: 2px 8px; font-size: 10px;"><i class="fa-solid fa-plus"></i> Seçenek Ekle</button>
          </label>
          <div class="options-container" id="options-container-${qId}" style="display: flex; flex-direction: column; gap: 8px;">
            <!-- Dynamic options will be added here -->
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
          <input type="checkbox" class="q-required" id="req-${qId}" ${qData && qData.required ? 'checked' : ''} style="width: 14px; height: 14px; accent-color: var(--primary);">
          <label for="req-${qId}" style="font-size: 12px; color: var(--text-muted); cursor: pointer; user-select: none;">Bu soruyu cevaplamak zorunludur</label>
        </div>
      `;

      container.appendChild(qDiv);

      if (qData && qData.options && qData.options.length > 0) {
        qData.options.forEach(opt => {
          addOptionToQuestion(qId, opt);
        });
      }
    }

    function removeQuestion(qId) {
      const qCard = document.getElementById("q-card-" + qId);
      if (qCard) qCard.remove();
    }

    function moveQuestionUp(qId) {
      const card = document.getElementById("q-card-" + qId);
      if (!card) return;
      const previous = card.previousElementSibling;
      if (previous && previous.classList.contains("question-card")) {
        card.parentNode.insertBefore(card, previous);
      }
    }

    function moveQuestionDown(qId) {
      const card = document.getElementById("q-card-" + qId);
      if (!card) return;
      const next = card.nextElementSibling;
      if (next && next.classList.contains("question-card")) {
        card.parentNode.insertBefore(next, card);
      }
    }

    function toggleOptions(select) {
      const qCard = select.closest(".question-card");
      const wrapper = qCard.querySelector(".options-builder-wrapper");
      const qId = qCard.querySelector(".q-id").value;
      const optionsContainer = document.getElementById("options-container-" + qId);

      if (["select", "radio", "checkbox"].includes(select.value)) {
        wrapper.style.display = "block";
        if (optionsContainer.children.length === 0) {
          addOptionToQuestion(qId);
        }
      } else {
        wrapper.style.display = "none";
      }
    }

    // Add option to question
    function addOptionToQuestion(qId, val = '') {
      const container = document.getElementById("options-container-" + qId);
      if (!container) return;

      const optDiv = document.createElement("div");
      optDiv.style = "display: flex; gap: 8px; align-items: center;";
      optDiv.className = "option-row";

      optDiv.innerHTML = `
        <input type="text" class="form-input q-option-val" value="${val}" placeholder="Seçenek..." required style="padding: 6px 12px; font-size: 12px; flex: 1;">
        <button type="button" style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 12px;" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>
      `;

      container.appendChild(optDiv);
    }

    function prepareQuestionsJSON() {
      // Sync Google Forms Rich Text Editor
      const descEditor = document.getElementById("gforms-editor-app-desc");
      const descHidden = document.getElementById("app-desc");
      if (descEditor && descHidden) {
        descHidden.value = descEditor.innerHTML.trim();
        if (descHidden.value === '<br>' || descHidden.value === '<div><br></div>' || descHidden.value === '<p><br></p>') {
          descHidden.value = '';
        }
        if (!descHidden.value) {
          alert("Lütfen başvuru şablonu için detaylı bir açıklama yazınız.");
          descEditor.focus();
          return false;
        }
      }

      const questions = [];
      const qCards = document.querySelectorAll("#questions-builder-container .question-card");

      for (let i = 0; i < qCards.length; i++) {
        const card = qCards[i];
        const id = card.querySelector(".q-id").value;
        const label = card.querySelector(".q-label").value.trim();
        const type = card.querySelector(".q-type").value;
        const required = card.querySelector(".q-required").checked;

        if (!label) {
          alert("Lütfen tüm soruların başlıklarını doldurunuz.");
          return false;
        }

        const qObj = { id, type, label, required, options: [] };

        if (["select", "radio", "checkbox"].includes(type)) {
          const optInputs = card.querySelectorAll(".q-option-val");
          optInputs.forEach(input => {
            const val = input.value.trim();
            if (val) qObj.options.push(val);
          });

          if (qObj.options.length === 0) {
            alert(`"${label}" sorusu için en az bir seçenek eklemelisiniz.`);
            return false;
          }
        }

        questions.push(qObj);
      }

      const hiddenInput = document.getElementById("questionsJson");
      if (hiddenInput) {
        hiddenInput.value = JSON.stringify(questions);
      }
      return true;
    }

