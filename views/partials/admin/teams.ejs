                </div>
                <div style="background: rgba(0,0,0,0.25); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                  <span style="color: var(--text-muted); display: block; font-size: 11px; margin-bottom: 2px;">Ekip / Departman</span>
                  <strong style="color: #fff;">${teamName}</strong>
                </div>
                <div style="background: rgba(0,0,0,0.25); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                  <span style="color: var(--text-muted); display: block; font-size: 11px; margin-bottom: 2px;">Whitelist Durumu</span>
                  ${wlStatus}
                </div>
                <div style="background: rgba(0,0,0,0.25); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                  <span style="color: var(--text-muted); display: block; font-size: 11px; margin-bottom: 2px;">Whitelist Tarihi</span>
                  <span style="color: #e2e8f0;">${wlDate}</span>
                </div>
                <div style="background: rgba(0,0,0,0.25); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                  <span style="color: var(--text-muted); display: block; font-size: 11px; margin-bottom: 2px;">Ekibe Katılma</span>
                  <span style="color: #e2e8f0;">${addedDate}</span>
                </div>
                <div style="background: rgba(0,0,0,0.25); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                  <span style="color: var(--text-muted); display: block; font-size: 11px; margin-bottom: 2px;">Uyarı & Ceza</span>
                  <span style="color: #f59e0b; font-weight: 700;">${warningsCount} Uyarı</span> | <span style="color: var(--text-muted);">${wlPenalty}</span>
                </div>
              </div>
            `;
          } else if (accountContainer) {
            accountContainer.innerHTML = '<div style="font-size: 11px; color: var(--text-muted);">DiscordUser hesabı bulunamadı.</div>';
          }

          if (data.characters && data.characters.length > 0) {
            let html = "";
            data.characters.forEach(char => {
              const cashFormatted = (char.money && typeof char.money.cash === "number") ? char.money.cash.toLocaleString("tr-TR") : "—";
              const bankFormatted = (char.money && typeof char.money.bank === "number") ? char.money.bank.toLocaleString("tr-TR") : "—";
              const playHours = (char.playtime && typeof char.playtime === "number") ? (char.playtime / 60).toFixed(1) : "0";
              const jobLabel = char.job && (char.job.label || char.job.name) ? escapeHtml(char.job.label || char.job.name) : "—";
              const jobGrade = char.job && char.job.grade ? escapeHtml(char.job.grade) : "—";
              const birthdate = char.birthdate ? escapeHtml(char.birthdate) : "—";
              const citizenid = escapeHtml(char.citizenid || "");

              html += `
                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px; display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <span style="background: var(--primary); color: #fff; font-weight: 600; font-size: 11px; padding: 2px 8px; border-radius: 4px;">SLOT ${char.cid !== null && char.cid !== undefined ? escapeHtml(char.cid) : "—"}</span>
                      <h5 style="margin: 0; font-size: 14px; font-weight: 700; color: #fff;">${escapeHtml(char.firstname || '')} ${escapeHtml(char.lastname || '')}</h5>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <span style="font-family: var(--font-mono); font-size: 11px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 2px 8px; border-radius: 4px; font-weight: 700;">
                        CID: ${citizenid}
                      </span>
                      <button type="button" class="btn" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); font-size: 11px; padding: 3px 8px; border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;" onclick="deleteSingleCharacter(${jsArg(char._id)}, ${jsArg(char.citizenid || "")}, ${jsArg(encodeURIComponent((char.firstname || '') + ' ' + (char.lastname || '')))}, ${jsArg(discordId)})">
                        <i class="fa-solid fa-trash"></i> Karakteri Sil
                      </button>
                    </div>
                  </div>

                  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; font-size: 11px;">
                    <div style="background: rgba(0,0,0,0.2); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                      <span style="color: var(--text-muted); font-size: 11px; display: block; margin-bottom: 2px;"><i class="fa-solid fa-briefcase"></i> Meslek & Derece</span>
                      <strong style="color: var(--text-main);">${jobLabel}</strong> <span style="color: var(--primary); font-size: 11px;">(${jobGrade})</span>
                    </div>

                    <div style="background: rgba(0,0,0,0.2); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                      <span style="color: var(--text-muted); font-size: 11px; display: block; margin-bottom: 2px;"><i class="fa-solid fa-clock"></i> Oynama Süresi</span>
                      <strong style="color: #34d399;">${playHours} Saat</strong> <span style="color: var(--text-muted); font-size: 11px;">(${char.playtime || 0} Dk)</span>
                    </div>

                    <div style="background: rgba(0,0,0,0.2); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                      <span style="color: var(--text-muted); font-size: 11px; display: block; margin-bottom: 2px;"><i class="fa-solid fa-money-bill-wave"></i> Cüzdan (Nakit)</span>
                      <strong style="color: #4ade80;">$${cashFormatted}</strong>
                    </div>

                    <div style="background: rgba(0,0,0,0.2); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                      <span style="color: var(--text-muted); font-size: 11px; display: block; margin-bottom: 2px;"><i class="fa-solid fa-building-columns"></i> Banka Hesabı</span>
                      <strong style="color: #60a5fa;">$${bankFormatted}</strong>
                    </div>

                    <div style="background: rgba(0,0,0,0.2); padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color); grid-column: span 2;">
                      <span style="color: var(--text-muted); font-size: 11px; display: block; margin-bottom: 2px;"><i class="fa-solid fa-cake-candles"></i> Doğum Tarihi</span>
                      <strong style="color: var(--text-main);">${birthdate}</strong>
                    </div>
                  </div>
                </div>
              `;
            });
            charContainer.innerHTML = html;
          } else {
            charContainer.innerHTML = '<div style="text-align: center; padding: 20px; background: rgba(255,255,255,0.02); border: 1px dashed var(--border-color); border-radius: 10px; color: var(--text-muted); font-size: 12px;"><i class="fa-solid fa-user-slash" style="font-size: 24px; margin-bottom: 8px; color: var(--warning); display: block;"></i> Bu kullanıcıya ait veritabanında henüz oluşturulmuş bir FiveM karakter kaydı bulunmuyor.</div>';
          }
        } else {
          charContainer.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--danger); font-size: 12px;">Detay verileri çekilemedi.</div>';
        }
      } catch (err) {
        console.error("Fetch character details error:", err);
        charContainer.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--danger); font-size: 12px;">Karakter verileri yüklenirken hata oluştu.</div>';
      }
    }

    function closeMemberDetailsModal() {
      const modal = document.getElementById("member-details-modal");
      if (modal) modal.style.display = "none";
      if (currentActiveTeamId) {
        openTeamMembersModal(currentActiveTeamId, typeof isCurrentModalBusiness !== 'undefined' ? isCurrentModalBusiness : false);
      }
    }

    async function deleteSingleCharacter(characterId, citizenid, charNameEncoded, discordId) {
      const charName = decodeURIComponent(charNameEncoded || "Karakter");
      if (!confirm(`DİKKAT: "${charName}" (CID: ${citizenid}) isimli karakteri veritabanından kalıcı olarak silmek istediğinize emin misiniz?\n\nBu işlem GERİ ALINAMAZ!`)) return;

      try {
        const response = await fetch("/api/fivem/character/delete", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ characterId, citizenid, discordId })
        });

        const data = await response.json().catch(() => null);
        if (data && data.success) {
          showAdminToast(data.message, "success");
          await openMemberDetailsModal(discordId, "");
        } else {
          showAdminToast((data && data.message) ? data.message : "Karakter silinemedi.", "error");
        }
      } catch (err) {
        console.error("Delete character fetch error:", err);
        showAdminToast("Bağlantı hatası oluştu.", "error");
      }
    }
  </script>
  <% } %>