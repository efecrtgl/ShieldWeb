<script>
  let pendingServerAction = null;
  let serverUptimeSeconds = 0;
  let lastConsoleLogCount = 0;
  let allRawLogs = [];
  let currentLogFilter = '';
  let cmdCommandHistory = [];
  let cmdHistoryIndex = -1;

  function formatUptime(seconds) {
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    const secs = Math.floor(seconds % 60);
    const pad = n => n < 10 ? '0' + n : n;
    return `${pad(hrs)}:${pad(mins)}:${pad(secs)}`;
  }

  function ansi256ToRgb(n) {
    if (n < 0 || n > 255) return 'rgb(226, 232, 240)';
    if (n < 8) {
      const std = ['rgb(0,0,0)', 'rgb(239,68,68)', 'rgb(16,185,129)', 'rgb(245,158,11)', 'rgb(59,130,246)', 'rgb(236,72,153)', 'rgb(6,182,212)', 'rgb(226,232,240)'];
      return std[n];
    }
    if (n < 16) {
      const bright = ['rgb(100,116,139)', 'rgb(248,113,113)', 'rgb(52,211,153)', 'rgb(251,191,36)', 'rgb(96,165,250)', 'rgb(244,114,182)', 'rgb(56,189,248)', 'rgb(255,255,255)'];
      return bright[n - 8];
    }
    if (n >= 16 && n <= 231) {
      const idx = n - 16;
      const r = Math.floor(idx / 36);
      const g = Math.floor((idx % 36) / 6);
      const b = idx % 6;
      return `rgb(${r ? r * 40 + 55 : 0}, ${g ? g * 40 + 55 : 0}, ${b ? b * 40 + 55 : 0})`;
    }
    const val = (n - 232) * 10 + 8;
    return `rgb(${val}, ${val}, ${val})`;
  }

  function parseAnsiToHtml(str) {
    if (!str) return '';
    let text = String(str);

    text = text.replace(/\x1b\]0;[^\x07\x1b]*(?:\x07|\x1b\\)/g, '');
    text = text.replace(/\^\[\]0;[^\^G\x07]*(?:\^G|\x07)/g, '');

    text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    text = text.replace(/\^([0-9])/g, (m, c) => {
      const colors = {
        '1': '#ef4444',
        '2': '#10b981',
        '3': '#f59e0b',
        '4': '#3b82f6',
        '5': '#06b6d4',
        '6': '#ec4899',
        '7': '#f8fafc',
        '8': '#991b1b',
        '9': '#d946ef',
        '0': '#cbd5e1'
      };
      return `<span style="color: ${colors[c] || '#cbd5e1'}">`;
    });

    const ansiPattern = /(?:\x1b|\^\[)\[([0-9;]*)m/g;
    text = text.replace(ansiPattern, (match, p1) => {
      if (!p1 || p1 === '0' || p1 === '00') {
        return '</span>';
      }
      const parts = p1.split(';').map(x => parseInt(x, 10));
      if (parts.length >= 3 && parts[0] === 38 && parts[1] === 5) {
        return `<span style="color: ${ansi256ToRgb(parts[2])};">`;
      }
      if (parts.length >= 3 && parts[0] === 48 && parts[1] === 5) {
        return `<span style="background-color: ${ansi256ToRgb(parts[2])};">`;
      }
      if (parts[0] >= 30 && parts[0] <= 37) {
        const std = ['#0f172a', '#ef4444', '#10b981', '#f59e0b', '#3b82f6', '#ec4899', '#06b6d4', '#f1f5f9'];
        return `<span style="color: ${std[parts[0] - 30]};">`;
      }
      if (parts[0] >= 90 && parts[0] <= 97) {
        const bright = ['#64748b', '#f87171', '#34d399', '#fbbf24', '#60a5fa', '#f472b6', '#38bdf8', '#ffffff'];
        return `<span style="color: ${bright[parts[0] - 90]};">`;
      }
      if (parts[0] === 1) {
        return '<span style="font-weight: 700;">';
      }
      return '';
    });

    text = text.replace(/(?:\x1b|\^\[)\[[0-9;]*[a-zA-Z]/g, '');

    return formatFiveMEntities(text);
  }

  function formatFiveMEntities(html) {
    let out = html;

    out = out.replace(/\[\s*(resources:[a-zA-Z0-9_\-]+)\s*\]/g, '<span class="fx-tag-badge fx-tag-resources"><i class="fa-solid fa-cube"></i> $1</span>');
    out = out.replace(/\[\s*resources\s*\]/g, '<span class="fx-tag-badge fx-tag-resources"><i class="fa-solid fa-cubes"></i> resources</span>');
    out = out.replace(/\[\s*c-scripting-core\s*\]/g, '<span class="fx-tag-badge fx-tag-scripting"><i class="fa-solid fa-code"></i> c-scripting-core</span>');
    out = out.replace(/\[\s*citizen-server-impl\s*\]/g, '<span class="fx-tag-badge fx-tag-citizen"><i class="fa-solid fa-network-wired"></i> citizen-server</span>');
    out = out.replace(/\[\s*shield-software\s*\]/g, '<span class="fx-tag-badge fx-tag-shield"><i class="fa-solid fa-shield-halved"></i> shield-software</span>');

    out = out.replace(/Started resource ([a-zA-Z0-9_\-]+)(?:\s*\(([0-9]+)\s*warnings\))?/g, (m, resName, warns) => {
      let badge = `<span class="fx-highlight-started"><i class="fa-solid fa-circle-check"></i> Started resource <b style="color:#fff;">${resName}</b></span>`;
      if (warns) {
        badge += ` <span class="fx-highlight-warning">(${warns} uyarı)</span>`;
      }
      return badge;
    });

    out = out.replace(/Creating script environments for ([a-zA-Z0-9_\-]+)/g, '<span class="fx-highlight-env"><i class="fa-solid fa-gear fa-spin"></i> Script env: <b>$1</b></span>');
    out = out.replace(/(uses\s+[0-9.]+\s+MiB\s+of\s+physical\s+memory)/g, '<span class="fx-highlight-memory">$1</span>');

    return out;
  }

  function renderTerminalLogs() {
    const terminal = document.getElementById('cmd-terminal-window');
    if (!terminal) return;

    let filtered = allRawLogs;
    if (currentLogFilter) {
      const q = currentLogFilter.toLowerCase();
      filtered = allRawLogs.filter(l => (l.text && l.text.toLowerCase().includes(q)) || (l.time && l.time.toLowerCase().includes(q)));
    }

    const counter = document.getElementById('cmd-log-counter');
    if (counter) {
      counter.textContent = `${filtered.length} Satır`;
    }

    if (filtered.length === 0) {
      terminal.innerHTML = '<div style="color: #64748b; font-family: monospace; padding: 10px;">[Eşleşen log bulunamadı.]</div>';
      return;
    }

    terminal.innerHTML = filtered.map((l, index) => {
      const parsedText = parseAnsiToHtml(l.text || '');
      let rowColorStyle = '';
      if (l.type === 'danger' || l.type === 'error') {
        rowColorStyle = 'border-left: 2px solid #ef4444; background: rgba(239, 68, 68, 0.05);';
      } else if (l.type === 'warning') {
        rowColorStyle = 'border-left: 2px solid #f59e0b; background: rgba(245, 158, 11, 0.05);';
      } else if (l.type === 'cmd') {
        rowColorStyle = 'border-left: 2px solid var(--primary); background: rgba(224, 169, 139, 0.08);';
      }

      return `<div class="terminal-stream-row" style="${rowColorStyle}">
        <span class="terminal-time-col">[${l.time || ''}]</span>
        <span class="terminal-content-col">${parsedText}</span>
      </div>`;
    }).join('');

    const autoScroll = document.getElementById('cmd-autoscroll');
    if (autoScroll && autoScroll.checked) {
      terminal.scrollTop = terminal.scrollHeight;
    }
  }

  function applyCmdFilter(val) {
    currentLogFilter = val ? val.trim() : '';
    renderTerminalLogs();
  }

  function toggleTerminalFullscreen() {
    const panel = document.getElementById('cmd-terminal-panel');
    const icon = document.getElementById('cmd-fullscreen-icon');
    const terminalWindow = document.getElementById('cmd-terminal-window');
    if (!panel) return;

    panel.classList.toggle('terminal-fullscreen');
    if (panel.classList.contains('terminal-fullscreen')) {
      if (icon) icon.className = 'fa-solid fa-compress';
      if (terminalWindow) terminalWindow.style.height = 'calc(100vh - 190px)';
    } else {
      if (icon) icon.className = 'fa-solid fa-expand';
      if (terminalWindow) terminalWindow.style.height = '420px';
    }
  }

  function copyTerminalLogs() {
    const text = allRawLogs.map(l => `[${l.time || ''}] ${l.text || ''}`).join('\n');
    navigator.clipboard.writeText(text).then(() => {
      if (typeof showToast === 'function') showToast('Tüm konsol logları panoya kopyalandı.', 'success');
      else alert('Loglar kopyalandı.');
    });
  }

