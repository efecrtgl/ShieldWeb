  async function executePendingServerAction() {
    if (!pendingServerAction) return;
    const action = pendingServerAction;
    closeActionModal();
    executeServerAction(action);
  }

  async function executeServerAction(action) {
    const btnId = action === 'start' ? 'btn-server-start' : action === 'stop' ? 'btn-server-stop' : 'btn-server-restart';
    const btn = document.getElementById(btnId);
    let originalHtml = '';
    if (btn) {
      originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> İşleniyor...';
    }

    try {
      let bodyData = {};
      if (action === 'restart') {
        const modeEl = document.getElementById('server-restart-mode');
        bodyData.countdown = modeEl && modeEl.value === 'countdown' ? 15 : 0;
      }

      const res = await fetch(`/admin/server/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyData)
      });
      const data = await res.json();

      if (data.success) {
        if (typeof showToast === 'function') {
          showToast(data.message || 'İşlem başarıyla tamamlandı.', 'success');
        } else {
          alert(data.message || 'İşlem tamamlandı.');
        }
        setTimeout(refreshServerStatus, 1500);
        setTimeout(fetchConsoleLogs, 500);
      } else {
        if (typeof showToast === 'function') {
          showToast(data.message || 'İşlem başarısız oldu.', 'error');
        } else {
          alert(data.message || 'Hata oluştu.');
        }
      }
    } catch (err) {
      if (typeof showToast === 'function') {
        showToast('Sunucu bağlantı hatası.', 'error');
      } else {
        alert('Sunucu bağlantı hatası.');
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }
  }

