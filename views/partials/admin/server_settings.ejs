  async function loadScriptsTree(subPath = '') {
    currentScriptsPath = subPath || '';
    const listEl = document.getElementById('scripts-tree-list');
    if (listEl) {
      listEl.innerHTML = `<div style="color: #64748b; font-size: 11.5px; padding: 20px; text-align: center;"><i class="fa-solid fa-spinner fa-spin" style="margin-right: 6px;"></i> Dosyalar taranıyor...</div>`;
    }

    try {
      const res = await fetch(`/admin/server/scripts/tree?subPath=${encodeURIComponent(subPath)}`);
      const data = await res.json();
      if (!data.success) {
        if (listEl) {
          listEl.innerHTML = `<div style="color: #f87171; font-size: 11.5px; padding: 18px; text-align: center;"><i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i> ${data.message || 'Dizin listelenemedi.'}</div>`;
        }
        return;
      }

      scriptsRawTreeItems = Array.isArray(data.items) ? data.items : [];
      renderScriptsBreadcrumbs(data.breadcrumbs || []);
      renderScriptsTreeItems();
    } catch (e) {
      if (listEl) {
        listEl.innerHTML = `<div style="color: #f87171; font-size: 11.5px; padding: 18px; text-align: center;"><i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i> Bağlantı hatası: ${e.message}</div>`;
      }
    }
  }

  function renderScriptsBreadcrumbs(crumbs = []) {
    const el = document.getElementById('scripts-breadcrumbs');
    if (!el) return;
    el.innerHTML = '';

    crumbs.forEach((c, idx) => {
      if (idx > 0) {
        const sep = document.createElement('span');
        sep.textContent = '/';
        sep.style.color = '#475569';
        sep.style.margin = '0 2px';
        el.appendChild(sep);
      }
      const chip = document.createElement('span');
      chip.className = idx === crumbs.length - 1 ? 'scripts-breadcrumb-chip scripts-breadcrumb-active' : 'scripts-breadcrumb-chip';
      chip.textContent = c.name;
      chip.onclick = () => loadScriptsTree(c.path);
      el.appendChild(chip);
    });
  }

  function renderScriptsTreeItems() {
    const listEl = document.getElementById('scripts-tree-list');
    if (!listEl) return;

    const query = (document.getElementById('scripts-search-input')?.value || '').trim().toLowerCase();
    const items = query
      ? scriptsRawTreeItems.filter(item => item.name.toLowerCase().includes(query))
      : scriptsRawTreeItems;

    if (items.length === 0) {
      listEl.innerHTML = `<div style="color: #64748b; font-size: 11.5px; padding: 24px; text-align: center;"><i class="fa-regular fa-folder-open" style="font-size: 20px; display: block; margin-bottom: 8px;"></i> ${query ? 'Eşleşen dosya bulunamadı.' : 'Bu klasör boş.'}</div>`;
      return;
    }

    listEl.innerHTML = '';

    items.forEach(item => {
      const row = document.createElement('div');
      row.className = 'scripts-tree-item' + (activeScriptTabPath === item.relPath ? ' active-item' : '');

      const iconHtml = getScriptFileIconHtml(item.name, item.ext, item.isDir, item.isResource, item.isCategory);

      let badgeHtml = '';
      if (item.isResource) {
        badgeHtml = '<span class="fx-res-badge"><i class="fa-solid fa-cube"></i> RESOURCE</span>';
      } else if (item.isCategory) {
        badgeHtml = '<span class="fx-cat-badge">KAT</span>';
      }

      row.innerHTML = `
        <div class="scripts-item-name" title="${item.relPath}">
          ${iconHtml}
          <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.name}</span>
          ${badgeHtml}
        </div>
        <div class="scripts-item-actions">
          ${item.isResource ? `
            <button class="scripts-mini-btn" style="color: #34d399;" title="${item.name} Restart Et" onclick="quickRestartScriptResource('${item.name}', event)">
              <i class="fa-solid fa-bolt"></i>
            </button>
          ` : ''}
          <button class="scripts-mini-btn" title="Yeniden Adlandır" onclick="openRenameScriptModal('${item.relPath}', '${item.name}', event)">
            <i class="fa-solid fa-pen"></i>
          </button>
          <button class="scripts-mini-btn btn-del" title="Sil" onclick="openDeleteScriptModal('${item.relPath}', '${item.name}', ${item.isDir}, event)">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      `;

      row.onclick = (e) => {
        if (e.target.closest('.scripts-item-actions')) return;
        if (item.isDir) {
          loadScriptsTree(item.relPath);
        } else {
          openScriptFile(item.relPath);
        }
      };

      listEl.appendChild(row);
    });
  }

  function getScriptFileIconHtml(fileName, ext, isDir, isResource, isCategory) {
    if (isCategory) return '<i class="fa-solid fa-folder" style="color: #c084fc;"></i>';
    if (isResource) return '<i class="fa-solid fa-folder-closed" style="color: #34d399;"></i>';
    if (isDir) return '<i class="fa-solid fa-folder" style="color: #f59e0b;"></i>';

    const lower = fileName.toLowerCase();
    if (lower === 'fxmanifest.lua' || lower === '__resource.lua') {
      return '<i class="fa-solid fa-shield-halved" style="color: var(--primary);"></i>';
    }

    switch (ext) {
      case '.lua':
        return '<i class="fa-solid fa-moon" style="color: #38bdf8;"></i>';
      case '.js':
      case '.mjs':
      case '.cjs':
        return '<i class="fa-brands fa-js" style="color: #f59e0b;"></i>';
      case '.json':
        return '<i class="fa-solid fa-code" style="color: #34d399;"></i>';
      case '.cfg':
      case '.ini':
      case '.env':
        return '<i class="fa-solid fa-gear" style="color: #c084fc;"></i>';
      case '.html':
      case '.htm':
        return '<i class="fa-brands fa-html5" style="color: #fb923c;"></i>';
      case '.css':
      case '.scss':
        return '<i class="fa-brands fa-css3-alt" style="color: #60a5fa;"></i>';
      case '.sql':
        return '<i class="fa-solid fa-database" style="color: #818cf8;"></i>';
      case '.md':
      case '.txt':
      case '.log':
        return '<i class="fa-solid fa-file-lines" style="color: #94a3b8;"></i>';
      case '.ytd':
      case '.ydr':
      case '.yft':
      case '.rpf':
        return '<i class="fa-solid fa-cube" style="color: #64748b;" title="Binary 3D/Texture Asset"></i>';
      default:
        return '<i class="fa-solid fa-file-code" style="color: #94a3b8;"></i>';
    }
  }

  function handleScriptsSearch(val) {
    renderScriptsTreeItems();
  }

  function refreshCurrentScriptsDir() {
    loadScriptsTree(currentScriptsPath);
  }

  function navigateScriptsHome() {
    loadScriptsTree('');
  }

  function navigateScriptsUp() {
    if (!currentScriptsPath) return;
    const parts = currentScriptsPath.split('/').filter(Boolean);
    parts.pop();
    loadScriptsTree(parts.join('/'));
  }

  async function openScriptFile(filePath) {
    const existing = openScriptTabs.find(t => t.path === filePath);
    if (existing) {
      switchScriptTab(filePath);
      return;
    }

    try {
      const res = await fetch(`/admin/server/scripts/file?filePath=${encodeURIComponent(filePath)}`);
      const data = await res.json();
      if (!data.success) {
        if (typeof showToast === 'function') {
          showToast(data.message || 'Dosya açılamadı.', data.isBinary ? 'warning' : 'error');
        } else {
          alert(data.message || 'Dosya açılamadı.');
        }
        return;
      }

      openScriptTabs.push({
        path: data.filePath,
        name: data.fileName,
        ext: data.ext,
        content: data.content,
        originalContent: data.content,
        isDirty: false,
        resourceName: data.resourceName || null,
        size: data.size
      });

      switchScriptTab(data.filePath);
    } catch (e) {
      if (typeof showToast === 'function') showToast('Dosya açılırken hata: ' + e.message, 'error');
    }
  }

  // =========================================================================
  // ACE CODE EDITOR (SHIELD CODE STUDIO) ENGINE
  // =========================================================================
  let scriptAceEditor = null;
  let isSettingAceValue = false;
  let currentAceWrapMode = false;

  function initScriptAceEditor() {
    if (scriptAceEditor) return scriptAceEditor;

    if (typeof ace === 'undefined') {
      console.warn('[Shield Studio] Ace Editor kütüphanesi yüklenemedi, yedek textarea kullanılıyor.');
      const fb = document.getElementById('scripts-textarea-fallback');
      if (fb) fb.style.display = 'flex';
      const aceEl = document.getElementById('scripts-ace-editor');
      if (aceEl) aceEl.style.display = 'none';
      return null;
    }

    try {
      ace.config.set('basePath', '/js/ace');
      ace.config.set('modePath', '/js/ace');
      ace.config.set('themePath', '/js/ace');

      scriptAceEditor = ace.edit("scripts-ace-editor");

      // Load saved preferences
      const savedTheme = localStorage.getItem('shield_script_theme') || 'one_dark';
      const savedFontSize = localStorage.getItem('shield_script_fontsize') || '13px';

      const themeSel = document.getElementById('scripts-theme-select');
      if (themeSel) themeSel.value = savedTheme;

      const sizeSel = document.getElementById('scripts-fontsize-select');
      if (sizeSel) sizeSel.value = savedFontSize;

      scriptAceEditor.setTheme(`ace/theme/${savedTheme}`);
      scriptAceEditor.session.setMode("ace/mode/lua");
      scriptAceEditor.session.setUseWorker(false);

      scriptAceEditor.setOptions({
        fontSize: savedFontSize,
        fontFamily: "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace",
        enableBasicAutocompletion: true,
        enableLiveAutocompletion: true,
        enableSnippets: true,
        showPrintMargin: false,
        scrollPastEnd: 0.45,
        cursorStyle: "smooth",
        highlightActiveLine: true,
        highlightSelectedWord: true,
        tabSize: 2,
        useSoftTabs: true,
        wrap: false,
        autoScrollEditorIntoView: true
      });

      // Live content modification detector
      scriptAceEditor.session.on('change', function () {
        if (isSettingAceValue) return;
        const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
        if (!tab) return;

        const newContent = scriptAceEditor.getValue();
        tab.content = newContent;
        tab.isDirty = (newContent !== tab.originalContent);

        const pill = document.getElementById('scripts-active-file-dirty-pill');
        if (pill) {
          pill.className = tab.isDirty ? 'cfg-status-pill cfg-status-modified' : 'cfg-status-pill cfg-status-saved';
          pill.textContent = tab.isDirty ? 'DÜZENLENDİ' : 'KAYDEDİLDİ';
        }

        renderScriptTabs();
        updateScriptStats(newContent);
      });

      // Realtime cursor row & column position
      scriptAceEditor.selection.on('changeCursor', function () {
        const cur = scriptAceEditor.getCursorPosition();
        const line = cur.row + 1;
        const col = cur.column + 1;
        const curEl = document.getElementById('scripts-stat-cursor');
        if (curEl) curEl.innerHTML = `<i class="fa-regular fa-i-cursor"></i> Satır: ${line}, Sütun: ${col}`;
      });

      // Keyboard shortcut Ctrl+S
      scriptAceEditor.commands.addCommand({
        name: 'saveFile',
        bindKey: { win: 'Ctrl-S', mac: 'Command-S' },
        exec: function () {
          saveActiveScriptFile();
        }
      });

      // Window resize trigger
      window.addEventListener('resize', () => {
        if (scriptAceEditor) scriptAceEditor.resize();
      });

      return scriptAceEditor;
    } catch (err) {
      console.error('[Shield Studio] Ace init error:', err);
      const fb = document.getElementById('scripts-textarea-fallback');
      if (fb) fb.style.display = 'flex';
      const aceEl = document.getElementById('scripts-ace-editor');
      if (aceEl) aceEl.style.display = 'none';
      return null;
    }
  }

  function getScriptLangInfo(filename) {
    const ext = (filename ? filename.split('.').pop() : '').toLowerCase();
    switch (ext) {
      case 'lua':
        return { mode: 'ace/mode/lua', label: 'Lua (FiveM)', icon: 'fa-solid fa-moon', color: '#38bdf8' };
      case 'js':
      case 'mjs':
      case 'cjs':
        return { mode: 'ace/mode/javascript', label: 'JavaScript', icon: 'fa-brands fa-js', color: '#facc15' };
      case 'ts':
        return { mode: 'ace/mode/javascript', label: 'TypeScript', icon: 'fa-solid fa-code', color: '#60a5fa' };
      case 'json':
        return { mode: 'ace/mode/json', label: 'JSON', icon: 'fa-solid fa-brackets-curly', color: '#fb923c' };
      case 'cfg':
      case 'ini':
      case 'env':
      case 'properties':
        return { mode: 'ace/mode/ini', label: 'Configuration (CFG)', icon: 'fa-solid fa-sliders', color: '#a78bfa' };
      case 'html':
      case 'htm':
        return { mode: 'ace/mode/html', label: 'HTML', icon: 'fa-brands fa-html5', color: '#f87171' };
      case 'css':
      case 'scss':
        return { mode: 'ace/mode/css', label: 'CSS', icon: 'fa-brands fa-css3-alt', color: '#38bdf8' };
      case 'sql':
        return { mode: 'ace/mode/sql', label: 'SQL', icon: 'fa-solid fa-database', color: '#34d399' };
      case 'sh':
      case 'bat':
      case 'cmd':
      case 'ps1':
        return { mode: 'ace/mode/sh', label: 'Shell / Batch', icon: 'fa-solid fa-terminal', color: '#e2e8f0' };
      default:
        return { mode: 'ace/mode/text', label: 'Düz Metin', icon: 'fa-solid fa-file-lines', color: '#94a3b8' };
    }
  }

  function changeScriptTheme(themeName) {
    if (scriptAceEditor) {
      scriptAceEditor.setTheme(`ace/theme/${themeName}`);
      localStorage.setItem('shield_script_theme', themeName);
      if (typeof showToast === 'function') showToast(`Kod teması: ${themeName}`, 'info');
    }
  }

  function changeScriptFontSize(fontSize) {
    if (scriptAceEditor) {
      scriptAceEditor.setFontSize(fontSize);
      localStorage.setItem('shield_script_fontsize', fontSize);
    }
  }

  function toggleScriptWrap() {
    if (!scriptAceEditor) return;
    currentAceWrapMode = !currentAceWrapMode;
    scriptAceEditor.session.setUseWrapMode(currentAceWrapMode);
    const btn = document.getElementById('scripts-btn-wrap');
    if (btn) {
      btn.style.color = currentAceWrapMode ? 'var(--primary)' : '';
      btn.style.borderColor = currentAceWrapMode ? 'var(--primary)' : '';
      btn.style.background = currentAceWrapMode ? 'rgba(224, 169, 139, 0.15)' : '';
    }
  }

  function openScriptSearch() {
    if (scriptAceEditor) {
      scriptAceEditor.execCommand('find');
    }
  }

  function switchScriptTab(filePath) {
    activeScriptTabPath = filePath;
    renderScriptTabs();
    renderScriptsTreeItems();

    const tab = openScriptTabs.find(t => t.path === filePath);
    const emptyEl = document.getElementById('scripts-empty-editor');
    const activeWrap = document.getElementById('scripts-editor-active-wrap');
    const toolbar = document.getElementById('scripts-editor-toolbar');
    const footer = document.getElementById('scripts-editor-footer');

    if (!tab) {
      if (emptyEl) emptyEl.style.display = 'flex';
      if (activeWrap) activeWrap.style.display = 'none';
      if (toolbar) toolbar.style.display = 'none';
      if (footer) footer.style.display = 'none';
      return;
    }

    if (emptyEl) emptyEl.style.display = 'none';
    if (activeWrap) activeWrap.style.display = 'flex';
    if (toolbar) toolbar.style.display = 'flex';
    if (footer) footer.style.display = 'flex';

    const pathEl = document.getElementById('scripts-active-file-path');
    if (pathEl) pathEl.textContent = tab.path;

    const pill = document.getElementById('scripts-active-file-dirty-pill');
    if (pill) {
      pill.className = tab.isDirty ? 'cfg-status-pill cfg-status-modified' : 'cfg-status-pill cfg-status-saved';
      pill.textContent = tab.isDirty ? 'DÜZENLENDİ' : 'KAYDEDİLDİ';
    }

    const restartBtn = document.getElementById('scripts-btn-restart-res');
    const restartLabel = document.getElementById('scripts-btn-restart-res-label');
    if (restartBtn && restartLabel) {
      if (tab.resourceName) {
        restartBtn.style.display = 'inline-flex';
        restartLabel.textContent = `${tab.resourceName} Restart`;
      } else {
        restartBtn.style.display = 'none';
      }
    }

    // Set Language Badge in Footer
    const langInfo = getScriptLangInfo(tab.name || tab.path);
    const langEl = document.getElementById('scripts-stat-lang');
    if (langEl) {
      langEl.innerHTML = `<i class="${langInfo.icon}" style="color: ${langInfo.color};"></i> <span style="color: ${langInfo.color};">${langInfo.label}</span>`;
    }

    // Initialize Ace Editor or populate fallback
    const editor = initScriptAceEditor();
    if (editor) {
      isSettingAceValue = true;
      editor.session.setMode(langInfo.mode);
      editor.session.setUseWorker(false);
      editor.setValue(tab.content != null ? tab.content : '', -1);
      editor.session.getUndoManager().reset();
      editor.session.setUseWrapMode(currentAceWrapMode);
      isSettingAceValue = false;
      setTimeout(() => {
        editor.resize();
        editor.focus();
      }, 50);
    } else {
      const textarea = document.getElementById('scripts-editor-textarea');
      if (textarea) {
        textarea.value = tab.content;
        textarea.scrollTop = 0;
        textarea.scrollLeft = 0;
      }
      syncScriptLineScroll();
    }

    updateScriptStats(tab.content || '');
  }

  function renderScriptTabs() {
    const bar = document.getElementById('scripts-tabs-bar');
    if (!bar) return;

    if (openScriptTabs.length === 0) {
      bar.innerHTML = '<span style="font-size: 11px; color: #475569; padding: 8px 14px; font-family: monospace;">Açık dosya yok</span>';
      return;
    }

    bar.innerHTML = '';
    openScriptTabs.forEach(t => {
      const tabEl = document.createElement('div');
      tabEl.className = 'scripts-tab' + (t.path === activeScriptTabPath ? ' active-tab' : '');

      const iconHtml = getScriptFileIconHtml(t.name, t.ext, false, false, false);
      const dirtyHtml = t.isDirty ? '<span class="scripts-tab-dirty" title="Kaydedilmemiş Değişiklik"></span>' : '';

      tabEl.innerHTML = `
        ${iconHtml}
        <span>${t.name}</span>
        ${dirtyHtml}
        <span class="scripts-tab-close" title="Sekmeyi Kapat" onclick="closeScriptTab('${t.path}', event)">&times;</span>
      `;

      tabEl.onclick = (e) => {
        if (e.target.classList.contains('scripts-tab-close')) return;
        switchScriptTab(t.path);
      };

      bar.appendChild(tabEl);
    });
  }

  function closeScriptTab(filePath, event) {
    if (event) event.stopPropagation();

    const idx = openScriptTabs.findIndex(t => t.path === filePath);
    if (idx === -1) return;

    const tab = openScriptTabs[idx];
    if (tab.isDirty) {
      const ok = confirm(`"${tab.name}" dosyasında kaydedilmemiş değişiklikler var. Yine de kapatmak istiyor musunuz?`);
      if (!ok) return;
    }

    openScriptTabs.splice(idx, 1);

    if (activeScriptTabPath === filePath) {
      if (openScriptTabs.length > 0) {
        const nextIdx = Math.max(0, idx - 1);
        switchScriptTab(openScriptTabs[nextIdx].path);
      } else {
        switchScriptTab(null);
      }
    } else {
      renderScriptTabs();
    }
  }

  function handleScriptEditorInput() {
    const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
    if (!tab) return;

    const textarea = document.getElementById('scripts-editor-textarea');
    if (!textarea) return;

    const newContent = textarea.value;
    tab.content = newContent;
    tab.isDirty = (newContent !== tab.originalContent);

    const pill = document.getElementById('scripts-active-file-dirty-pill');
    if (pill) {
      pill.className = tab.isDirty ? 'cfg-status-pill cfg-status-modified' : 'cfg-status-pill cfg-status-saved';
      pill.textContent = tab.isDirty ? 'DÜZENLENDİ' : 'KAYDEDİLDİ';
    }

    renderScriptTabs();
    updateScriptStats(newContent);
    syncScriptLineScroll();
  }

  function updateScriptStats(content) {
    const lines = content.split('\n').length;
    const sizeBytes = new Blob([content]).size;
    const sizeFormatted = formatScriptFileSize(sizeBytes);

    const lineNumEl = document.getElementById('scripts-line-numbers');
    if (lineNumEl) {
      let nums = '';
      for (let i = 1; i <= lines; i++) {
        nums += i + '\n';
      }
      lineNumEl.textContent = nums;
    }

    const linesEl = document.getElementById('scripts-stat-lines');
    if (linesEl) linesEl.textContent = `${lines} Satır`;

    const sizeEl = document.getElementById('scripts-stat-size');
    if (sizeEl) sizeEl.textContent = sizeFormatted;

    const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
    const resEl = document.getElementById('scripts-stat-res');
    if (resEl) {
      resEl.textContent = tab && tab.resourceName ? `Resource: ${tab.resourceName}` : 'FXServer Script';
    }

    if (!scriptAceEditor) {
      updateScriptCursorInfo();
    }
  }

  function syncScriptLineScroll() {
    const ta = document.getElementById('scripts-editor-textarea');
    const ln = document.getElementById('scripts-line-numbers');
    if (ta && ln) {
      ln.scrollTop = ta.scrollTop;
    }
  }

  function updateScriptCursorInfo() {
    const ta = document.getElementById('scripts-editor-textarea');
    const curEl = document.getElementById('scripts-stat-cursor');
    if (!ta || !curEl) return;

    const pos = ta.selectionStart || 0;
    const textBefore = ta.value.substring(0, pos);
    const line = textBefore.split('\n').length;
    const col = pos - textBefore.lastIndexOf('\n');

    curEl.innerHTML = `<i class="fa-regular fa-i-cursor"></i> Satır: ${line}, Sütun: ${col}`;
  }

  function handleScriptKeyDown(e) {
    if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
      e.preventDefault();
      saveActiveScriptFile();
      return;
    }

    if (e.key === 'Tab') {
      e.preventDefault();
      const ta = e.target;
      const start = ta.selectionStart;
      const end = ta.selectionEnd;

      ta.value = ta.value.substring(0, start) + '  ' + ta.value.substring(end);
      ta.selectionStart = ta.selectionEnd = start + 2;
      handleScriptEditorInput();
    }
  }

  async function saveActiveScriptFile() {
    const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
    if (!tab) return;

    if (scriptAceEditor) {
      tab.content = scriptAceEditor.getValue();
    }

    const saveBtn = document.getElementById('scripts-btn-save-file');
    const origHtml = saveBtn ? saveBtn.innerHTML : '';
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Kaydediliyor...';
    }

    try {
      const res = await fetch('/admin/server/scripts/file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filePath: tab.path, content: tab.content })
      });
      const data = await res.json();
      if (data.success) {
        tab.originalContent = tab.content;
        tab.isDirty = false;
        renderScriptTabs();

        const pill = document.getElementById('scripts-active-file-dirty-pill');
        if (pill) {
          pill.className = 'cfg-status-pill cfg-status-saved';
          pill.textContent = 'KAYDEDİLDİ';
        }

        if (typeof showToast === 'function') showToast(data.message, 'success');
        else alert(data.message);
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Kayıt başarısız.', 'error');
        else alert(data.message || 'Hata.');
      }
    } catch (e) {
      if (typeof showToast === 'function') showToast('Kayıt sırasında bağlantı hatası.', 'error');
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = origHtml;
      }
    }
  }

  async function reloadActiveScriptFile() {
    const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
    if (!tab) return;

    if (tab.isDirty) {
      const ok = confirm('Yaptığınız değişiklikler geri alınacak ve dosya diskten yeniden yüklenecek. Emin misiniz?');
      if (!ok) return;
    }

    try {
      const res = await fetch(`/admin/server/scripts/file?filePath=${encodeURIComponent(tab.path)}`);
      const data = await res.json();
      if (data.success) {
        tab.content = data.content;
        tab.originalContent = data.content;
        tab.isDirty = false;

        if (scriptAceEditor) {
          isSettingAceValue = true;
          scriptAceEditor.setValue(data.content != null ? data.content : '', -1);
          scriptAceEditor.session.getUndoManager().reset();
          isSettingAceValue = false;
        } else {
          const textarea = document.getElementById('scripts-editor-textarea');
          if (textarea) textarea.value = data.content;
        }

        updateScriptStats(data.content);
        renderScriptTabs();

        const pill = document.getElementById('scripts-active-file-dirty-pill');
        if (pill) {
          pill.className = 'cfg-status-pill cfg-status-saved';
          pill.textContent = 'KAYDEDİLDİ';
        }

        if (typeof showToast === 'function') showToast('Dosya diskten yeniden yüklendi.', 'info');
      }
    } catch (e) {
      if (typeof showToast === 'function') showToast('Yeniden yükleme hatası.', 'error');
    }
  }

  function copyActiveScriptContent() {
    const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
    if (!tab) return;
    const content = scriptAceEditor ? scriptAceEditor.getValue() : tab.content;
    navigator.clipboard.writeText(content).then(() => {
      if (typeof showToast === 'function') showToast('Script içeriği panoya kopyalandı.', 'success');
    }).catch(() => {
      if (typeof showToast === 'function') showToast('Kopyalama başarısız oldu.', 'error');
    });
  }

  async function restartActiveTabResource() {
    const tab = openScriptTabs.find(t => t.path === activeScriptTabPath);
    if (!tab || !tab.resourceName) return;
    quickRestartScriptResource(tab.resourceName);
  }

  async function quickRestartScriptResource(resName, event) {
    if (event) event.stopPropagation();
    if (!resName) return;

    try {
      const res = await fetch('/admin/server/scripts/restart-resource', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resourceName: resName })
      });
      const data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message, 'success');
        else alert(data.message);
        setTimeout(fetchConsoleLogs, 500);
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Hata.', 'error');
      }
    } catch (e) {
      if (typeof showToast === 'function') showToast('Restart komutu iletilemedi.', 'error');
    }
  }

  function formatScriptFileSize(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  /* Modals */
  function openCreateScriptModal(isFolder) {
    pendingPromptAction = {
      type: isFolder ? 'new_folder' : 'new_file',
      parentPath: currentScriptsPath
    };

    const titleEl = document.getElementById('script-prompt-title');
    const descEl = document.getElementById('script-prompt-desc');
    const inputLabel = document.getElementById('script-prompt-input-label');
    const input = document.getElementById('script-prompt-input');
    const btn = document.getElementById('script-prompt-submit-btn');
    const icon = document.getElementById('script-prompt-icon');

    if (isFolder) {
      if (titleEl) titleEl.textContent = 'Yeni Klasör Oluştur';
      if (descEl) descEl.textContent = `"${currentScriptsPath || 'kök'}" içerisine yeni bir klasör oluşturun.`;
      if (inputLabel) inputLabel.textContent = 'Klasör Adı';
      if (input) { input.placeholder = 'Örn: client veya [qb]'; input.value = ''; }
      if (btn) btn.textContent = 'Klasör Oluştur';
      if (icon) icon.className = 'fa-solid fa-folder-plus';
    } else {
      if (titleEl) titleEl.textContent = 'Yeni Script Dosyası Oluştur';
      if (descEl) descEl.textContent = `"${currentScriptsPath || 'kök'}" içerisine yeni bir script dosyası oluşturun.`;
      if (inputLabel) inputLabel.textContent = 'Dosya Adı & Uzantısı';
      if (input) { input.placeholder = 'Örn: config.lua, main.js, fxmanifest.lua'; input.value = ''; }
      if (btn) btn.textContent = 'Dosya Oluştur';
      if (icon) icon.className = 'fa-solid fa-file-circle-plus';
    }

    const modal = document.getElementById('script-prompt-modal');
    if (modal) modal.style.display = 'flex';
    setTimeout(() => { if (input) input.focus(); }, 100);
  }

  function openRenameScriptModal(itemPath, currentName, event) {
    if (event) event.stopPropagation();

    pendingPromptAction = {
      type: 'rename',
      targetPath: itemPath
    };

    const titleEl = document.getElementById('script-prompt-title');
    const descEl = document.getElementById('script-prompt-desc');
    const inputLabel = document.getElementById('script-prompt-input-label');
    const input = document.getElementById('script-prompt-input');
    const btn = document.getElementById('script-prompt-submit-btn');
    const icon = document.getElementById('script-prompt-icon');

    if (titleEl) titleEl.textContent = 'Yeniden Adlandır';
    if (descEl) descEl.textContent = `"${currentName}" için yeni adı girin.`;
    if (inputLabel) inputLabel.textContent = 'Yeni Ad';
    if (input) { input.placeholder = 'Yeni isim...'; input.value = currentName; }
    if (btn) btn.textContent = 'Adı Değiştir';
    if (icon) icon.className = 'fa-solid fa-pen';

    const modal = document.getElementById('script-prompt-modal');
    if (modal) modal.style.display = 'flex';
    setTimeout(() => { if (input) { input.focus(); input.select(); } }, 100);
  }

  function closeScriptPromptModal() {
    const modal = document.getElementById('script-prompt-modal');
    if (modal) modal.style.display = 'none';
    pendingPromptAction = null;
  }

  function handleScriptPromptKeyDown(e) {
    if (e.key === 'Enter') {
      submitScriptPrompt();
    } else if (e.key === 'Escape') {
      closeScriptPromptModal();
    }
  }

  async function submitScriptPrompt() {
    if (!pendingPromptAction) return;

    const input = document.getElementById('script-prompt-input');
    const val = input ? input.value.trim() : '';
    if (!val) {
      if (typeof showToast === 'function') showToast('İsim boş bırakılamaz.', 'warning');
      return;
    }

    const action = pendingPromptAction;
    closeScriptPromptModal();

    if (action.type === 'new_file' || action.type === 'new_folder') {
      try {
        const res = await fetch('/admin/server/scripts/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            parentPath: action.parentPath,
            name: val,
            isFolder: action.type === 'new_folder'
          })
        });
        const data = await res.json();
        if (data.success) {
          if (typeof showToast === 'function') showToast(data.message, 'success');
          loadScriptsTree(action.parentPath);
          if (action.type === 'new_file' && data.newPath) {
            openScriptFile(data.newPath);
          }
        } else {
          if (typeof showToast === 'function') showToast(data.message || 'Oluşturulamadı.', 'error');
        }
      } catch (e) {
        if (typeof showToast === 'function') showToast('Bağlantı hatası: ' + e.message, 'error');
      }
    } else if (action.type === 'rename') {
      try {
        const res = await fetch('/admin/server/scripts/rename', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            targetPath: action.targetPath,
            newName: val
          })
        });
        const data = await res.json();
        if (data.success) {
          if (typeof showToast === 'function') showToast(data.message, 'success');

          // Update tab if open
          const tab = openScriptTabs.find(t => t.path === action.targetPath);
          if (tab && data.newPath) {
            tab.path = data.newPath;
            tab.name = val;
            if (activeScriptTabPath === action.targetPath) {
              activeScriptTabPath = data.newPath;
              const pathEl = document.getElementById('scripts-active-file-path');
              if (pathEl) pathEl.textContent = data.newPath;
            }
            renderScriptTabs();
          }

          loadScriptsTree(currentScriptsPath);
        } else {
          if (typeof showToast === 'function') showToast(data.message || 'Yeniden adlandırılamadı.', 'error');
        }
      } catch (e) {
        if (typeof showToast === 'function') showToast('Bağlantı hatası: ' + e.message, 'error');
      }
    }
  }

  function openDeleteScriptModal(itemPath, itemName, isDir, event) {
    if (event) event.stopPropagation();

    pendingDangerAction = { targetPath: itemPath, itemName, isDir };

    const titleEl = document.getElementById('script-danger-title');
    const descEl = document.getElementById('script-danger-desc');

    if (titleEl) titleEl.textContent = `"${itemName}" Silinecek`;
    if (descEl) descEl.textContent = isDir
      ? `Bu klasör ve içindeki tüm scriptler/dosyalar kalıcı olarak silinecektir. Bu işlem geri alınamaz!`
      : `Bu dosya sunucudan kalıcı olarak silinecektir. Bu işlem geri alınamaz!`;

    const modal = document.getElementById('script-danger-modal');
    if (modal) modal.style.display = 'flex';
  }

  function closeScriptDangerModal() {
    const modal = document.getElementById('script-danger-modal');
    if (modal) modal.style.display = 'none';
    pendingDangerAction = null;
  }

  async function submitScriptDangerAction() {
    if (!pendingDangerAction) return;

    const action = pendingDangerAction;
    closeScriptDangerModal();

    try {
      const res = await fetch('/admin/server/scripts/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetPath: action.targetPath })
      });
      const data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message, 'success');

        // Close tabs that match or are inside the deleted path
        openScriptTabs = openScriptTabs.filter(t => {
          if (t.path === action.targetPath || t.path.startsWith(action.targetPath + '/')) {
            return false;
          }
          return true;
        });

        if (activeScriptTabPath === action.targetPath || activeScriptTabPath?.startsWith(action.targetPath + '/')) {
          if (openScriptTabs.length > 0) {
            switchScriptTab(openScriptTabs[0].path);
          } else {
            switchScriptTab(null);
          }
        } else {
          renderScriptTabs();
        }

        loadScriptsTree(currentScriptsPath);
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Silme işlemi başarısız.', 'error');
      }
    } catch (e) {
      if (typeof showToast === 'function') showToast('Silme işlemi sırasında hata: ' + e.message, 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    refreshServerStatus();
    loadConfigFile();
    fetchConsoleLogs();
    loadScriptsSettings();
    loadScriptsTree('');

    setInterval(() => {
      serverUptimeSeconds++;
      const uptimeEl = document.getElementById('stat-server-uptime');
      if (uptimeEl) uptimeEl.textContent = formatUptime(serverUptimeSeconds);
    }, 1000);

    setInterval(refreshServerStatus, 10000);
    setInterval(fetchConsoleLogs, 2000);
  });
</script>
