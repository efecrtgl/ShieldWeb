  async function saveConfigFile() {
    const pathInput = document.getElementById('server-cfg-path-input');
    const editor = document.getElementById('server-cfg-editor');
    const saveBtn = document.getElementById('btn-save-cfg');
    const indicator = document.getElementById('cfg-status-indicator');

    const serverCfgPath = pathInput ? pathInput.value.trim() : '';
    const serverCfgContent = editor ? editor.value : '';

    let origHtml = '';
    if (saveBtn) {
      origHtml = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Kaydediliyor...';
    }

    try {
      const res = await fetch('/admin/server/config-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serverCfgPath, serverCfgContent })
      });
      const data = await res.json();
      if (data.success) {
        if (indicator) {
          indicator.className = 'cfg-status-pill cfg-status-saved';
          indicator.textContent = 'KAYDEDİLDİ';
        }
        if (typeof showToast === 'function') showToast(data.message, 'success');
        else alert(data.message);
        setTimeout(fetchConsoleLogs, 500);
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Hata.', 'error');
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Kayıt hatası.', 'error');
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = origHtml;
      }
    }
  }

