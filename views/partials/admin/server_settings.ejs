  let currentScriptsPath = '';
  let openScriptTabs = [];
  let activeScriptTabPath = null;
  let scriptsRawTreeItems = [];
  let pendingPromptAction = null;
  let pendingDangerAction = null;
  let isStudioFullscreen = false;

  async function loadScriptsSettings() {
    try {
      const res = await fetch('/admin/server/scripts/settings');
      const data = await res.json();
      if (!data.success) return;

      const input = document.getElementById('scripts-base-dir-input');
      if (input) input.value = data.configuredPath || data.effectivePath || '';

      const badge = document.getElementById('scripts-active-path-badge');
