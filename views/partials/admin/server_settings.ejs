  async function refreshServerStatus() {
    try {
      const res = await fetch('/admin/server/status');
      const data = await res.json();
      if (!data.success) return;

      const indicator = document.getElementById('server-live-indicator');
      const stateEl = document.getElementById('stat-server-state');
      const ramEl = document.getElementById('stat-server-ram');
      const playersEl = document.getElementById('stat-server-players');
      const cmdInput = document.getElementById('fivem-start-cmd-input');

      if (cmdInput && data.fivemStartCommand && !cmdInput.value) {
        cmdInput.value = data.fivemStartCommand;
      }

      if (data.status === 'online') {
        if (indicator) {
          indicator.style.background = 'rgba(16, 185, 129, 0.12)';
          indicator.style.color = 'var(--success)';
          indicator.style.borderColor = 'rgba(16, 185, 129, 0.25)';
          indicator.innerHTML = '<span style="width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 10px var(--success);"></span> <span>FiveM Sunucusu Açık</span>';
        }
        if (stateEl) stateEl.textContent = 'Aktif (Online)';
      } else {
        if (indicator) {
          indicator.style.background = 'rgba(239, 68, 68, 0.12)';
          indicator.style.color = 'var(--danger)';
          indicator.style.borderColor = 'rgba(239, 68, 68, 0.25)';
          indicator.innerHTML = '<span style="width: 7px; height: 7px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 10px var(--danger);"></span> <span>FiveM Sunucusu Kapalı</span>';
        }
        if (stateEl) stateEl.textContent = 'Kapalı (Offline)';
      }

      if (data.memory && data.memory.rss) {
        const mb = Math.round(data.memory.rss / (1024 * 1024));
        if (ramEl) ramEl.textContent = mb + ' MB';
      }

      if (playersEl) {
        playersEl.textContent = (data.activePlayers || 0) + ' Oyuncu';
      }

      if (typeof data.uptime === 'number') {
        serverUptimeSeconds = Math.floor(data.uptime);
        const uptimeEl = document.getElementById('stat-server-uptime');
        if (uptimeEl) uptimeEl.textContent = formatUptime(serverUptimeSeconds);
      }
    } catch (err) {
      console.error(err);
