  async function fetchConsoleLogs() {
    try {
      const res = await fetch('/admin/server/console-logs');
      const data = await res.json();
      if (!data.success || !Array.isArray(data.logs)) return;

      if (data.logs.length !== lastConsoleLogCount || JSON.stringify(data.logs) !== JSON.stringify(allRawLogs)) {
        lastConsoleLogCount = data.logs.length;
        allRawLogs = data.logs;
        renderTerminalLogs();
      }
    } catch (e) {}
  }

  function clearCmdConsole() {
    allRawLogs = [{ time: new Date().toLocaleTimeString('tr-TR'), type: 'system', text: 'Konsol temizlendi.' }];
    lastConsoleLogCount = 1;
    renderTerminalLogs();
  }

  function handleCmdKeyDown(event) {
    if (event.key === 'Enter') {
      sendConsoleCommand();
    } else if (event.key === 'ArrowUp') {
      if (cmdCommandHistory.length > 0) {
        if (cmdHistoryIndex < cmdCommandHistory.length - 1) {
          cmdHistoryIndex++;
          const val = cmdCommandHistory[cmdCommandHistory.length - 1 - cmdHistoryIndex];
          event.target.value = val;
        }
      }
      event.preventDefault();
    } else if (event.key === 'ArrowDown') {
      if (cmdHistoryIndex > 0) {
        cmdHistoryIndex--;
        const val = cmdCommandHistory[cmdCommandHistory.length - 1 - cmdHistoryIndex];
        event.target.value = val;
      } else if (cmdHistoryIndex === 0) {
        cmdHistoryIndex = -1;
        event.target.value = '';
      }
      event.preventDefault();
    }
  }

  async function sendConsoleCommand() {
    const input = document.getElementById('cmd-input-field');
    if (!input || !input.value.trim()) return;

    const command = input.value.trim();
    cmdCommandHistory.push(command);
    if (cmdCommandHistory.length > 50) cmdCommandHistory.shift();
    cmdHistoryIndex = -1;
    input.value = '';

    try {
      const res = await fetch('/admin/server/console-command', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command })
      });
      const data = await res.json();
      setTimeout(fetchConsoleLogs, 200);
    } catch (err) {
      if (typeof showToast === 'function') showToast('Komut gönderilemedi.', 'error');
    }
  }

  function updateCfgLineNumbers() {
    const editor = document.getElementById('server-cfg-editor');
    const numbersEl = document.getElementById('cfg-line-numbers');
    const linesStat = document.getElementById('cfg-stat-lines');
    const charsStat = document.getElementById('cfg-stat-chars');
    if (!editor || !numbersEl) return;

    const lines = editor.value.split('\n');
    const lineCount = lines.length;
    let numbersText = '';
    for (let i = 1; i <= lineCount; i++) {
      numbersText += i + '\n';
    }
    numbersEl.textContent = numbersText;

    if (linesStat) linesStat.innerHTML = `<i class="fa-solid fa-bars"></i> ${lineCount} Satır`;
    if (charsStat) charsStat.textContent = `${editor.value.length.toLocaleString('tr-TR')} Karakter`;
  }

  function syncCfgLineScroll() {
    const editor = document.getElementById('server-cfg-editor');
    const numbersEl = document.getElementById('cfg-line-numbers');
    if (editor && numbersEl) {
      numbersEl.scrollTop = editor.scrollTop;
    }
  }

  function handleCfgInput() {
    updateCfgLineNumbers();
    const indicator = document.getElementById('cfg-status-indicator');
    if (indicator) {
      indicator.className = 'cfg-status-pill cfg-status-modified';
      indicator.textContent = 'DEĞİŞTİRİLDİ';
    }
  }

  function handleCfgKeyDown(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      const editor = e.target;
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
      editor.selectionStart = editor.selectionEnd = start + 2;
      handleCfgInput();
    }
  }

  function insertIntoCfg(snippet) {
    const editor = document.getElementById('server-cfg-editor');
    if (!editor) return;
    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    editor.value = editor.value.substring(0, start) + snippet + editor.value.substring(end);
    editor.selectionStart = editor.selectionEnd = start + snippet.length;
    editor.focus();
    handleCfgInput();
  }

  function copyCfgContent() {
    const editor = document.getElementById('server-cfg-editor');
    if (!editor) return;
    navigator.clipboard.writeText(editor.value).then(() => {
      if (typeof showToast === 'function') showToast('server.cfg içeriği panoya kopyalandı.', 'success');
      else alert('Kopyalandı.');
    });
