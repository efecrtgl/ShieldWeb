        <span id="server-status-text">FiveM Sunucusu Açık</span>
      </span>
      <button onclick="refreshServerStatus()" class="btn-secondary" style="font-size: 12px; padding: 8px 14px; display: flex; align-items: center; gap: 6px; border-radius: 8px; cursor: pointer;">
        <i class="fa-solid fa-rotate"></i> Yenile
      </button>
    </div>
