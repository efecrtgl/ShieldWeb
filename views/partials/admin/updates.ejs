<% if (userPermissions.manageUpdates) { %>
  <section id="updates-content" class="admin-section-inner">
    <div class="main-layout">
      <div class="content-panel" style="grid-column: span 6;">
        <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; margin-bottom: 20px;  display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-plus-circle text-sky-400"></i> Güncelleme Notu Ekle
        </h3>
        <form action="/admin/add-update" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-group">
            <label class="form-label">Başlık</label>
            <input type="text" name="title" placeholder="v1.0.0" class="form-input" required>
          </div>
          <div class="form-group">
            <label class="form-label">Açıklama</label>
            <textarea name="description" placeholder="Açıklama giriniz..." class="form-input" required style="resize: none; min-height: 120px;"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;"><i class="fa-solid fa-paper-plane"></i> Notu Yayınla</button>
        </form>
      </div>

      <div class="content-panel" style="grid-column: span 6; overflow-x: auto; padding: 24px;">
        <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; margin-bottom: 20px;  display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-list-ol text-sky-400"></i> Yayınlanmış Notlar
        </h3>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Başlık</th>
              <th>Tarih</th>
              <th>İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% if (updates && updates.length > 0) { %>
              <% updates.forEach(update => { %>
                <tr>
                  <td style="font-weight: 700; "><%= update.title %></td>
                  <td style="color: var(--text-muted);"><%= new Date(update.date).toLocaleDateString('tr-TR') %></td>
                  <td>
                    <button type="button" class="btn edit-update-btn" 
                            data-id="<%= update._id %>" 
                            data-title="<%= update.title %>" 
                            data-description="<%= update.description %>" 
                            style="background: rgba(0, 113, 227, 0.1); color: var(--primary); padding: 6px 12px; border-radius: 8px; font-size: 11px; margin-right: 6px; border: none; cursor: pointer;">
                      <i class="fa-solid fa-pen-to-square"></i> Düzenle
                    </button>
                    <form action="/admin/delete-update/<%= update._id %>" method="POST" style="display: inline;">
                      <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger); padding: 6px 12px; border-radius: 8px; font-size: 11px;"><i class="fa-solid fa-trash"></i> Sil</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" style="text-align: center; color: var(--text-muted); font-size: 12px; padding: 16px 0;">Not bulunmuyor.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Edit Update Modal -->
  <div id="edit-update-modal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; align-items: center; justify-content: center; padding: 20px; ">
    <div class="content-panel" style="width: 100%; max-width: 500px; background: #0c0d10; border: 1px solid var(--border-color); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; gap: 20px; position: relative;  margin: 0;">
      <button type="button" style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer;" onclick="closeEditUpdateModal()"><i class="fa-solid fa-xmark"></i></button>
      
      <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin: 0;  display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-pen-to-square text-sky-400"></i> Güncelleme Notunu Düzenle
      </h3>

      <form id="edit-update-form" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="form-group">
          <label class="form-label">Başlık</label>
          <input type="text" id="edit-update-title" name="title" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">Açıklama</label>
          <textarea id="edit-update-description" name="description" class="form-input" required style="resize: vertical; min-height: 150px;"></textarea>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeEditUpdateModal()" style="padding: 10px 20px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">İptal Et</button>
          <button type="submit" class="btn btn-primary" style="padding: 10px 24px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;">Değişiklikleri Kaydet</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function closeEditUpdateModal() {
      document.getElementById('edit-update-modal').style.display = 'none';
    }

    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll('.edit-update-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          const description = btn.getAttribute('data-description');
          
          document.getElementById('edit-update-form').setAttribute('action', `/admin/updates/edit/${id}`);
          document.getElementById('edit-update-title').value = title;
          document.getElementById('edit-update-description').value = description;
          
          document.getElementById('edit-update-modal').style.display = 'flex';
        });
      });
    });
  </script>
<% } else { %>
  <div class="locked-overlay">
    <div class="locked-overlay-icon"><i class="fa-solid fa-lock"></i></div>
    <h4>Erişim Kısıtlandı</h4>
    <p>Burayı görüntülemeye yetkiniz yok.</p>
  </div>
<% } %>
