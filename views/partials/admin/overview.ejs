<%#
  Overview — the screen's question: "Is the game server up, and is anything waiting on staff?"
  Every figure is read from /admin/api/overview (database, Discord bot, FiveM bridge) and the live status poll;
  nothing is rendered from defaults. Unknown values are a grey dash, real zeros print as 0.
  Grid (1160 canvas): main 1fr + 360 rail, 16 gap; the KPI strip spans the main column.
%>
<section class="admin-section-inner" id="overview-root" aria-labelledby="overview-heading">
  <div class="section-head">
    <div>
      <h2 id="overview-heading">Sunucu ve topluluk durumu</h2>
      <p id="overview-finding">Veriler yükleniyor…</p>
    </div>
    <div class="actions">
      <span class="freshness" id="overview-freshness"></span>
      <button type="button" class="btn" id="overview-refresh"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Yenile</button>
      <% if (userPermissions.isSuperuser || userPermissions.viewApplications || userPermissions.reviewApplications) { %>
        <a class="btn btn-primary" href="#applications-mgmt">Başvuruları incele</a>
      <% } %>
    </div>
  </div>

  <div id="overview-error" hidden></div>

  <div class="grid grid-main-rail">
    <div class="grid" style="min-width: 0;">
      <!-- The answer: is the game server up, and how full is it. -->
      <article class="content-panel" style="margin: 0;" aria-labelledby="hb-title">
        <div class="card-head">
          <h3 id="hb-title">FiveM sunucusu</h3>
          <span class="meta" id="hb-meta">—</span>
        </div>
        <div style="display: flex; align-items: flex-end; gap: 28px; flex-wrap: wrap;">
          <div>
            <div class="kpi-label">Oyundaki oyuncular</div>
            <div class="kpi-value" style="font-size: var(--fs-lead);" id="hb-players"><span class="skeleton" style="width: 5ch;"></span></div>
          </div>
          <div style="flex: 1; min-width: 220px;">
            <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--faint); margin-bottom: 6px;">
              <span>0</span><span id="hb-capacity-label">Slot sayısı</span>
            </div>
            <div style="height: 8px; border-radius: 999px; background: var(--raised); overflow: hidden;" role="progressbar" aria-label="Doluluk" id="hb-bar" aria-valuemin="0">
              <div id="hb-fill" style="height: 100%; width: 0; background: var(--accent); border-radius: 999px;"></div>
            </div>
          </div>
          <div>
            <div class="kpi-label">Durum</div>
            <div style="margin-top: 8px;" id="hb-status"><span class="pill">Kontrol ediliyor</span></div>
          </div>
        </div>
        <div id="hb-note" style="margin-top: 14px;"></div>

        <div class="card-head" style="margin: 22px 0 6px;">
          <h3 style="font-size: 14px;">Son köprü komutları</h3>
          <a class="meta" href="#active-players-mgmt">Aktif oyunculara git</a>
        </div>
        <ul class="row-list" id="hb-commands" aria-live="polite">
          <li><span class="skeleton-block" style="width: 40%;"></span></li>
        </ul>
      </article>

      <div class="kpi-strip" id="overview-kpis" aria-label="Topluluk sayıları">
        <div class="kpi"><div class="kpi-label" data-kpi-label="totalUsers">Kullanıcılar</div><span class="kpi-value" data-kpi="totalUsers"><span class="skeleton"></span></span><div class="kpi-caption" data-kpi-caption="totalUsers">&nbsp;</div></div>
        <div class="kpi"><div class="kpi-label">Whitelist</div><span class="kpi-value" data-kpi="whitelistCount"><span class="skeleton"></span></span><div class="kpi-caption" data-kpi-caption="whitelistCount">&nbsp;</div></div>
        <div class="kpi"><div class="kpi-label">Yetkililer</div><span class="kpi-value" data-kpi="staffCount"><span class="skeleton"></span></span><div class="kpi-caption" data-kpi-caption="staffCount">&nbsp;</div></div>
        <div class="kpi"><div class="kpi-label">Oyun karakterleri</div><span class="kpi-value" data-kpi="characters"><span class="skeleton"></span></span><div class="kpi-caption" data-kpi-caption="characters">&nbsp;</div></div>
      </div>

      <div class="grid grid-2" style="align-items: start;">
        <article class="content-panel" style="margin: 0;" aria-labelledby="apps-title">
          <div class="card-head">
            <h3 id="apps-title">Gelen başvurular</h3>
            <span class="meta">Son 14 gün, günlük</span>
          </div>
          <div id="apps-chart" style="height: 190px;"></div>
          <div class="kpi-caption" id="apps-caption" style="margin-top: 8px;">&nbsp;</div>
        </article>

        <article class="content-panel" style="margin: 0;" aria-labelledby="pun-title">
          <div class="card-head">
            <h3 id="pun-title">Son cezalar</h3>
            <a class="meta" href="#punishment-mgmt">Tümünü gör</a>
          </div>
          <ul class="row-list" id="pun-list">
            <li><span class="skeleton-block" style="width: 60%;"></span></li>
          </ul>
        </article>
      </div>
    </div>

    <!-- Rail: what is waiting on staff, and who is here to do it. -->
    <aside class="grid" style="min-width: 0;" aria-label="Bekleyen işler ve yetkililer">
      <article class="content-panel" style="margin: 0;" aria-labelledby="queue-title">
        <div class="card-head"><h3 id="queue-title">Bekleyen işler</h3></div>
        <ul class="row-list">
          <li>
            <div class="row-main"><div class="row-title"><a href="#applications-mgmt">İnceleme bekleyen başvuru</a></div><div class="row-sub">Tüm başvuru formları</div></div>
            <span class="kpi-value" style="margin: 0; font-size: 20px;" id="queue-applications"><span class="skeleton"></span></span>
          </li>
          <li>
            <div class="row-main"><div class="row-title"><a href="#punishment-mgmt">Son 7 günde verilen ceza</a></div><div class="row-sub">Discord ve FiveM</div></div>
            <span class="kpi-value" style="margin: 0; font-size: 20px;" id="queue-punishments"><span class="skeleton"></span></span>
          </li>
        </ul>
      </article>

      <article class="content-panel" style="margin: 0;" aria-labelledby="staff-title">
        <div class="card-head"><h3 id="staff-title">Panelde olan yetkililer</h3><span class="meta" id="staff-count"></span></div>
        <ul class="row-list" id="active-staff-list" aria-live="polite">
          <li><span class="skeleton-block" style="width: 50%;"></span></li>
        </ul>
      </article>

      <% if (userPermissions.isSuperuser) { %>
        <article class="content-panel" style="margin: 0;" aria-labelledby="svc-title">
          <div class="card-head"><h3 id="svc-title">Servisler</h3><span class="meta">Panel süreci</span></div>
          <ul class="row-list" id="svc-list"><li><span class="skeleton-block" style="width: 50%;"></span></li></ul>
        </article>
      <% } %>
    </aside>
  </div>
</section>

<script src="/js/charts.js" defer></script>
<script>
  (function () {
    const COMMAND_LABELS = {
      setjob: "Meslek atama", setgang: "Çete atama", giveitem: "Eşya verme", removeitem: "Eşya silme", clearinventory: "Envanter sıfırlama",
      givemoney: "Para verme", update_character: "Karakter düzenleme", delete_character: "Karakter silme", sync_characters: "Karakter senkronu",
      teleport: "Işınlama", vreturn: "Araç çekme", revive: "Canlandırma", kill: "Öldürme", pedmenu: "Ped menüsü", pedver: "Ped verme", pedal: "Ped geri alma",
      send_dm: "Oyuncuya mesaj", kick: "Sunucudan atma", ban: "Yasaklama", execute_command: "Konsol komutu",
      start_screen_watch: "Ekran izleme başlat", stop_screen_watch: "Ekran izleme durdur"
    };
    const STATUS_PILLS = {
      succeeded: ["pill-positive", "Uygulandı"], failed: ["pill-negative", "Başarısız"], expired: ["pill-negative", "Zaman aşımı"],
      delivered: ["pill-warning", "İletildi, doğrulanamadı"], queued: ["", "Kuyrukta"]
    };
    const SERVICE_PILLS = { ONLINE: ["pill-positive", "Çalışıyor"], CONNECTING: ["pill-warning", "Bağlanıyor"], OFFLINE: ["", "Kapalı"], ERROR: ["pill-negative", "Hata"] };

    let loading = false;
    let lastData = null;
    let chartDrawn = false;
    const $ = id => document.getElementById(id);
    const pill = ([cls, text]) => `<span class="pill ${cls}">${Console.escapeHtml(text)}</span>`;

    function renderHeartbeat(bridge) {
      if (!bridge) return;
      const players = $("hb-players");
      const fill = $("hb-fill");
      const bar = $("hb-bar");
      if (bridge.online) {
        players.innerHTML = Console.formatNumber(bridge.playersCount) + (bridge.maxPlayers ? `<span class="unit"> / ${Console.formatNumber(bridge.maxPlayers)}</span>` : "");
        $("hb-capacity-label").textContent = bridge.maxPlayers ? `${bridge.maxPlayers} slot` : "Slot sayısı bildirilmedi";
        fill.style.width = bridge.maxPlayers ? `${Math.min(100, (bridge.playersCount / bridge.maxPlayers) * 100)}%` : "0";
        bar.setAttribute("aria-valuenow", String(bridge.playersCount));
        if (bridge.maxPlayers) bar.setAttribute("aria-valuemax", String(bridge.maxPlayers));
        $("hb-status").innerHTML = pill(["pill-positive", "Çevrimiçi"]);
      } else {
        players.innerHTML = '<span class="dash" title="Sunucu çevrimdışıyken oyuncu sayısı bilinmez">—</span>';
        $("hb-capacity-label").textContent = "Sunucu çevrimdışı";
        fill.style.width = "0";
        bar.removeAttribute("aria-valuenow");
        $("hb-status").innerHTML = pill(["pill-negative", "Çevrimdışı"]);
      }
      $("hb-meta").textContent = bridge.lastPollAt ? `Son veri ${Console.relativeTime(bridge.lastPollAt)}` : "Köprü hiç bağlanmadı";

      let note = "";
      if (!bridge.lastPollAt) {
        note = '<div class="state-empty"><strong>FiveM köprüsü bu panel açıldığından beri bağlanmadı.</strong><span>shield-software resource\'unun sunucuda çalıştığını ve config.json içindeki apiUrl ile secretKey değerlerini kontrol edin.</span></div>';
      } else if (bridge.online && !bridge.reportsResults) {
        note = '<div class="notice info"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>Oyun sunucusundaki köprü eski sürüm: komutlar iletiliyor ancak sonuçları bildirilmiyor. shield-software resource\'unu güncelleyin.</span></div>';
      }
      $("hb-note").innerHTML = note;
    }

    function renderCommands(commands) {
      const list = $("hb-commands");
      if (!commands.length) {
        list.innerHTML = '<li><span class="row-sub">Bu panel oturumunda henüz köprü komutu gönderilmedi.</span></li>';
        return;
      }
      list.innerHTML = commands.map(c => `<li>
        <div class="row-main"><div class="row-title">${Console.escapeHtml(COMMAND_LABELS[c.action] || c.action)}</div>
        <div class="row-sub">${Console.escapeHtml(c.error || Console.relativeTime(c.createdAt))}</div></div>
        <div class="row-end">${pill(STATUS_PILLS[c.status] || ["", c.status])}</div></li>`).join("");
    }

    function renderKpis(data) {
      const c = data.community;
      const set = (key, html, caption) => {
        document.querySelector(`[data-kpi="${key}"]`).innerHTML = html;
        document.querySelector(`[data-kpi-caption="${key}"]`).textContent = caption || " ";
      };
      if (c) {
        document.querySelector('[data-kpi-label="totalUsers"]').textContent = c.source === "discord" ? "Discord üyeleri" : "Kayıtlı kullanıcılar";
        const source = c.source === "discord" ? "Discord botundan, canlı" : "Panel veritabanından";
        set("totalUsers", Console.formatNumber(c.totalUsers), source);
        set("whitelistCount", Console.formatNumber(c.whitelistCount), source);
        set("staffCount", Console.formatNumber(c.staffCount), source);
      } else {
        for (const k of ["totalUsers", "whitelistCount", "staffCount"]) set(k, '<span class="dash">—</span>', "Okunamadı");
      }
      set("characters", Console.formatNumber(data.characters.count),
        data.characters.lastSyncAt ? `Son senkron ${Console.relativeTime(data.characters.lastSyncAt)}` : "Henüz senkronize edilmedi");
    }

    function renderApplications(apps) {
      const el = $("apps-chart");
      const totals = apps.series.reduce((acc, d) => { acc.all += d.pending + d.approved + d.rejected; acc.approved += d.approved; acc.rejected += d.rejected; return acc; }, { all: 0, approved: 0, rejected: 0 });
      $("apps-caption").textContent = `14 günde ${totals.all} başvuru · ${totals.approved} onaylandı · ${totals.rejected} reddedildi`;
      if (!window.Charts) return;
      el.innerHTML = "";
      const labels = apps.series.map(d => {
        const [, m, day] = d.day.split("-");
        return `${Number(day)}.${Number(m)}`;
      });
      window.Charts.bars(el, {
        labels,
        values: apps.series.map(d => d.pending + d.approved + d.rejected),
        highlight: apps.series.length - 1,
        format: window.Charts.fmt.int,
        integer: true
      });
      chartDrawn = true;
    }

    function renderPunishments(rows) {
      const list = $("pun-list");
      if (!rows.length) {
        list.innerHTML = '<li><span class="row-sub">Henüz ceza kaydı yok.</span></li>';
        return;
      }
      list.innerHTML = rows.map(p => `<li>
        <div class="row-main"><div class="row-title">${Console.escapeHtml(p.username)} · ${Console.escapeHtml(p.action || "Ceza")}</div>
        <div class="row-sub">${Console.escapeHtml(p.reason || "Sebep girilmedi")} · ${Console.escapeHtml(p.executorUsername || "")}</div></div>
        <div class="row-end">${Console.escapeHtml(Console.relativeTime(p.date))}</div></li>`).join("");
    }

    function renderServices(services) {
      const list = $("svc-list");
      if (!list || !services) return;
      list.innerHTML = services.map(s => `<li><div class="row-main"><div class="row-title">${Console.escapeHtml(s.name)}</div>
        <div class="row-sub">${Console.escapeHtml(s.details || "")}</div></div><div class="row-end">${pill(SERVICE_PILLS[s.status] || ["pill-negative", s.status])}</div></li>`).join("");
    }

    function renderFinding(data) {
      const b = data.bridge;
      const parts = [];
      if (!b.online) parts.push(b.lastPollAt ? `FiveM sunucusundan ${Console.relativeTime(b.lastPollAt)} beri veri gelmiyor` : "FiveM köprüsü bağlı değil");
      else parts.push(`Sunucuda ${b.playersCount} oyuncu var${b.maxPlayers ? ` (${b.maxPlayers} slot)` : ""}`);
      const failed = data.recentCommands.filter(c => c.status === "failed" || c.status === "expired").length;
      if (failed) parts.push(`son ${data.recentCommands.length} komuttan ${failed} tanesi uygulanamadı`);
      parts.push(data.queue.pendingApplications ? `${data.queue.pendingApplications} başvuru inceleme bekliyor` : "bekleyen başvuru yok");
      $("overview-finding").textContent = parts.join(", ") + ".";
    }

    async function load() {
      if (loading) return;
      loading = true;
      const res = await Console.api("/admin/api/overview");
      loading = false;
      const errorBox = $("overview-error");
      if (!res.ok || !res.data || !res.data.success) {
        errorBox.hidden = false;
        errorBox.innerHTML = `<div class="state-error" style="margin-bottom: 16px;"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><div><strong>Genel bakış verileri alınamadı.</strong> ${Console.escapeHtml((res.data && res.data.message) || "")}${lastData ? ` Gösterilen değerler ${Console.formatDateTime(lastData.generatedAt)} tarihine ait.` : ""} <button type="button" class="btn-text" id="overview-retry">Tekrar dene</button></div></div>`;
        $("overview-retry").addEventListener("click", load);
        return;
      }
      errorBox.hidden = true;
      const data = res.data;
      lastData = data;
      renderHeartbeat(data.bridge);
      renderCommands(data.recentCommands);
      renderKpis(data);
      renderApplications(data.applications);
      renderPunishments(data.recentPunishments);
      renderServices(data.services);
      renderFinding(data);
      $("queue-applications").textContent = data.queue.pendingApplications;
      $("queue-punishments").textContent = data.queue.punishmentsThisWeek;
      $("overview-freshness").textContent = `Güncellendi ${new Date(data.generatedAt).toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" })}`;
    }

    function isVisible() {
      const section = document.getElementById("overview");
      return section && section.classList.contains("active") && !document.hidden;
    }

    document.addEventListener("DOMContentLoaded", () => {
      $("overview-refresh").addEventListener("click", e => Console.withBusy(e.currentTarget, load));
      load();
      // The live part (players, bridge) follows the 15s status poll; the rest refreshes every minute while visible.
      Console.onBridgeStatus(renderHeartbeat);
      setInterval(() => { if (isVisible()) load(); }, 60000);
      window.addEventListener("load", () => { if (lastData && !chartDrawn) renderApplications(lastData.applications); });
    });

    // Active staff stream (names come from Discord and are escaped).
    document.addEventListener("DOMContentLoaded", () => {
      const list = $("active-staff-list");
      if (!list || !window.EventSource) return;
      let source = null;
      function render(staff) {
        $("staff-count").textContent = staff.length ? `${staff.length} kişi` : "";
        list.innerHTML = staff.length
          ? staff.map(s => `<li><div class="row-main" style="display:flex;align-items:center;gap:10px;">
              <img src="${Console.escapeHtml(s.avatarUrl || "")}" alt="" width="24" height="24" style="border-radius:50%;flex:none;">
              <span class="row-title">${Console.escapeHtml(s.username)}</span></div>
              <span class="row-end">${Console.escapeHtml(s.rankName || "")}</span></li>`).join("")
          : '<li><span class="row-sub">Şu anda panelde başka yetkili yok.</span></li>';
      }
      function connect() {
        if (source) source.close();
        source = new EventSource("/admin/api/active-staff/sse");
        source.onmessage = ev => {
          try {
            const data = JSON.parse(ev.data);
            if (data && data.success) render(data.activeStaff || []);
          } catch (e) { /* ignore malformed frames */ }
        };
        source.onerror = () => {
          list.innerHTML = '<li><span class="row-sub">Yetkili listesi bağlantısı koptu; yeniden bağlanılıyor…</span></li>';
          source.close();
          setTimeout(connect, 5000);
        };
      }
      connect();
    });
  })();
</script>
