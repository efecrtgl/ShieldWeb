<% if (userPermissions.blacklistUserAdd || userPermissions.blacklistUserRemove) { %>
  <% 
    const blacklistUsers = discordUsers.filter(u => u.isPermaBanned);
  %>
  <section id="blacklist-users-content" class="admin-section-inner">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
      <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-user-shield"></i> Blacklist Kullanıcılar</h2>
      <span style="font-size: 13px; color: var(--text-muted); background: rgba(255,255,255,0.02); padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-color);">
        Toplam Blacklist: <strong><%= blacklistUsers.length %></strong>
      </span>
    </div>

    <!-- Blacklist Add Form -->
    <div class="content-panel" style="padding: 20px; margin-bottom: 24px; border: 1px solid var(--border-color); background: rgba(255, 255, 255, 0.01); border-radius: 12px; ">
      <h3 style="font-family: var(--font-display); font-size: 13px; font-weight: 700; color: #fff; margin-top: 0; margin-bottom: 12px;  display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-user-slash" style="color: var(--danger);"></i> Blacklist'e Kullanıcı Ekle
      </h3>
      <form action="/admin/users/blacklist/add" method="POST" style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
          <input type="text" name="discordId" class="form-input" placeholder="Discord ID (Örn: 444578261494661122)" required style="height: 40px; font-size: 13px; border-radius: 8px; width: 100%;">
        </div>
        <% if (userPermissions.blacklistUserAdd || userPermissions.blacklistAdd) { %>
          <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2); font-weight: 600; font-size: 12px; height: 40px; padding: 0 20px; border-radius: 8px; display: flex; align-items: center; gap: 6px; cursor: pointer; border-style: solid;">
            <i class="fa-solid fa-user-slash"></i> Blacklist Ekle
          </button>
        <% } else { %>
          <button type="button" class="btn btn-locked" disabled style="background: rgba(255,255,255,0.02); color: var(--text-muted); border: 1px solid var(--border-color); font-weight: 600; font-size: 12px; height: 40px; padding: 0 20px; border-radius: 8px; display: flex; align-items: center; gap: 6px; cursor: not-allowed; opacity: 0.5;">
            <i class="fa-solid fa-lock"></i> Blacklist Ekle
          </button>
        <% } %>
      </form>
    </div>

    <div class="content-panel" style="padding: 24px; overflow-x: auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Profil</th>
            <th>Kullanıcı Adı</th>
            <th>Discord ID</th>
            <th>Durum</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% if (blacklistUsers.length > 0) { %>
            <% blacklistUsers.forEach(dUser => { %>
              <tr>
                <td>
                  <img class="sensitive-info" src="<%= dUser.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-color);">
                </td>
                <td class="sensitive-info" style="font-weight: 600;"><%= dUser.username %></td>
                <td class="sensitive-info" style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);"><%= dUser.discordId %></td>
                <td style="color: var(--danger); font-weight: 600;">
                  ● Kalıcı Yasaklı (Perma)
                </td>
                <td>
                  <div style="display: flex; gap: 8px;">
                    <% if (userPermissions.blacklistUserRemove || userPermissions.blacklistRemove) { %>
                      <form action="/admin/users/blacklist/remove/<%= dUser.discordId %>" method="POST" style="display: inline;" onsubmit="return confirm('Bu kullanıcının blacklist yasağını kaldırmak istediğinize emin misiniz?')">
                        <button type="submit" class="btn" style="background: rgba(16, 185, 129, 0.1); color: var(--success); padding: 6px 12px; border-radius: 8px; font-size: 11px; cursor: pointer; border-style: none;">
                          <i class="fa-solid fa-user-check"></i> Yasak Kaldır (Affet)
                        </button>
                      </form>
                    <% } else { %>
                      <button type="button" class="btn btn-locked" disabled style="background: rgba(255,255,255,0.02); color: var(--text-muted); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 8px; font-size: 11px; cursor: not-allowed; opacity: 0.5;">
                        <i class="fa-solid fa-lock"></i> Yasak Kaldır
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; color: var(--text-muted); font-size: 12px; padding: 16px 0;">Blacklist listesinde kullanıcı bulunmuyor.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
<% } else { %>
  <div class="locked-overlay">
    <div class="locked-overlay-icon"><i class="fa-solid fa-lock"></i></div>
    <h4>Erişim Kısıtlandı</h4>
    <p>Burayı görüntülemeye yetkiniz yok.</p>
  </div>
<% } %>
