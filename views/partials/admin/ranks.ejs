<script>
  const userRankAssignments = <%- JSON.stringify(users || []) %>;
  const ranksList = <%- JSON.stringify(ranks || []) %>;

  let currentAssignPage = 1;
  const itemsPerAssignPage = 10;
  let filterQuery = "";
  let currentCreateWizardStep = 1;

  window.switchRanksSection = function(sectionName) {
    const setupSec = document.getElementById("ranks-section-setup");
    const assignSec = document.getElementById("ranks-section-assign");
    const setupBtn = document.getElementById("ranks-tab-btn-setup");
    const assignBtn = document.getElementById("ranks-tab-btn-assign");

    if (!setupSec || !assignSec) return;

    if (sectionName === "setup") {
      setupSec.style.display = "block";
      assignSec.style.display = "none";
      if (setupBtn) setupBtn.className = "btn btn-primary";
