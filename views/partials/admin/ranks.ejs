  document.addEventListener("DOMContentLoaded", function() {
    relocateRanksModals();
    const searchInput = document.getElementById("search-assignments-input");
    if (searchInput) {
      searchInput.addEventListener("input", function(e) {
        filterQuery = e.target.value.trim();
        currentAssignPage = 1;
        renderAssignments();
      });
    }

    const tbody = document.getElementById("ranks-table-body");
    if (tbody) {
      let draggedRow = null;

      tbody.querySelectorAll("td.drag-handle").forEach(handle => {
        handle.addEventListener("dragstart", function(e) {
          draggedRow = handle.closest("tr");
          if (draggedRow) {
            draggedRow.style.opacity = "0.5";
            e.dataTransfer.effectAllowed = "move";
          }
        });

        handle.addEventListener("dragend", function() {
          if (draggedRow) {
            draggedRow.style.opacity = "1";
            draggedRow = null;
          }
        });
      });

      tbody.addEventListener("dragover", function(e) {
        e.preventDefault();
        const targetRow = e.target.closest("tr");
        if (targetRow && draggedRow && targetRow !== draggedRow) {
          const rect = targetRow.getBoundingClientRect();
          const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
          tbody.insertBefore(draggedRow, next ? targetRow.nextSibling : targetRow);
        }
      });

      tbody.addEventListener("drop", async function(e) {
        e.preventDefault();
        const rows = Array.from(tbody.querySelectorAll("tr[data-id]"));
        const ids = rows.map(r => r.getAttribute("data-id"));
        try {
          await fetch("/admin/ranks/reorder", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids })
          });
        } catch (err) {}
      });
    }
  });
</script>