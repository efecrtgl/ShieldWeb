  document.addEventListener("submit", async function(e) {
    if (e.target && e.target.id === "bulk-perm-form") {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const bodyObj = {
        actionType: formData.get("actionType"),
        targetRanks: formData.getAll("targetRanks"),
        permissions: formData.getAll("permissions")
      };

      if (!bodyObj.targetRanks || bodyObj.targetRanks.length === 0) {
        window.notifyUser("Lütfen en az bir rütbe seçiniz.", "error");
        return;
      }
      if (!bodyObj.permissions || bodyObj.permissions.length === 0) {
        window.notifyUser("Lütfen en az bir izin seçiniz.", "error");
        return;
      }

      const submitBtn = form.querySelector("button[type='submit']");
      const origHTML = submitBtn ? submitBtn.innerHTML : "";
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> İşleniyor...';
      }

      try {
        const res = await fetch("/admin/ranks/bulk-permissions", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify(bodyObj)
        });
        const data = await res.json();
        if (data.success) {
          window.notifyUser(data.message, "success");
          if (typeof window.closeBulkPermModal === "function") window.closeBulkPermModal();
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.notifyUser(data.message || "Toplu izin güncellemesi başarısız oldu.", "error");
        }
      } catch (err) {
        window.notifyUser("Bağlantı hatası oluştu.", "error");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = origHTML;
        }
      }
    } else if (e.target && e.target.id === "edit-rank-form") {
      e.preventDefault();
      const form = e.target;
      const action = form.getAttribute("action");
      if (!action) {
        window.notifyUser("Hata: Rütbe güncelleme adresi bulunamadı.", "error");
        return;
      }
      const formData = new FormData(form);
      const submitBtn = form.querySelector("button[type='submit']");
      const origHTML = submitBtn ? submitBtn.innerHTML : "";
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Kaydediliyor...';
      }

      try {
        const res = await fetch(action, {
          method: "POST",
          headers: { "Accept": "application/json" },
          body: new URLSearchParams(formData)
        });
        const data = await res.json();
        if (data.success) {
          window.notifyUser(data.message || "Rütbe izinleri başarıyla güncellendi!", "success");
          if (typeof window.closeEditRankModal === "function") window.closeEditRankModal();
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.notifyUser(data.message || "Rütbe güncellenirken hata oluştu.", "error");
        }
      } catch (err) {
        window.notifyUser("Bağlantı hatası oluştu.", "error");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = origHTML;
        }
      }
    }
  });

