<% if (userPermissions.isSuperuser || userPermissions.viewRanks) { %>
  <style>
    /* Guarantee Button Clickability & High Z-Index for Modals */
    .btn-edit-rank, .btn-copy-rank, .btn-sync-rank, #btn-sync-all-ranks, #ranks-tab-btn-setup, #ranks-tab-btn-assign {
      position: relative !important;
      z-index: 50 !important;
      pointer-events: auto !important;
      cursor: pointer !important;
    }
    .modal-overlay {
      z-index: 999999 !important;
    }

    /* Custom Onay Kutucuğu (Tik Box) Styling */
    .perm-tick-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.015);
      border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      user-select: none;
    }
    .perm-tick-item:hover {
      background: rgba(0, 113, 227, 0.04);
      border-color: rgba(0, 113, 227, 0.3);
    }
    .perm-tick-item input[type="checkbox"] {
      position: absolute;
      opacity: 0;
      cursor: pointer;
      height: 0;
      width: 0;
    }
    .perm-tick-box {
      width: 20px;
      height: 20px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1.5px solid rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
      transition: all 0.2s ease;
      color: transparent;
      font-size: 11px;
    }
    .perm-tick-item input[type="checkbox"]:checked ~ .perm-tick-box {
      background: var(--primary, #0071e3);
      border-color: var(--primary, #0071e3);
      color: #ffffff;
      
    }
    .perm-tick-item input[type="checkbox"]:focus ~ .perm-tick-box {
      
    }
    .permission-item-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex: 1;
    }
    .permission-item-title {
      font-size: 12.5px;
      font-weight: 700;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .permission-item-desc {
      font-size: 11px;
      color: var(--text-muted, #94a3b8);
      line-height: 1.4;
    }
    .badge-sakincali {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .badge-tehlikeli {
      background: rgba(220, 38, 38, 0.25);
      color: #ef4444;
      border: 1px solid rgba(220, 38, 38, 0.5);
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      animation: pulse-border 2s infinite;
    }

    /* Wizard Multi-Step Progress Indicators */
    .wizard-steps-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      position: relative;
      padding: 0 10px;
    }
    .wizard-steps-bar::before {
      content: '';
      position: absolute;
      top: 18px;
      left: 40px;
      right: 40px;
      height: 2px;
      background: rgba(255, 255, 255, 0.1);
      z-index: 1;
    }
    .wizard-step-node {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }
    .wizard-step-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--bg-panel, #12141a);
      border: 2px solid rgba(255, 255, 255, 0.2);
      color: var(--text-muted);
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    .wizard-step-node.active .wizard-step-circle {
      border-color: var(--primary, #0071e3);
      background: var(--primary, #0071e3);
      color: #ffffff;
      
    }
    .wizard-step-node.completed .wizard-step-circle {
      border-color: #10b981;
      background: #10b981;
      color: #ffffff;
    }
    .wizard-step-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      transition: color 0.3s ease;
    }
    .wizard-step-node.active .wizard-step-label {
      color: #ffffff;
      font-weight: 700;
    }

    /* Rank Badge Global Style */
    .rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      text-align: center;
    }

    /* Color Preset Dots & Tabs Header */
    .color-preset-dot {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      cursor: pointer;
      border: 2px solid rgba(255, 255, 255, 0.1);
      transition: all 0.2s ease;
    }
    .color-preset-dot:hover {
      transform: scale(1.15);
      border-color: rgba(255, 255, 255, 0.5);
    }
    .color-preset-dot.active {
      border-color: #ffffff;
      
      transform: scale(1.1);
    }

    .permissions-tabs-header {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      background: rgba(0, 0, 0, 0.2);
      padding: 6px;
      border-radius: 10px;
    }
    .perm-tab-btn {
      flex: 1;
      min-width: 120px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 700;
      padding: 10px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .perm-tab-btn:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #ffffff;
    }
    .perm-tab-btn.active {
      background: var(--primary, #0071e3);
      color: #ffffff;
      
    }
  </style>

  <section id="ranks-content" class="admin-section-inner">
    
    <!-- Section Tabs -->
    <div class="content-panel" style="margin-bottom: 24px; padding: 12px; border-radius: 12px;">
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <button type="button" class="btn btn-primary" id="ranks-tab-btn-setup" onclick="switchRanksSection('setup')" style="flex: 1; height: 42px; border-radius: 8px; font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 8px;">
          <i class="fa-solid fa-gears"></i> Rütbe Tanımları & Yetkiler
        </button>
        <button type="button" class="btn btn-secondary" id="ranks-tab-btn-assign" onclick="switchRanksSection('assign')" style="flex: 1; height: 42px; border-radius: 8px; font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 8px;">
          <i class="fa-solid fa-user-shield"></i> Kullanıcı Rol Atamaları
        </button>
      </div>
    </div>

    <!-- TAB 1: Setup & Ranks List -->
    <div id="ranks-section-setup">
      <div class="content-panel" style="width: 100%; padding: 32px; border-radius: 16px; margin-bottom: 30px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
          <div>
            <h3 style="font-family: var(--font-display); font-size: 16px; font-weight: 600; margin: 0;  color: var(--text-main); display: flex; align-items: center; gap: 8px;">
              <i class="fa-solid fa-list-ol" style="color: var(--primary);"></i> Rütbe & İzin Yönetimi
            </h3>
            <span style="font-size: 11px; color: var(--text-muted); display: block; margin-top: 4px;">Sürükleyip bırakarak rütbelerin öncelik sıralamasını değiştirebilirsiniz.</span>
          </div>
          
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button type="button" class="btn btn-primary" onclick="openCreateRankModal()" style="background: var(--primary); color: #fff; padding: 10px 20px; border-radius: 8px; font-size: 12px; font-weight: 700; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px; ">
              <i class="fa-solid fa-plus-circle"></i> Yeni Rütbe Oluştur
            </button>
            <button type="button" class="btn" id="btn-sync-all-ranks" onclick="syncAllRanksFromDiscord()" style="background: rgba(16, 185, 129, 0.12); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.3); padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-arrows-rotate"></i> Tüm Rütbeleri Eşitle
            </button>
            <button type="button" class="btn" onclick="openBulkPermModal()" style="background: rgba(var(--accent-rgb), 0.12); color: #ffffff; border: 1px solid rgba(var(--accent-rgb), 0.3); padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-user-shield" style="color: var(--primary-light);"></i> Toplu İzin Düzenle
            </button>
          </div>
        </div>
        
        <div style="overflow-x: auto;">
          <table class="admin-table" style="width: 100%;">
            <thead>
              <tr>
                <th style="width: 40px;"></th>
                <th>Rütbe Unvanı</th>
                <th>Discord Rol Eşleşmesi</th>
                <th style="text-align: right;">İşlemler</th>
              </tr>
            </thead>
            <tbody id="ranks-table-body">
              <% if (ranks && ranks.length > 0) { %>
                <% ranks.forEach(rank => { %>
                  <tr data-id="<%= rank._id %>">
                    <td class="drag-handle" draggable="true" style="color: var(--text-muted); text-align: center; font-size: 14px; cursor: grab;"><i class="fa-solid fa-grip-vertical"></i></td>
                    <td>
                      <% if (rank.color && (rank.color.includes("gradient") || rank.color.includes(","))) { %>
                        <span class="rank-badge" style="background: <%= rank.color %>; color: #fff; border: none;  padding: 4px 12px; border-radius: 6px; font-weight: 700;">
                          <%= rank.name %>
                        </span>
                      <% } else { %>
                        <span class="rank-badge" style="background: <%= rank.color || '#3B82F6' %>22; color: <%= rank.color || '#3B82F6' %>; border: 1px solid <%= rank.color || '#3B82F6' %>44; padding: 4px 12px; border-radius: 6px; font-weight: 700;">
                          <%= rank.name %>
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <% if (rank.discordRoleId && rank.discordRoleId.trim()) { %>
                        <span style="font-family: var(--font-mono); font-size: 11px; color: #38bdf8; background: rgba(56,189,248,0.1); border: 1px solid rgba(56,189,248,0.25); padding: 3px 8px; border-radius: 6px;">
                          <i class="fa-brands fa-discord"></i> ID: <%= rank.discordRoleId %>
                        </span>
                      <% } else { %>
                        <span style="font-size: 11px; color: var(--text-muted);">Manuel Atama</span>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <div style="display: inline-flex; gap: 6px; align-items: center;">
                        <% if (rank.discordRoleId && rank.discordRoleId.trim()) { %>
                          <button type="button" class="btn btn-sync-rank" style="background: rgba(0, 113, 227, 0.15); color: var(--primary); border: 1px solid rgba(0,113,227,0.3); padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;" data-id="<%= rank._id %>" onclick="syncRankFromDiscord(this)">
                            <i class="fa-solid fa-arrows-rotate"></i> Eşitle
                          </button>
                        <% } %>
                        <button type="button" class="btn btn-edit-rank" style="background: rgba(var(--accent-rgb), 0.15); color: #ffffff; border: 1px solid rgba(var(--accent-rgb), 0.3); padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;" data-id="<%= rank._id %>" data-name="<%= rank.name %>" data-color="<%= rank.color %>" data-order="<%= rank.order %>" data-discord-role-id="<%= rank.discordRoleId || '' %>" data-perms="<%= encodeURIComponent(JSON.stringify(rank.permissions || {})) %>" onclick="openEditRankModal(this)">
                          <i class="fa-solid fa-pen-to-square" style="color: var(--primary-light);"></i> İzinleri Düzenle
                        </button>
                        <button type="button" class="btn btn-copy-rank" style="background: rgba(16, 185, 129, 0.15); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.3); padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;" data-id="<%= rank._id %>" data-name="<%= rank.name %>" onclick="openCopyRankModal(this)">
                          <i class="fa-solid fa-copy"></i> Kopyala
                        </button>
                        <form action="/admin/ranks/delete/<%= rank._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bu rütbeyi silmek istediğinize emin misiniz?');">
                          <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.15); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.3); padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;"><i class="fa-solid fa-trash-can"></i> Sil</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" style="text-align: center; color: var(--text-muted); font-size: 12px; padding: 24px 0;">Henüz hiç rütbe tanımlanmadı.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: User Rank Assignment List -->
    <div id="ranks-section-assign" style="display: none;">
      <div class="content-panel" style="width: 100%; padding: 32px; border-radius: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
          <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; margin: 0;  color: var(--text-main);">
            <i class="fa-solid fa-user-shield text-sky-400"></i> Kullanıcı Yetkilendirmeleri
          </h3>
          <div style="position: relative; width: 320px;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 13px; color: var(--text-muted); font-size: 13px; z-index: 2;"></i>
            <input type="text" id="search-assignments-input" placeholder="İsim veya Discord ID ara..." class="form-input" style="padding-left: 38px !important; border-radius: 8px; font-size: 12.5px; height: 38px; width: 100%;">
          </div>
        </div>

        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Kullanıcı Adı</th>
                <th>Discord ID</th>
                <th>Mevcut Rütbe</th>
                <th>Yeni Rütbe Ata</th>
              </tr>
            </thead>
            <tbody id="assignments-table-body">
              <!-- Dynamically populated via JS -->
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div id="assignments-pagination" style="display: flex; justify-content: center; gap: 8px; margin-top: 24px; align-items: center;"></div>
      </div>
    </div>

    <!-- MULTI-STEP WIZARD MODAL: Rütbe Oluştur -->
    <div id="create-rank-modal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 99999; align-items: center; justify-content: center; padding: 20px; ">
      <div class="content-panel" style="width: 100%; max-width: 860px; max-height: 90vh; overflow-y: auto; padding: 32px; position: relative; border-radius: 16px; background: var(--bg-panel, #12141a); ">
        <button type="button" onclick="closeCreateRankModal()" style="position: absolute; top: 20px; right: 20px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-muted); width: 32px; height: 32px; border-radius: 8px; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
          <i class="fa-solid fa-xmark"></i>
        </button>

        <h3 style="font-family: var(--font-display); font-size: 17px; font-weight: 600; color: #fff; margin: 0 0 20px 0; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-shield-halved" style="color: var(--primary);"></i> Yeni Rütbe Oluşturma Sihirbazı
        </h3>

        <!-- Step Indicator Bar -->
        <div class="wizard-steps-bar">
          <div class="wizard-step-node active" id="create-step-node-1">
            <div class="wizard-step-circle">1</div>
            <span class="wizard-step-label">Rütbe Ayarları</span>
          </div>
          <div class="wizard-step-node" id="create-step-node-2">
            <div class="wizard-step-circle">2</div>
            <span class="wizard-step-label">İzin Ayarları</span>
          </div>
          <div class="wizard-step-node" id="create-step-node-3">
            <div class="wizard-step-circle">3</div>
            <span class="wizard-step-label">Önizleme & Onay</span>
          </div>
        </div>

        <form id="create-rank-form" action="/admin/ranks/add" method="POST">
          
          <!-- STEP 1: Rütbe Ayarları -->
          <div id="create-step-content-1" class="wizard-step-content">
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <div class="form-group">
                <label class="form-label" style="font-weight: 700; font-size: 13px;">Rütbe Adı</label>
                <input type="text" name="name" id="create-rank-name-input" placeholder="Örn: Kıdemli Yönetici" class="form-input" oninput="updateCreateColorPreview(this.value)" required style="border-radius: 8px; height: 42px; font-size: 14px;">
              </div>

              <div class="form-group">
                <label class="form-label" style="font-weight: 700; font-size: 13px;">Rütbe Rengi (Görünüm Rozeti)</label>

                <!-- Live Preview of the Badge -->
                <div style="margin-bottom: 16px; display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 14px 18px; border-radius: 10px;">
                  <span style="font-size: 12px; color: var(--text-muted);">Önizleme:</span>
                  <span id="create-badge-preview" class="rank-badge" style="background: rgba(59, 130, 246, 0.15); color: #3B82F6; border: 1px solid rgba(59, 130, 246, 0.3); padding: 4px 14px; border-radius: 6px; font-weight: 700; font-size: 13px;">Kıdemli Yönetici</span>
                </div>

                <!-- Color Options -->
                <div style="display: flex; flex-direction: column; gap: 14px;">
                  <div>
                    <label class="form-label" style="font-size: 11px; opacity: 0.8; margin-bottom: 8px;">Düz Renkler</label>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                      <div class="color-preset-dot active" style="background: #3B82F6;" onclick="selectCreatePresetColor('#3B82F6')"></div>
                      <div class="color-preset-dot" style="background: #8B5CF6;" onclick="selectCreatePresetColor('#8B5CF6')"></div>
                      <div class="color-preset-dot" style="background: #10B981;" onclick="selectCreatePresetColor('#10B981')"></div>
                      <div class="color-preset-dot" style="background: #F59E0B;" onclick="selectCreatePresetColor('#F59E0B')"></div>
                      <div class="color-preset-dot" style="background: #F43F5E;" onclick="selectCreatePresetColor('#F43F5E')"></div>
                      <div class="color-preset-dot" style="background: #06B6D4;" onclick="selectCreatePresetColor('#06B6D4')"></div>
                      <div class="color-preset-dot" style="background: #EC4899;" onclick="selectCreatePresetColor('#EC4899')"></div>
                      <div class="color-preset-dot" style="background: #ffffff;" onclick="selectCreatePresetColor('#ffffff')"></div>
                    </div>
                  </div>

                  <div>
                    <label class="form-label" style="font-size: 11px; opacity: 0.8; margin-bottom: 8px;">Gradyan Renkler (Premium)</label>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                      <div class="color-preset-dot" style="background: #FF512F;" onclick="selectCreatePresetColor('#FF512F')"></div>
                      <div class="color-preset-dot" style="background: #02AAB0;" onclick="selectCreatePresetColor('#02AAB0')"></div>
                      <div class="color-preset-dot" style="background: #7F00FF;" onclick="selectCreatePresetColor('#7F00FF')"></div>
                      <div class="color-preset-dot" style="background: #00F2FE;" onclick="selectCreatePresetColor('#00F2FE')"></div>
                    </div>
                  </div>

                  <div>
                    <label class="form-label" style="font-size: 11px; opacity: 0.8; margin-bottom: 6px;">Özel Renk Kodu / CSS Gradyan</label>
                    <input type="text" id="create-custom-color-val" name="color" value="#3B82F6" class="form-input" placeholder="#HEX veya transparent" oninput="updateCreateColorPreview(this.value)" style="border-radius: 8px; height: 38px;">
                  </div>
                </div>
              </div>

              <div class="form-group" style="border-top: 1px solid var(--border-color); padding-top: 18px;">
                <label class="perm-tick-item" style="margin-bottom: 10px;">
                  <input type="checkbox" name="syncFromDiscord" id="create-syncFromDiscord" value="true" onchange="toggleCreateDiscordRoleInput(this.checked)">
                  <span class="perm-tick-box"><i class="fa-solid fa-check"></i></span>
                  <div class="permission-item-info">
                    <span class="permission-item-title"><i class="fa-brands fa-discord" style="color: #5865F2;"></i> Discord Rolünden Kullanıcıları Otomatik Çek</span>
                    <span class="permission-item-desc">Sunucuda bu role sahip üyeler veritabanında otomatik bu rütbeye atanır.</span>
                  </div>
                </label>
                <div id="create-discord-role-input-group" style="display: none; margin-left: 32px; margin-top: 10px;">
                  <label class="form-label" style="font-size: 11px;">Discord Rol ID (Role ID)</label>
                  <input type="text" name="discordRoleId" id="create-discordRoleId" placeholder="Örn: 103735883630395392" class="form-input" style="font-size: 13px; height: 38px; border-radius: 8px;">
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 2: İzin Ayarları (Onay Kutucukları - Tik Box) -->
          <div id="create-step-content-2" class="wizard-step-content" style="display: none;">
            <div class="permissions-tab-container">
              
              <!-- Select All Toggle & Buttons -->
              <div style="border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 12px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <span style="font-size: 13px; font-weight: 700; color: #fff;">Tüm İzinler</span>
                <div style="display: flex; gap: 8px; align-items: center;">
