  window.navigateCreateWizard = function(direction) {
    if (direction === 1 && currentCreateWizardStep === 1) {
      const nameInput = document.getElementById("create-rank-name-input");
      if (!nameInput.value.trim()) {
        showToast("Lütfen önce bir rütbe adı giriniz.", "error");
        nameInput.focus();
        return;
      }
    }
    
    currentCreateWizardStep += direction;
    if (currentCreateWizardStep < 1) currentCreateWizardStep = 1;
    if (currentCreateWizardStep > 3) currentCreateWizardStep = 3;

    updateCreateWizardUI();
  };

  function updateCreateWizardUI() {
    for (let s = 1; s <= 3; s++) {
      const content = document.getElementById(`create-step-content-${s}`);
      const node = document.getElementById(`create-step-node-${s}`);
      if (content) content.style.display = (s === currentCreateWizardStep) ? "block" : "none";
      if (node) {
        node.classList.remove("active", "completed");
        if (s === currentCreateWizardStep) node.classList.add("active");
        else if (s < currentCreateWizardStep) node.classList.add("completed");
      }
    }

    const prevBtn = document.getElementById("create-wizard-prev-btn");
    const nextBtn = document.getElementById("create-wizard-next-btn");
    const submitBtn = document.getElementById("create-wizard-submit-btn");

    if (prevBtn) prevBtn.style.display = (currentCreateWizardStep > 1) ? "inline-flex" : "none";
    if (nextBtn) nextBtn.style.display = (currentCreateWizardStep < 3) ? "inline-flex" : "none";
    if (submitBtn) submitBtn.style.display = (currentCreateWizardStep === 3) ? "inline-flex" : "none";

    // Summary calculation on Step 3
    if (currentCreateWizardStep === 3) {
      const nameVal = document.getElementById("create-rank-name-input").value.trim() || "Rütbe Adı";
      const summaryName = document.getElementById("wizard-summary-name");
      const summaryBadge = document.getElementById("wizard-summary-badge");
      if (summaryName) summaryName.textContent = nameVal;
      if (summaryBadge) summaryBadge.textContent = nameVal;

      const checkedCount = document.querySelectorAll("#create-step-content-2 input[type='checkbox']:checked").length;
      const summaryPerms = document.getElementById("wizard-summary-perms-count");
      if (summaryPerms) summaryPerms.textContent = `${checkedCount} adet izin seçildi.`;
    }
  }

