  async function assignUserRank(e, form) {
    e.preventDefault();
    const formData = new FormData(form);
    const userId = formData.get("userId");
    const rankId = formData.get("rankId");
    const submitBtn = form.querySelector("button[type='submit']");
    const origHTML = submitBtn ? submitBtn.innerHTML : "";
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
    }

    try {
      const res = await fetch("/admin/users/assign", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({ userId, rankId })
      });
      const data = await res.json();
      if (data.success) {
        if (typeof showAdminToast === "function") showAdminToast(data.message, "success");
        else if (typeof showToast === "function") showToast(data.message, "success");

        // Update in-memory user list
        const u = userRankAssignments.find(x => x._id === userId);
        if (u) {
          const r = ranksList.find(x => x._id === rankId);
          u.rankId = r || null;
        }
        renderAssignments();
      } else {
        if (typeof showAdminToast === "function") showAdminToast(data.message || "Rütbe atama başarısız.", "error");
        else alert(data.message || "Hata oluştu.");
      }
    } catch (err) {
      if (typeof showAdminToast === "function") showAdminToast("Bağlantı hatası.", "error");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = origHTML;
      }
    }
  }

  function renderAssignments() {
    const tbody = document.getElementById("assignments-table-body");
    if (!tbody) return;

    const filtered = userRankAssignments.filter(user => {
      const nameMatch = user.username && user.username.toLowerCase().includes(filterQuery.toLowerCase());
      const idMatch = user.discordId && user.discordId.includes(filterQuery);
      return nameMatch || idMatch;
    });

    const totalItems = filtered.length;
    const totalPages = Math.ceil(totalItems / itemsPerAssignPage) || 1;
    if (currentAssignPage > totalPages) currentAssignPage = totalPages;

    const startIndex = (currentAssignPage - 1) * itemsPerAssignPage;
    const endIndex = Math.min(startIndex + itemsPerAssignPage, totalItems);
    const paginated = filtered.slice(startIndex, endIndex);

    tbody.innerHTML = "";
    if (paginated.length === 0) {
      tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: var(--text-muted); padding: 24px 0; font-size: 12px;">Eşleşen kullanıcı bulunamadı.</td></tr>`;
    } else {
      paginated.forEach(user => {
        const tr = document.createElement("tr");
        let rankBadgeMarkup = '<span style="color: var(--text-muted); font-size: 11px;">Rütbe Yok</span>';
        if (user.rankId && typeof user.rankId === 'object' && user.rankId.name) {
          const rColor = user.rankId.color || '#3B82F6';
          rankBadgeMarkup = `<span class="rank-badge" style="background: ${rColor}22; color: ${rColor}; border: 1px solid ${rColor}44; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 11px;">${user.rankId.name}</span>`;
        }

        let selectOptions = '<option value="">Rütbe Seçilmedi</option>';
        ranksList.forEach(r => {
          const isSelected = user.rankId && (user.rankId._id === r._id || user.rankId === r._id) ? 'selected' : '';
          selectOptions += `<option value="${escapeHtml(r._id)}" ${isSelected}>${escapeHtml(r.name)}</option>`;
        });

        tr.innerHTML = `
          <td style="font-weight: 600;">${escapeHtml(user.username || 'Kullanıcı')}</td>
          <td style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);">${user.discordId}</td>
          <td>${rankBadgeMarkup}</td>
          <td>
            <form onsubmit="assignUserRank(event, this)" style="display: flex; gap: 8px; align-items: center; margin: 0;">
              <input type="hidden" name="userId" value="${user._id}">
              <select name="rankId" class="form-input" style="padding: 4px 10px !important; width: 160px; font-size: 12px !important; height: 34px !important; border-radius: 6px !important; background: #0c0d10 !important; color: #fff !important; line-height: normal !important;">
                ${selectOptions}
              </select>
              <button type="submit" class="btn btn-primary" style="padding: 6px 14px; border-radius: 6px; font-size: 11px; font-weight: 700; height: 34px; background: rgba(0, 113, 227, 0.15); color: var(--primary); border: 1px solid rgba(0, 113, 227, 0.3); cursor: pointer;">
                <i class="fa-solid fa-user-check"></i> Ata
              </button>
            </form>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Render pagination controls
    const pagContainer = document.getElementById("assignments-pagination");
    if (pagContainer) {
      if (totalPages <= 1) {
        pagContainer.innerHTML = "";
      } else {
        pagContainer.innerHTML = `
          <button type="button" class="btn" ${currentAssignPage === 1 ? 'disabled' : ''} onclick="changeAssignPage(-1)" style="padding: 6px 12px; font-size: 12px; border-radius: 6px; background: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color); cursor: pointer;">
            <i class="fa-solid fa-chevron-left"></i> Önceki
          </button>
          <span style="font-size: 12px; color: var(--text-muted); font-weight: 600; padding: 0 8px;">Sayfa ${currentAssignPage} / ${totalPages}</span>
          <button type="button" class="btn" ${currentAssignPage === totalPages ? 'disabled' : ''} onclick="changeAssignPage(1)" style="padding: 6px 12px; font-size: 12px; border-radius: 6px; background: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color); cursor: pointer;">
            Sonraki <i class="fa-solid fa-chevron-right"></i>
          </button>
        `;
      }
    }
  }

