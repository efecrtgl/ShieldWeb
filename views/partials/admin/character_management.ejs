<% if (userPermissions.viewUsers) { %>
<section id="character-management-content" class="admin-section-inner">

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
    <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-person-circle-check" style="color: #38bdf8;"></i> Karakter Listesi</h2>
    <div style="display: flex; gap: 10px; align-items: center;">
      <span style="font-size: 11px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 5px 12px; border-radius: 20px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
        <i class="fa-solid fa-circle-check"></i> FiveM Canlı Senkronizasyon Aktif
      </span>
      <button class="btn btn-secondary" onclick="charMgmtRefresh()" style="display: flex; align-items: center; gap: 6px; background: rgba(56,189,248,0.1); color: #38bdf8; border: 1px solid rgba(56,189,248,0.25); font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: 8px; cursor: pointer;">
        <i class="fa-solid fa-arrows-rotate"></i> Yenile
      </button>
    </div>
  </div>

  <div class="content-panel" style="padding: 16px 20px; margin-bottom: 20px; border-radius: 12px; border: 1px solid var(--border-color);">
    <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
      <div style="position: relative; flex: 1; min-width: 220px;">
        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 13px; z-index: 2;"></i>
        <input type="text" id="char-mgmt-search" oninput="charMgmtDebounceSearch()" placeholder="Ad, citizenid veya Discord ID ara..." class="form-input" style="padding-left: 38px !important; width: 100%;">
      </div>
      <select id="char-mgmt-sort" onchange="charMgmtFetch(1)" class="form-input" style="min-width: 170px; width: auto; cursor: pointer;">
        <option value="lastUpdated_desc">Son Guncelleme</option>
        <option value="firstname_asc">Ad A-Z</option>
        <option value="firstname_desc">Ad Z-A</option>
        <option value="money_desc">Nakit Yuksek</option>
        <option value="playtime_desc">Oyun Suresi</option>
      </select>
      <div style="font-size: 13px; color: var(--text-muted); white-space: nowrap;">
        Gosterilen: <strong id="char-mgmt-shown" style="color:#fff;">0</strong> / <strong id="char-mgmt-total" style="color: var(--text-muted);">0</strong>
      </div>
    </div>
  </div>
  <!-- Karakter Düzenleme Modalı -->
  <div id="char-edit-modal" class="modal-overlay" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); align-items: center; justify-content: center; padding: 20px; overflow-y: auto;">
    <div style="background: var(--bg-panel, #12141a); border: 1px solid var(--border-color, rgba(255, 255, 255, 0.12)); border-radius: 16px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85); width: 100%; max-width: 860px; max-height: 90vh; overflow-y: auto; padding: 28px; position: relative; margin: auto; box-sizing: border-box;">
      <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color);">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; background: rgba(0,113,227,0.15); border: 1px solid rgba(0,113,227,0.3); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <i class="fa-solid fa-user-pen" style="color: var(--primary); font-size: 16px;"></i>
          </div>
          <div>
            <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #fff;">Karakter Düzenleme</h3>
            <span id="char-edit-citizenid-badge" style="font-size: 11px; color: var(--primary); background: rgba(0,113,227,0.15); border: 1px solid rgba(0,113,227,0.3); border-radius: 6px; padding: 2px 8px; font-family: monospace; display: inline-block; margin-top: 2px;"></span>
          </div>
        </div>
        <button type="button" onclick="closeCharEditModal()" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-muted); width: 32px; height: 32px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="char-edit-form" onsubmit="submitCharEdit(event)">
        <input type="hidden" id="char-edit-citizenid-val">
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          <!-- Kişisel Bilgiler -->
          <div style="background: rgba(255,255,255,0.015); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px;">
            <h4 style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 14px 0; display: flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-id-card" style="color: var(--primary);"></i> Kişisel Bilgiler
            </h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">Ad</label>
                <input type="text" id="char-edit-firstname" class="form-input" placeholder="Ad" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditName) ? 'disabled' : '' %> style="height: 38px; border-radius: 8px; font-size: 13px; width: 100%;">
              </div>
              <div>
                <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">Soyad</label>
                <input type="text" id="char-edit-lastname" class="form-input" placeholder="Soyad" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditName) ? 'disabled' : '' %> style="height: 38px; border-radius: 8px; font-size: 13px; width: 100%;">
              </div>
              <div style="grid-column: 1/-1;">
                <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">Doğum Tarihi</label>
                <input type="text" id="char-edit-birthdate" class="form-input" placeholder="Örn: 1990-09-09" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditBirthdate) ? 'disabled' : '' %> style="height: 38px; border-radius: 8px; font-size: 13px; width: 100%;">
              </div>
            </div>
          </div>

          <!-- Para ve Meslek -->
          <div style="background: rgba(255,255,255,0.015); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 16px;">
            <div>
              <h4 style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 12px 0; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-dollar-sign" style="color: #10b981;"></i> Para Bilgileri
              </h4>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div>
                  <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">Nakit ($)</label>
                  <input type="number" id="char-edit-cash" class="form-input" placeholder="0" min="0" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditMoney) ? 'disabled' : '' %> style="height: 38px; border-radius: 8px; font-size: 13px; width: 100%;">
                </div>
                <div>
                  <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px;">Banka ($)</label>
                  <input type="number" id="char-edit-bank" class="form-input" placeholder="0" min="0" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditMoney) ? 'disabled' : '' %> style="height: 38px; border-radius: 8px; font-size: 13px; width: 100%;">
                </div>
              </div>
            </div>

            <div>
              <h4 style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 12px 0; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-briefcase" style="color: #f59e0b;"></i> Meslek Bilgileri
              </h4>
              <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
                <div>
                  <label style="display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 6px;">Kodu</label>
                  <input type="text" id="char-edit-job-name" class="form-input" placeholder="police" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditJob) ? 'disabled' : '' %> style="height: 36px; border-radius: 8px; font-size: 12px; width: 100%;">
                </div>
                <div>
                  <label style="display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 6px;">Adı</label>
                  <input type="text" id="char-edit-job-label" class="form-input" placeholder="Polis" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditJob) ? 'disabled' : '' %> style="height: 36px; border-radius: 8px; font-size: 12px; width: 100%;">
                </div>
                <div>
                  <label style="display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 6px;">Rütbe</label>
                  <input type="text" id="char-edit-job-grade" class="form-input" placeholder="Officer" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charEditJob) ? 'disabled' : '' %> style="height: 36px; border-radius: 8px; font-size: 12px; width: 100%;">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Envanter ve Oyun Süresi -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 20px;">
          <div style="background: rgba(255,255,255,0.015); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h4 style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 0; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-box" style="color: #8b5cf6;"></i> Karakter Envanteri
              </h4>
              <div style="display: flex; gap: 8px; align-items: center;">
                <button type="button" onclick="refreshCharInventory(this)" id="btn-refresh-char-inventory" style="font-size: 11px; padding: 4px 10px; color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); background: rgba(59,130,246,0.1); cursor: pointer; border-radius: 6px; display: flex; align-items: center; gap: 4px; font-weight: 600;">
                  <i class="fa-solid fa-rotate-right"></i> Yenile
                </button>
                <button type="button" onclick="clearCharInventory()" class="btn-secondary" <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charClearInventory) ? 'disabled' : '' %> style="font-size: 11px; padding: 4px 10px; color: #ef4444; border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.1); cursor: <%= (!userPermissions.isSuperuser && !userPermissions.isProjectLeader && !userPermissions.charClearInventory) ? 'not-allowed; opacity:0.4' : 'pointer' %>; border-radius: 6px; display: flex; align-items: center; gap: 4px;">
                  <i class="fa-solid fa-lock" style="color: #ef4444;"></i> <i class="fa-solid fa-trash-can"></i> Envanteri Sıfırla (SQL Kilitli)
                </button>
              </div>
            </div>
            <div id="char-edit-inventory" style="max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; font-size: 12px;"></div>
          </div>

          <div style="background: rgba(255,255,255,0.015); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; justify-content: center;">
            <h4 style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 12px 0; display: flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-clock" style="color: #06b6d4;"></i> Toplam Oyun Süresi
            </h4>
            <div style="background: rgba(6,182,212,0.08); border: 1px solid rgba(6,182,212,0.2); border-radius: 8px; padding: 14px; text-align: center;">
              <span id="char-edit-playtime" style="font-size: 15px; color: #06b6d4; font-weight: 700;"></span>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border-color);">
          <button type="button" onclick="closeCharEditModal()" style="background: rgba(255,255,255,0.04); color: var(--text-muted); border: 1px solid var(--border-color); padding: 10px 20px; border-radius: 8px; font-size: 13px; cursor: pointer;">İptal</button>
          <button type="submit" id="char-edit-submit-btn" style="background: var(--primary); color: #fff; border: none; padding: 10px 24px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-lock" style="color: #fbbf24;"></i> <i class="fa-solid fa-floppy-disk"></i> Değişiklikleri Kaydet (SQL Kilitli)
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="content-panel" style="padding: 24px; overflow-x: auto;">
    <table class="admin-table" id="char-mgmt-table">
      <thead>
        <tr>
          <th>Karakter</th>
          <th>Citizen ID</th>
          <th>Discord ID</th>
          <th>Meslek</th>
          <th>Nakit / Banka</th>
          <th>Oyun Suresi</th>
          <th>Durum</th>
          <th>Islemler</th>
        </tr>
      </thead>
      <tbody id="char-mgmt-tbody">
        <tr>
          <td colspan="8" style="text-align:center; color:var(--text-muted); padding:32px 0;">
            <i class="fa-solid fa-spinner fa-spin" style="font-size:18px; color:var(--primary); margin-bottom:8px;"></i><br>Karakterler Yukleniyor...
          </td>
        </tr>
      </tbody>
    </table>
    <div id="char-mgmt-pagination" style="display:flex; justify-content:center; align-items:center; gap:6px; margin-top:20px; padding-top:16px; border-top:1px solid var(--border-color);"></div>
  </div>

</section>

<div id="char-delete-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.75); backdrop-filter:blur(8px); align-items:center; justify-content:center; padding:20px;">
  <div style="background:var(--panel-bg); border:1px solid rgba(239,68,68,0.3); border-radius:16px; width:100%; max-width:440px; box-shadow:0 24px 64px rgba(0,0,0,0.8);">
    <div style="padding:24px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
        <div style="width:44px; height:44px; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); border-radius:12px; display:flex; align-items:center; justify-content:center;">
          <i class="fa-solid fa-trash-can" style="color:var(--danger); font-size:18px;"></i>
        </div>
        <div>
          <h3 style="margin:0; font-size:15px; font-weight:700; color:#fff;">Karakteri Sil <span style="font-size:10px; background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); padding:2px 8px; border-radius:6px; margin-left:6px; font-weight:700;"><i class="fa-solid fa-lock"></i> SQL Kilitli</span></h3>
          <p style="margin:4px 0 0; font-size:12px; color:var(--text-muted);">Bu işlem geri alınamaz.</p>
        </div>
      </div>
      <div style="background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.15); border-radius:8px; padding:12px 16px; margin-bottom:20px;">
        <p style="margin:0; font-size:13px; color:#fff; line-height:1.6;">
          <strong id="char-delete-name-display" style="color:var(--danger);"></strong> isimli karakter sistemden silinecektir. Bu işlem geri alınamaz.
        </p>
      </div>
      <div style="display:flex; gap:10px; justify-content:flex-end;">
        <button onclick="closeCharDeleteModal()" style="background:rgba(255,255,255,0.04); color:var(--text-muted); border:1px solid var(--border-color); padding:10px 20px; border-radius:8px; font-size:13px; cursor:pointer;">İptal</button>
        <button id="char-delete-confirm-btn" onclick="confirmCharDelete()" style="background:var(--danger); color:#fff; border:none; padding:10px 24px; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:8px;">
          <i class="fa-solid fa-trash-can"></i> Evet, Sil
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let charMgmtCurrentPage = 1;
  let charMgmtTotalPages = 1;
  let charMgmtSearchTimeout = null;
  let charMgmtDeleteCitizenId = null;
  let charMgmtDeleteCharId = null;
  const charMgmtCanEdit = <%= userPermissions.isSuperuser || userPermissions.isProjectLeader || userPermissions.editUsers || userPermissions.charEditModal || false %>;
  const charMgmtCanDelete = <%= userPermissions.isSuperuser || userPermissions.isProjectLeader || userPermissions.deleteUsers || false %>;
  const charMgmtCanClearInv = <%= userPermissions.isSuperuser || userPermissions.isProjectLeader || userPermissions.charClearInventory || false %>;
  const charMgmtCanDeleteItem = <%= userPermissions.isSuperuser || userPermissions.isProjectLeader || userPermissions.charDeleteItem || false %>;

  let charMgmtAutoRefreshTimer = null;

  document.addEventListener('DOMContentLoaded', function() {
    var hash = window.location.hash;
    if (hash === '#character-management') {
      setTimeout(function() { charMgmtFetch(1); }, 100);
    }
    var section = document.getElementById('character-management');
    if (section) {
      var observer = new MutationObserver(function() {
        if (section.classList.contains('active')) {
          charMgmtFetch(1);
        }
      });
      observer.observe(section, { attributes: true, attributeFilter: ['class', 'style'] });
    }

    if (!charMgmtAutoRefreshTimer) {
      charMgmtAutoRefreshTimer = setInterval(function() {
        var sec = document.getElementById('character-management');
        var editModal = document.getElementById('char-edit-modal');
        var delModal = document.getElementById('char-delete-modal');
        var searchInput = document.getElementById('char-mgmt-search');
        
        if (sec && sec.classList.contains('active') && 
            (!editModal || editModal.style.display === 'none') && 
            (!delModal || delModal.style.display === 'none') && 
            document.activeElement !== searchInput) {
          charMgmtFetch(charMgmtCurrentPage, true);
        }
      }, 10000);
    }
  });

  window.charMgmtRefresh = function() {
    charMgmtFetch(charMgmtCurrentPage);
  };

  window.charMgmtDebounceSearch = function() {
    clearTimeout(charMgmtSearchTimeout);
    charMgmtSearchTimeout = setTimeout(function() { charMgmtFetch(1); }, 400);
  };

  window.charMgmtFetch = async function(page, isSilent) {
    if (page === undefined) page = 1;
    charMgmtCurrentPage = page;
    var tbody = document.getElementById('char-mgmt-tbody');
    if (!tbody) return;
    var search = (document.getElementById('char-mgmt-search') || {}).value || '';
    var sort = (document.getElementById('char-mgmt-sort') || {}).value || 'lastUpdated_desc';
    search = search.trim();

    if (!isSilent) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:32px 0;"><i class="fa-solid fa-spinner fa-spin" style="font-size:18px;color:var(--primary);margin-bottom:8px;"></i><br>Yukleniyor...</td></tr>';
    }

    try {
      var res = await fetch('/admin/api/characters?page=' + page + '&limit=20&search=' + encodeURIComponent(search) + '&sort=' + encodeURIComponent(sort));
      var data = await res.json();

      var shownEl = document.getElementById('char-mgmt-shown');
      var totalEl = document.getElementById('char-mgmt-total');

      if (!data.success) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--danger);padding:20px;">' + (data.message || 'Yukleme basarisiz.') + '</td></tr>';
        return;
      }

      charMgmtTotalPages = data.totalPages || 1;
      if (shownEl) shownEl.textContent = data.characters.length;
      if (totalEl) totalEl.textContent = data.total;

      if (data.characters.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:20px;">Karakter bulunamadi.</td></tr>';
        charMgmtRenderPagination(0);
        return;
      }

      tbody.innerHTML = '';
      data.characters.forEach(function(char) {
        var fullName = ((char.firstname || '') + ' ' + (char.lastname || '')).trim() || 'Isimsiz';
        var cash = (char.money && char.money.cash ? char.money.cash : 0).toLocaleString('tr-TR');
        var bank = (char.money && char.money.bank ? char.money.bank : 0).toLocaleString('tr-TR');
        var jobLabel = (char.job && char.job.label) ? char.job.label : ((char.job && char.job.name) ? char.job.name : 'Civilian');
        var jobGrade = (char.job && char.job.grade) ? char.job.grade : '';
        var pt = char.playtime || 0;
        var playtimeH = pt ? (Math.floor(pt / 60) + 's ' + (pt % 60) + 'dk') : '--';
        var isOnline = char.isOnline;
        var onlineBadge = isOnline
          ? '<span class="status-badge online" style="font-size:11px;">&#9679; Online</span>'
          : '<span class="status-badge offline" style="font-size:11px;">&#9675; Offline</span>';
        var discordDisplay = char.discordId ? char.discordId.replace('discord:', '') : '--';
        var safeId = char.citizenid ? char.citizenid.replace(/'/g, "\\'") : '';
        var safeName = fullName.replace(/'/g, "\\'");
        var safeMongoId = char._id ? char._id.toString().replace(/'/g, "\\'") : '';

        var editBtn = charMgmtCanEdit
          ? '<button onclick="openCharEditModal(\'' + safeId + '\')" style="background:rgba(0,113,227,0.1);color:var(--primary);border:1px solid rgba(0,113,227,0.2);padding:5px 10px;border-radius:7px;font-size:11px;cursor:pointer;display:inline-flex;align-items:center;gap:4px;" title="Karakteri Düzenle"><i class="fa-solid fa-pen-to-square"></i> Düzenle</button>'
          : '<button disabled style="background:rgba(255,255,255,0.02);color:var(--text-muted);border:1px solid var(--border-color);padding:5px 10px;border-radius:7px;font-size:11px;cursor:not-allowed;opacity:0.5;display:inline-flex;align-items:center;gap:4px;"><i class="fa-solid fa-lock"></i> Düzenle</button>';

        var deleteBtn = charMgmtCanDelete
          ? '<button onclick="openCharDeleteModal(\'' + safeId + '\',\'' + safeMongoId + '\',\'' + safeName + '\')" style="background:rgba(239,68,68,0.1);color:var(--danger);border:1px solid rgba(239,68,68,0.2);padding:5px 10px;border-radius:7px;font-size:11px;cursor:pointer;display:inline-flex;align-items:center;gap:4px;" title="Karakteri Sil"><i class="fa-solid fa-trash-can"></i> Sil</button>'
          : '<button disabled style="background:rgba(255,255,255,0.02);color:var(--text-muted);border:1px solid var(--border-color);padding:5px 10px;border-radius:7px;font-size:11px;cursor:not-allowed;opacity:0.5;display:inline-flex;align-items:center;gap:4px;"><i class="fa-solid fa-lock"></i> Sil</button>';

        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' +
            '<div style="display:flex;align-items:center;gap:10px;">' +
              '<div style="width:36px;height:36px;background:linear-gradient(135deg,rgba(0,113,227,0.15),rgba(139,92,246,0.15));border:1px solid rgba(255,255,255,0.08);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
                '<i class="fa-solid fa-user" style="color:var(--primary);font-size:14px;"></i>' +
              '</div>' +
              '<div>' +
                '<div style="font-size:13px;font-weight:600;color:#fff;">' + fullName + '</div>' +
                '<div style="font-size:11px;color:var(--text-muted);">CID: ' + (char.cid || 1) + '</div>' +
              '</div>' +
            '</div>' +
          '</td>' +
          '<td><code style="font-size:11px;color:#a5b4fc;background:rgba(165,180,252,0.08);padding:2px 7px;border-radius:5px;">' + (char.citizenid || '--') + '</code></td>' +
          '<td><span style="font-size:11px;color:var(--text-muted);font-family:monospace;">' + discordDisplay + '</span></td>' +
          '<td><div style="font-size:12px;font-weight:600;color:#fff;">' + jobLabel + '</div>' + (jobGrade ? '<div style="font-size:11px;color:var(--text-muted);">' + jobGrade + '</div>' : '') + '</td>' +
          '<td><div style="font-size:12px;color:#10b981;font-weight:600;">$' + cash + '</div><div style="font-size:11px;color:var(--text-muted);">Banka: $' + bank + '</div></td>' +
          '<td><span style="font-size:12px;color:#06b6d4;">' + playtimeH + '</span></td>' +
          '<td>' + onlineBadge + '</td>' +
          '<td><div style="display:flex;gap:6px;flex-wrap:wrap;">' + editBtn + deleteBtn + '</div></td>';
        tbody.appendChild(tr);
      });

      charMgmtRenderPagination(charMgmtTotalPages);
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--danger);padding:20px;">Hata: ' + err.message + '</td></tr>';
    }
  };

  function charMgmtRenderPagination(total) {
    var container = document.getElementById('char-mgmt-pagination');
    if (!container) return;
    if (total <= 1) { container.innerHTML = ''; return; }
    var html = '';
    var prev = charMgmtCurrentPage > 1;
    var next = charMgmtCurrentPage < total;
    html += '<button onclick="charMgmtFetch(' + (charMgmtCurrentPage - 1) + ')" ' + (prev ? '' : 'disabled') + ' style="padding:6px 12px;border-radius:7px;border:1px solid var(--border-color);background:' + (prev ? 'rgba(0,113,227,0.1)' : 'rgba(255,255,255,0.02)') + ';color:' + (prev ? 'var(--primary)' : 'var(--text-muted)') + ';font-size:12px;cursor:' + (prev ? 'pointer' : 'not-allowed') + ';"><i class="fa-solid fa-chevron-left"></i></button>';
    var start = Math.max(1, charMgmtCurrentPage - 2);
    var end = Math.min(total, charMgmtCurrentPage + 2);
    for (var i = start; i <= end; i++) {
      var isAct = i === charMgmtCurrentPage;
      html += '<button onclick="charMgmtFetch(' + i + ')" style="padding:6px 12px;border-radius:7px;border:1px solid ' + (isAct ? 'var(--primary)' : 'var(--border-color)') + ';background:' + (isAct ? 'var(--primary)' : 'rgba(255,255,255,0.02)') + ';color:' + (isAct ? '#fff' : 'var(--text-muted)') + ';font-size:12px;font-weight:' + (isAct ? '700' : '400') + ';cursor:pointer;">' + i + '</button>';
    }
    html += '<button onclick="charMgmtFetch(' + (charMgmtCurrentPage + 1) + ')" ' + (next ? '' : 'disabled') + ' style="padding:6px 12px;border-radius:7px;border:1px solid var(--border-color);background:' + (next ? 'rgba(0,113,227,0.1)' : 'rgba(255,255,255,0.02)') + ';color:' + (next ? 'var(--primary)' : 'var(--text-muted)') + ';font-size:12px;cursor:' + (next ? 'pointer' : 'not-allowed') + ';"><i class="fa-solid fa-chevron-right"></i></button>';
    container.innerHTML = html;
  }

  window.openCharEditModal = async function(citizenid) {
    var modal = document.getElementById('char-edit-modal');
    if (!modal) return;
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    document.body.style.overflow = 'hidden';
    modal.style.display = 'flex';

    document.getElementById('char-edit-citizenid-val').value = citizenid;
    document.getElementById('char-edit-citizenid-badge').textContent = citizenid;
    var fields = ['char-edit-firstname','char-edit-lastname','char-edit-birthdate','char-edit-cash','char-edit-bank','char-edit-job-name','char-edit-job-label','char-edit-job-grade'];
    fields.forEach(function(id) { var el = document.getElementById(id); if (el) el.value = ''; });
    document.getElementById('char-edit-inventory').innerHTML = '<span style="color:var(--text-muted);">Yukleniyor...</span>';
    document.getElementById('char-edit-playtime').textContent = '--';
    try {
      var res = await fetch('/admin/api/characters/' + encodeURIComponent(citizenid));
      var data = await res.json();
      if (!data.success || !data.character) {
        if (typeof showToast === 'function') showToast('Karakter bilgileri alinamadi.', 'error');
        closeCharEditModal(); return;
      }
      var c = data.character;
      document.getElementById('char-edit-firstname').value = c.firstname || '';
      document.getElementById('char-edit-lastname').value = c.lastname || '';
      document.getElementById('char-edit-birthdate').value = c.birthdate || '';
      document.getElementById('char-edit-cash').value = (c.money && c.money.cash !== undefined) ? c.money.cash : 0;
      document.getElementById('char-edit-bank').value = (c.money && c.money.bank !== undefined) ? c.money.bank : 0;
      document.getElementById('char-edit-job-name').value = (c.job && c.job.name) ? c.job.name : '';
      document.getElementById('char-edit-job-label').value = (c.job && c.job.label) ? c.job.label : '';
      document.getElementById('char-edit-job-grade').value = (c.job && c.job.grade) ? c.job.grade : '';
      var pt = c.playtime || 0;
      document.getElementById('char-edit-playtime').textContent = Math.floor(pt / 60) + ' saat ' + (pt % 60) + ' dakika';
      renderCharInventoryList(c.inventory || [], c.citizenid);
    } catch (err) {
      if (typeof showToast === 'function') showToast('Hata: ' + err.message, 'error');
      closeCharEditModal();
    }
  };

  window.renderCharInventoryList = function(inv, citizenid) {
    var invEl = document.getElementById('char-edit-inventory');
    if (!invEl) return;
    if (inv && inv.length > 0) {
      invEl.innerHTML = inv.map(function(item) {
        if (!item || (!item.name && !item.label)) return '';
        var name = item.name || item.item || '';
        var label = item.label || name;
        var count = item.count !== undefined ? item.count : (item.amount || 1);
        var slot = item.slot !== undefined ? item.slot : '';

        var imgFile = (item.image && item.image !== '.png') ? item.image : ((item.icon && item.icon !== '.png') ? item.icon : (name ? name + '.png' : 'default.png'));
        if (imgFile.startsWith('.png')) imgFile = (name || 'default') + '.png';
        var imgUrl = 'https://raw.githubusercontent.com/overextended/ox_inventory/main/web/images/' + encodeURIComponent(imgFile);

        var slotDisplay = slot !== '' ? '<span style="font-size:10px; color:var(--text-muted); margin-left:4px;">(Slot ' + slot + ')</span>' : '';
        var safeLabel = label.replace(/'/g, "\\'");
        var safeName = name.replace(/'/g, "\\'");

        return '<div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.04); padding:6px 0;">' +
          '<div style="display:flex; align-items:center; gap:8px;">' +
            '<img src="' + imgUrl + '" onerror="this.onerror=null; this.src=\'https://cdn-icons-png.flaticon.com/512/679/679821.png\';" style="width:28px; height:28px; object-fit:contain; background:rgba(0,0,0,0.3); border-radius:6px; padding:2px; border:1px solid rgba(255,255,255,0.08);" />' +
            '<div>' +
              '<span style="color:#fff; font-weight:600; font-size:12px;">' + label + '</span>' + slotDisplay +
              '<div style="font-size:10px; color:var(--text-muted); font-family:monospace;">' + name + '</div>' +
            '</div>' +
          '</div>' +
          '<div style="display:flex; align-items:center; gap:8px;">' +
            '<span style="color:#60a5fa; font-family:monospace; background:rgba(59,130,246,0.15); padding:2px 6px; border-radius:4px; font-weight:700; font-size:11px;">x' + count + '</span>' +
            (charMgmtCanDeleteItem
              ? '<button type="button" onclick="deleteCharInventoryItem(\'' + citizenid + '\', \'' + safeName + '\', ' + (slot !== '' ? slot : 'null') + ', \'' + safeLabel + '\')" title="Eşyayı Sil" style="background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.3); color:#f87171; border-radius:6px; width:26px; height:26px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:11px;"><i class="fa-solid fa-trash"></i></button>'
              : '<button type="button" disabled title="Eşya Silme Yetkiniz Yok" style="background:rgba(255,255,255,0.02); border:1px solid var(--border-color); color:var(--text-muted); border-radius:6px; width:26px; height:26px; display:flex; align-items:center; justify-content:center; cursor:not-allowed; opacity:0.4; font-size:11px;"><i class="fa-solid fa-lock"></i></button>'
            ) +
          '</div>' +
        '</div>';
      }).join('');
    } else {
      invEl.innerHTML = '<span style="color:var(--text-muted);font-size:12px;">Envanter boş.</span>';
    }
  };

  window.refreshCharInventory = async function(btn) {
    var citizenid = document.getElementById('char-edit-citizenid-val').value;
    if (!citizenid) return;
    
    var origHtml = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-rotate-right fa-spin"></i> Yenileniyor...';
    }

    try {
      var res = await fetch('/admin/api/characters/' + encodeURIComponent(citizenid) + '/sync-inventory', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      var data = await res.json();
      if (data.success && data.inventory) {
        renderCharInventoryList(data.inventory, citizenid);
        if (typeof showToast === 'function') {
          showToast('Envanter FiveM sunucusundan anlık olarak çekildi ve güncellendi.', 'success');
        }
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Envanter yenilenemedi.', 'error');
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Hata: ' + err.message, 'error');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    }
  };

  window.deleteCharInventoryItem = async function(citizenid, itemName, slot, itemLabel) {
    if (!confirm('"' + itemLabel + '" isimli eşyayı karakterin envanterinden silmek istediğinize emin misiniz?')) return;
    try {
      var res = await fetch('/admin/api/characters/' + encodeURIComponent(citizenid) + '/delete-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ itemName: itemName, slot: slot })
      });
      var data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message || 'Eşya silindi.', 'success');
        renderCharInventoryList(data.inventory || [], citizenid);
        if (typeof refreshActivePlayerDetails === 'function') {
          refreshActivePlayerDetails();
          setTimeout(refreshActivePlayerDetails, 1200);
        }
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Eşya silinemedi.', 'error');
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Hata: ' + err.message, 'error');
    }
  };

  window.clearCharInventory = async function() {
    var citizenid = document.getElementById('char-edit-citizenid-val').value;
    if (!citizenid) return;
    if (!confirm('Karakterin TÜM envanterini sıfırlamak istediğinize emin misiniz? Bu işlem geri alınamaz!')) return;
    try {
      var res = await fetch('/admin/api/characters/' + encodeURIComponent(citizenid) + '/clear-inventory', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      var data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message || 'Tüm envanter sıfırlandı.', 'success');
        renderCharInventoryList([], citizenid);
        if (typeof refreshActivePlayerDetails === 'function') {
          refreshActivePlayerDetails();
          setTimeout(refreshActivePlayerDetails, 1200);
        }
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Envanter sıfırlanamadı.', 'error');
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Hata: ' + err.message, 'error');
    }
  };

  window.closeCharEditModal = function() {
    var modal = document.getElementById('char-edit-modal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
  };

  window.submitCharEdit = async function(e) {
    e.preventDefault();
    var citizenid = document.getElementById('char-edit-citizenid-val').value;
    var btn = document.getElementById('char-edit-submit-btn');
    if (!citizenid) return;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Kaydediliyor...';
    var payload = {
      firstname: document.getElementById('char-edit-firstname').value.trim(),
      lastname: document.getElementById('char-edit-lastname').value.trim(),
      birthdate: document.getElementById('char-edit-birthdate').value.trim(),
      cash: parseFloat(document.getElementById('char-edit-cash').value) || 0,
      bank: parseFloat(document.getElementById('char-edit-bank').value) || 0,
      jobName: document.getElementById('char-edit-job-name').value.trim(),
      jobLabel: document.getElementById('char-edit-job-label').value.trim(),
      jobGrade: document.getElementById('char-edit-job-grade').value.trim()
    };
    try {
      var res = await fetch('/admin/api/characters/' + encodeURIComponent(citizenid) + '/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      var data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message || 'Karakter guncellendi.', 'success');
        if (typeof charMgmtFetch === 'function') charMgmtFetch(typeof charMgmtCurrentPage !== 'undefined' ? charMgmtCurrentPage : 1);
        if (typeof refreshActivePlayerDetails === 'function') refreshActivePlayerDetails();
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Guncelleme basarisiz.', 'error');
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Hata: ' + err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Kaydet';
    }
  };

  window.openCharDeleteModal = function(citizenid, name, charId) {
    charMgmtDeleteCitizenId = citizenid;
    charMgmtDeleteCharId = charId || null;
    var modal = document.getElementById('char-delete-modal');
    if (!modal) return;
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    document.body.style.overflow = 'hidden';
    var nameEl = document.getElementById('char-delete-name-display');
    if (nameEl) nameEl.textContent = name || citizenid;
    modal.style.display = 'flex';
  };

  window.closeCharDeleteModal = function() {
    var modal = document.getElementById('char-delete-modal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
    charMgmtDeleteCitizenId = null;
    charMgmtDeleteCharId = null;
  };

  window.confirmCharDelete = async function() {
    if (!charMgmtDeleteCitizenId) return;
    var btn = document.getElementById('char-delete-confirm-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Siliniyor...';
    try {
      var res = await fetch('/api/fivem/character/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ citizenid: charMgmtDeleteCitizenId, characterId: charMgmtDeleteCharId })
      });
      var data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message || 'Karakter silindi.', 'success');
        closeCharDeleteModal();
        charMgmtFetch(charMgmtCurrentPage);
      } else {
        if (typeof showToast === 'function') showToast(data.message || 'Silme basarisiz.', 'error');
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Hata: ' + err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-trash-can"></i> Evet, Sil';
    }
  };

  document.addEventListener('click', function(e) {
    var editModal = document.getElementById('char-edit-modal');
    var deleteModal = document.getElementById('char-delete-modal');
    if (e.target === editModal) closeCharEditModal();
    if (e.target === deleteModal) closeCharDeleteModal();
  });
</script>
<% } else { %>
  <div class="locked-overlay">
    <div class="locked-overlay-icon"><i class="fa-solid fa-lock"></i></div>
    <h4>Erişim Kısıtlandı</h4>
    <p>Burayı görüntülemeye yetkiniz yok.</p>
  </div>
<% } %>
