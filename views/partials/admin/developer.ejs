            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Legal Kategori ID</label>
              <input type="text" id="setting-legalCategoryId" class="form-input setting-auto-save" value="<%= stats.legalCategoryId || '' %>" placeholder="Örn: 1521293366883258380" required>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
