<% if (userPermissions.manageDeveloper) { %>
  <section id="developer-settings-content" class="admin-section-inner">
    <div class="main-layout" style="margin-bottom: 30px;">
      <div class="content-panel" style="grid-column: span 12;">
        <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; margin-bottom: 8px; ">
          <i class="fa-solid fa-code text-sky-400"></i> Modül Yönetimi (Geliştirici Ayarları)
        </h3>
        <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 24px; line-height: 1.5;">
          Web sitesindeki belirli özellikleri ve sayfaları dinamik olarak kapatıp açabilir, pasif duruma getirilen modüllerin davranışını (yönlendirme veya yapım aşaması ekranı) yapılandırabilirsiniz. <strong style="color: var(--primary);">Tüm değişiklikler anında kaydedilir.</strong>
        </p>

        <!-- Modules List Card Grid Layout -->
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; margin-bottom: 24px;">
          <% if (locals.siteModules && siteModules.length > 0) { %>
            <% siteModules.forEach(m => { %>
              <div class="content-panel module-card <%= m.isEnabled ? 'active' : '' %>" id="card-<%= m.key %>" style="padding: 20px; display: flex; flex-direction: column; gap: 16px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; transition: all 0.3s ease; position: relative; margin: 0; ">
                
                <!-- Header: Icon, Name, Switch -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
                  <div style="display: flex; gap: 12px; align-items: center;">
                    <div class="module-icon-wrap" style="width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: <%= m.isEnabled ? 'rgba(0, 113, 227, 0.1)' : 'rgba(255,255,255,0.03)' %>; color: <%= m.isEnabled ? 'var(--primary)' : 'var(--text-muted)' %>; border: 1px solid <%= m.isEnabled ? 'rgba(0, 113, 227, 0.2)' : 'var(--border-color)' %>; font-size: 16px; transition: all 0.3s ease;">
                      <% if (m.key === 'applications') { %>
                        <i class="fa-solid fa-file-signature"></i>
                      <% } else if (m.key === 'donate') { %>
                        <i class="fa-solid fa-coins"></i>
                      <% } else if (m.key === 'gallery') { %>
                        <i class="fa-solid fa-images"></i>
                      <% } else if (m.key === 'stats') { %>
                        <i class="fa-solid fa-chart-simple"></i>
                      <% } else if (m.key === 'team') { %>
                        <i class="fa-solid fa-users"></i>
                      <% } else if (m.key === 'faq') { %>
                        <i class="fa-solid fa-circle-question"></i>
                      <% } else if (m.key === 'rules') { %>
                        <i class="fa-solid fa-gavel"></i>
                      <% } else if (m.key === 'penalties') { %>
                        <i class="fa-solid fa-scale-balanced"></i>
                      <% } else if (m.key === 'admin_overview') { %>
                        <i class="fa-solid fa-gauge-high"></i>
                      <% } else if (m.key === 'admin_users') { %>
                        <i class="fa-solid fa-user-check"></i>
                      <% } else if (m.key === 'admin_teams') { %>
                        <i class="fa-solid fa-users-gear"></i>
                      <% } else if (m.key === 'admin_punishments') { %>
                        <i class="fa-solid fa-gavel"></i>
                      <% } else if (m.key === 'admin_banned') { %>
                        <i class="fa-solid fa-user-slash"></i>
                      <% } else if (m.key === 'admin_blacklist') { %>
                        <i class="fa-solid fa-user-shield"></i>
                      <% } else if (m.key === 'admin_applications') { %>
                        <i class="fa-solid fa-file-signature"></i>
                      <% } else if (m.key === 'admin_updates') { %>
                        <i class="fa-solid fa-newspaper"></i>
                      <% } else if (m.key === 'admin_donate') { %>
                        <i class="fa-solid fa-coins"></i>
                      <% } else if (m.key === 'admin_ranks') { %>
                        <i class="fa-solid fa-shield-halved"></i>
                      <% } else if (m.key === 'admin_bots') { %>
                        <i class="fa-brands fa-discord"></i>
                      <% } else if (m.key === 'admin_faq') { %>
                        <i class="fa-solid fa-circle-question"></i>
                      <% } else if (m.key === 'admin_gallery') { %>
                        <i class="fa-solid fa-images"></i>
                      <% } else if (m.key === 'admin_theme') { %>
                        <i class="fa-solid fa-palette"></i>
                      <% } else if (m.key === 'admin_logos') { %>
                        <i class="fa-solid fa-compass-drafting"></i>
                      <% } else if (m.key === 'maintenance') { %>
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                      <% } else { %>
                        <i class="fa-solid fa-gear"></i>
                      <% } %>
                    </div>
                    <div>
                      <h4 style="font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 6px;">
                        <%= m.name %>
                        <% if (m.key === 'maintenance') { %>
                          <span style="font-size: 11px; padding: 2px 6px; border-radius: 4px; background: rgba(239, 68, 68, 0.15); color: var(--danger); font-weight: 700;  ">Kritik</span>
                        <% } %>
                      </h4>
                      <span class="module-status-badge" style="font-size: 11px; font-weight: 700; color: <%= m.isEnabled ? 'var(--success)' : 'var(--text-muted)' %>; display: inline-flex; align-items: center; gap: 4px; margin-top: 4px;  ">
                        <span style="width: 5px; height: 5px; border-radius: 50%; background: <%= m.isEnabled ? 'var(--success)' : 'var(--text-muted)' %>;"></span>
                        <%= m.isEnabled ? 'Aktif' : 'Pasif' %>
                      </span>
                    </div>
                  </div>
                  
                  <label class="switch" style="position: relative; display: inline-block; width: 38px; height: 20px; flex-shrink: 0;">
                    <input type="checkbox" class="module-toggle-input" data-key="<%= m.key %>" data-name="<%= m.name %>" <%= m.isEnabled ? 'checked' : '' %> style="opacity: 0; width: 0; height: 0;">
                    <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #2c2d30; transition: .3s; border-radius: 20px;"></span>
                  </label>
                </div>

                <!-- Description -->
                <p style="color: var(--text-muted); font-size: 11px; line-height: 1.4; margin: 0; min-height: 32px;"><%= m.description %></p>

                <!-- Settings Area (Auto-saves on change) -->
                <div style="border-top: 1px solid var(--border-color); padding-top: 14px; display: flex; flex-direction: column; gap: 10px; margin-top: auto;">
                  <% if (m.key === 'maintenance') { %>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                      <label class="form-label" style="font-size: 11px; opacity: 0.7; margin: 0;">Bakım Mesajı</label>
                      <textarea id="msg-<%= m.key %>" class="form-input module-auto-input" data-key="<%= m.key %>" style="min-height: 80px; resize: vertical;" placeholder="Bakım mesajını girin..."><%= m.customMessage || "Sizlere daha iyi bir deneyim sunabilmek amacıyla sitemizde güncellemeler ve bakım çalışmaları yapıyoruz. Çok yakında tekrar çevrimiçi olacağız!" %></textarea>
                      <span style="font-size: 11px; color: var(--text-muted);"><i class="fa-solid fa-cloud-arrow-up"></i> Değişiklikler anında kaydedilir.</span>
                    </div>
                  <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label class="form-label" style="font-size: 11px; opacity: 0.7; margin: 0;">Pasif Durum Davranışı</label>
                        <select id="behavior-<%= m.key %>" class="form-input module-auto-select" data-key="<%= m.key %>" style="background: #0c0d10; width: 100%;">
                          <option value="redirect" <%= m.behavior === 'redirect' ? 'selected' : '' %>>Ana Sayfaya Yönlendir</option>
                          <option value="preloader" <%= m.behavior === 'preloader' ? 'selected' : '' %>>Yapım Aşaması (Preloader)</option>
                        </select>
                      </div>
                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label class="form-label" style="font-size: 11px; opacity: 0.7; margin: 0;">Yapım Aşaması Mesajı</label>
                        <input type="text" id="msg-<%= m.key %>" class="form-input module-auto-input" data-key="<%= m.key %>" value="<%= m.customMessage %>" placeholder="Bu bölüm yapım aşamasındadır.">
                      </div>
                      <span style="font-size: 11px; color: var(--text-muted);"><i class="fa-solid fa-cloud-arrow-up"></i> Değişiklikler anında kaydedilir.</span>
                    </div>
                  <% } %>
                </div>

              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align: center; color: var(--text-muted); font-size: 12px; padding: 20px 0;">
              Modül bulunamadı.
            </div>
          <% } %>
        </div>

      </div>
    </div>

    <!-- Discord Role Settings -->
    <div class="main-layout" style="margin-bottom: 30px; margin-top: 30px;">
      <div class="content-panel" style="grid-column: span 12;">
        <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; margin-bottom: 8px; ">
