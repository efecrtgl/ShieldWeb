              <input type="text" id="setting-warning2RoleId" class="form-input setting-auto-save" value="<%= stats.warning2RoleId || '' %>" placeholder="Örn: 1521293367151956009" required>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Uyarı 3 Rol ID</label>
              <input type="text" id="setting-warning3RoleId" class="form-input setting-auto-save" value="<%= stats.warning3RoleId || '' %>" placeholder="Örn: 1521293367151956009" required>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Uyarı 4 Rol ID</label>
              <input type="text" id="setting-warning4RoleId" class="form-input setting-auto-save" value="<%= stats.warning4RoleId || '' %>" placeholder="Örn: 1521293367151956009" required>
