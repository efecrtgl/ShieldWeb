              <label class="form-label">Uyarı 7 Rol ID</label>
              <input type="text" id="setting-warning7RoleId" class="form-input setting-auto-save" value="<%= stats.warning7RoleId || '' %>" placeholder="Örn: 1521293367151956009" required>
            </div>
