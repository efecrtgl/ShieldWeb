  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Switch Toggles Auto-save
      document.querySelectorAll(".module-toggle-input").forEach(input => {
        input.addEventListener("change", async (e) => {
          const key = input.getAttribute("data-key");
          const name = input.getAttribute("data-name");
          const isEnabled = input.checked;
          const card = document.getElementById(`card-${key}`);
          
          input.disabled = true;
          
          try {
            const response = await fetch("/admin/developer/modules/toggle", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({ key, isEnabled })
            });
            
            const data = await response.json();
            
            if (data.success) {
              showAdminToast(`${name} başarıyla ${isEnabled ? 'aktif edildi' : 'devre dışı bırakıldı'}.`, 'success');
              if (card) {
                if (isEnabled) card.classList.add("active");
                else card.classList.remove("active");
                
                // Update badge and icon colors
                const badge = card.querySelector(".module-status-badge");
                if (badge) {
                  badge.style.color = isEnabled ? "var(--success)" : "var(--text-muted)";
                  badge.innerHTML = `<span style="width: 5px; height: 5px; border-radius: 50%; background: ${isEnabled ? 'var(--success)' : 'var(--text-muted)'};"></span>${isEnabled ? 'Aktif' : 'Pasif'}`;
                }
                const iconWrap = card.querySelector(".module-icon-wrap");
                if (iconWrap) {
                  iconWrap.style.background = isEnabled ? "rgba(0, 113, 227, 0.1)" : "rgba(255,255,255,0.03)";
                  iconWrap.style.color = isEnabled ? "var(--primary)" : "var(--text-muted)";
                  iconWrap.style.borderColor = isEnabled ? "rgba(0, 113, 227, 0.2)" : "var(--border-color)";
                }
              }
            } else {
              showAdminToast(data.message || "Bir hata oluştu.", 'error');
              input.checked = !isEnabled;
            }
          } catch (error) {
            showAdminToast("Bağlantı hatası oluştu.", 'error');
            input.checked = !isEnabled;
          } finally {
            input.disabled = false;
          }
        });
      });

      // Debounce Yardımcı Fonksiyonu
      function debounce(func, delay) {
        let timeout;
        return function (...args) {
          clearTimeout(timeout);
          timeout = setTimeout(() => func.apply(this, args), delay);
        };
      }

      const debouncedSaveModuleSettings = debounce((key) => {
        saveModuleSettings(key);
      }, 500);

      // 2. Module Settings Auto-save
      // Select elementleri için anında kaydet
      document.querySelectorAll(".module-auto-select").forEach(el => {
        el.addEventListener("change", () => {
          const key = el.getAttribute("data-key");
          saveModuleSettings(key);
        });
      });

      // Yazı alanları (input/textarea) için hem yazarken (input) hem de odak kaybolduğunda (change) kaydet
      document.querySelectorAll(".module-auto-input").forEach(el => {
        el.addEventListener("input", () => {
          const key = el.getAttribute("data-key");
          debouncedSaveModuleSettings(key);
        });
        
        el.addEventListener("change", () => {
          const key = el.getAttribute("data-key");
          saveModuleSettings(key);
        });
      });

      // 3. Discord Roles Auto-save (triggers on any change/blur in settings inputs)
      document.querySelectorAll(".setting-auto-save").forEach(input => {
        input.addEventListener("change", () => {
          saveDiscordRoles();
        });
      });
    });

    async function saveModuleSettings(key) {
      const behaviorSelect = document.getElementById(`behavior-${key}`);
      const msgInput = document.getElementById(`msg-${key}`);
      
      const behavior = behaviorSelect ? behaviorSelect.value : 'redirect';
      const customMessage = msgInput ? msgInput.value : '';
      
      try {
        const response = await fetch("/admin/developer/modules/update-settings", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ key, behavior, customMessage })
        });
        
        const data = await response.json();
        if (data.success) {
          showAdminToast("Ayarlar otomatik olarak kaydedildi.", 'success');
        } else {
          showAdminToast(data.message || "Ayarlar kaydedilirken hata oluştu.", 'error');
        }
      } catch (error) {
        console.error(error);
      }
    }

    async function saveDiscordRoles() {
      const guildId = document.getElementById("setting-guildId").value;
      const loggerGuildId = document.getElementById("setting-loggerGuildId").value;
      const whitelistRoleId = document.getElementById("setting-whitelistRoleId").value;
      const unregisteredRoleId = document.getElementById("setting-unregisteredRoleId").value;
      const staffRoleId = document.getElementById("setting-staffRoleId").value;
      const voiceSupportRoleId = document.getElementById("setting-voiceSupportRoleId").value;
      const illegalCategoryId = document.getElementById("setting-illegalCategoryId").value;
