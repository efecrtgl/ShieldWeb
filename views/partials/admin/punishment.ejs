<% if (userPermissions.managePunishments) { %>
  <style>
    .punish-scroll-container::-webkit-scrollbar {
      width: 6px;
    }
    .punish-scroll-container::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.01);
      border-radius: 4px;
    }
    .punish-scroll-container::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 4px;
      transition: background 0.2s;
    }
    .punish-scroll-container::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.24);
    }

    .punish-checkbox-custom {
      appearance: none;
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      background: #0c0d10;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: all 0.2s ease-in-out;
    }
    .punish-checkbox-custom:checked {
      background: var(--primary);
      border-color: var(--primary);
    }
    .punish-checkbox-custom:checked::after {
      content: "\f00c";
      font-family: "Font Awesome 6 Free";
      font-weight: 600;
      color: #fff;
      font-size: 11px;
    }
    .punish-checkbox-custom:focus {
      outline: none;
      
    }

    .sicil-timeline {
      position: relative;
      padding-left: 24px;
      margin-left: 12px;
      border-left: 2px solid var(--border-color);
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .sicil-timeline-item {
      position: relative;
    }
    .sicil-timeline-badge {
      position: absolute;
      left: -33px;
      top: 2px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--border-color);
      border: 3px solid #14151a;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .sicil-timeline-item.warning .sicil-timeline-badge {
      background: #ffb703;
      
    }
    .sicil-timeline-item.wl .sicil-timeline-badge {
      background: #219ebc;
      
    }
    .sicil-timeline-item.perma .sicil-timeline-badge {
      background: var(--danger);
      
    }
    .sicil-timeline-item.pardon .sicil-timeline-badge {
      background: var(--success);
      
    }
    
    .sicil-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
      transition: all 0.25s ease;
    }
    .sicil-card:hover {
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
    }

    .warning-steps {
      display: flex;
      gap: 6px;
      margin-top: 8px;
    }
    .warning-step {
      flex: 1;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 3px;
      transition: all 0.3s ease;
    }
    .warning-step.active {
      background: #ffb703;
      
    }
  </style>

