  function updateBanDurationUI(val) {
    const customWrap = document.getElementById("ban-modal-custom-duration-wrap");
    const badge = document.getElementById("ban-duration-summary-badge");

    document.querySelectorAll(".duration-preset-btn").forEach(btn => {
      btn.classList.remove("active");
    });

    const durationLabels = {
      "1_hour": "1 Saat",
      "3_hours": "3 Saat",
      "6_hours": "6 Saat",
      "12_hours": "12 Saat",
      "1_day": "1 Gün",
      "3_days": "3 Gün",
      "7_days": "7 Gün",
      "14_days": "14 Gün",
      "30_days": "30 Gün",
      "perma": "⛔ Kalıcı (Perma)",
      "custom": "Özel Süre"
    };

    if (val === "custom") {
      if (customWrap) customWrap.style.display = "flex";
      if (badge) badge.innerText = "Özel Süre";
    } else {
      if (customWrap) customWrap.style.display = "none";
      if (badge) badge.innerText = durationLabels[val] || val;
      document.querySelectorAll(".duration-preset-btn").forEach(btn => {
        const onclickAttr = btn.getAttribute("onclick") || "";
        if (onclickAttr.includes(`'${val}'`)) {
          btn.classList.add("active");
