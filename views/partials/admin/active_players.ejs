          let html = "";
          chars.forEach(c => {
            const cash = c.money && c.money.cash !== null && c.money.cash !== undefined ? c.money.cash : null;
            const bank = c.money && c.money.bank !== null && c.money.bank !== undefined ? c.money.bank : null;
            const jobLabel = c.job && (c.job.label || c.job.name) ? escapeHtml(c.job.label || c.job.name) : '<span class="dash">—</span>';
            const jobGrade = c.job && c.job.grade ? escapeHtml(c.job.grade) : "";

            const safeCharId = (c._id || "").toString();
            const safeCitizenId = c.citizenid || "";
            const safeCharName = `${c.firstname || ''} ${c.lastname || ''}`.trim();

            html += `
              <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 16px; margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 6px;">
                  <div style="font-weight: 700; color: #fff; font-size: 14px;">
                    <i class="fa-solid fa-user" style="color: var(--primary); margin-right: 6px;"></i> ${escapeHtml(c.firstname || '')} ${escapeHtml(c.lastname || '')} 
                    <span style="font-size: 11px; font-weight: 500; color: var(--text-muted); font-family: var(--font-mono);">(CID: ${c.cid !== null && c.cid !== undefined ? escapeHtml(c.cid) : "—"})</span>
                  </div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.2); color: #60a5fa; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; font-family: var(--font-mono);">
                      ${escapeHtml(c.citizenid)}
                    </span>
                    <button onclick="openCharEditModal(${jsArg(safeCitizenId)})"
                      style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); padding: 3px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; cursor: pointer; transition: background 0.2s; white-space: nowrap;">
                      <i class="fa-solid fa-pen-to-square" style="margin-right: 4px;"></i> Düzenle
                    </button>
                    <button onclick="deleteCharacterFromModal(${jsArg(safeCharId)}, ${jsArg(safeCitizenId)}, ${jsArg(safeCharName)})"
                      style="background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.35); padding: 3px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; cursor: pointer; transition: background 0.2s; white-space: nowrap;">
                      <i class="fa-solid fa-trash" style="margin-right: 4px;"></i> Sil
                    </button>
                  </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                  <div>
                    <div style="color: var(--text-muted); font-size: 11px;"><i class="fa-solid fa-briefcase" style="margin-right: 4px;"></i> Meslek</div>
                    <div style="font-weight: 600; color: #fff;">${jobLabel}${jobGrade ? ` · <span style="font-size: 12px; color: var(--text-muted);">${jobGrade}</span>` : ""}</div>
                  </div>
                  <div>
                    <div style="color: var(--text-muted); font-size: 11px;"><i class="fa-solid fa-calendar-days" style="margin-right: 4px;"></i> Doğum Tarihi</div>
                    <div style="font-weight: 600; color: #fff;">${c.birthdate ? escapeHtml(c.birthdate) : "—"}</div>
                  </div>
                  <div style="grid-column: span 2; display: flex; gap: 20px; background: rgba(0,0,0,0.15); padding: 10px; border-radius: 8px; margin-top: 8px;">
                    <div>
                      <span style="color: var(--text-muted); font-size: 11px;"><i class="fa-solid fa-wallet" style="margin-right: 4px; color: #34d399;"></i> Nakit:</span>
                      <strong style="font-variant-numeric: tabular-nums;">${cash === null ? '<span class="dash">—</span>' : "$" + Number(cash).toLocaleString("tr-TR")}</strong>
                    </div>
                    <div>
                      <span style="color: var(--text-muted); font-size: 11px;"><i class="fa-solid fa-building-columns" style="margin-right: 4px; color: #60a5fa;"></i> Banka:</span>
                      <strong style="font-variant-numeric: tabular-nums;">${bank === null ? '<span class="dash">—</span>' : "$" + Number(bank).toLocaleString("tr-TR")}</strong>
                    </div>
                  </div>
                </div>
              </div>
            `;
          });
          charContent.innerHTML = html;
        }
      } else {
        document.getElementById("modal-discord-loading").innerText = "Hata oluştu.";
        document.getElementById("modal-characters-loading").innerText = "Karakter verileri yüklenemedi.";
