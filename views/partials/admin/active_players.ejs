<section id="active-players-mgmt-content" class="admin-section-inner" style="font-family: 'Inter', sans-serif;">
  <div class="section-head">
    <div>
      <h2>Oyundaki oyuncular</h2>
      <p id="active-players-subline">FiveM köprüsünün son bildirdiği oyuncu listesi.</p>
    </div>
    <div class="actions">
      <span class="pill" id="active-players-total-badge">—</span>
    </div>
  </div>
  <div id="active-players-bridge-state"></div>

  <div class="content-panel" style="padding: 24px; overflow-x: auto;">
    <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
      <div style="position: relative; width: 300px;">
        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 13px; z-index: 2;"></i>
        <input type="text" id="search-active-players-input" oninput="filterActivePlayersTable()" placeholder="Oyuncu ID (#12), adı, Discord ID veya karakter ara..." class="form-input" style="padding-left: 38px !important; height: 38px; border-radius: 8px; font-size: 13px; width: 100%;">
      </div>

      <!-- Görünüm Değiştirici (Tablo vs Canlı 2D Harita) -->
      <div style="display: flex; gap: 8px; align-items: center;">
        <button id="btn-view-table" onclick="switchActivePlayersView('table')" class="btn btn-secondary" style="background: rgba(0, 113, 227, 0.2); color: #fff; border: 1px solid rgba(0, 113, 227, 0.4); font-size: 12px; padding: 8px 14px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-list"></i> Liste Görünümü
        </button>
        <button id="btn-view-map" onclick="switchActivePlayersView('map')" class="btn btn-secondary" style="background: rgba(255, 255, 255, 0.04); color: var(--text-muted); border: 1px solid var(--border-color); font-size: 12px; padding: 8px 14px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-map-location-dot"></i> Canlı 2D Harita
        </button>
      </div>
    </div>

    <!-- Tablo Görünümü -->
    <div id="active-players-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Oyuncu Adı (Game Name)</th>
            <th>Discord ID</th>
            <th>Karakter İsimleri</th>
            <th>Ping</th>
            <th style="text-align: right;">Eylemler</th>
          </tr>
        </thead>
        <tbody id="active-players-table-body">
          <tr>
            <td colspan="6" style="text-align: center; color: var(--text-muted); font-size: 12px; padding: 24px 0;">
              <i class="fa-solid fa-spinner fa-spin" style="font-size: 18px; margin-bottom: 8px; color: var(--primary);"></i><br>Aktif oyuncu listesi alınıyor...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Canlı 2D Harita Görünümü (GTA V Map) -->
    <div id="active-players-map-wrapper" style="display: none; margin-top: 12px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); position: relative;">
      <div style="position: absolute; top: 14px; right: 14px; z-index: 1000; background: rgba(9, 10, 13, 0.85);  border: 1px solid rgba(255, 255, 255, 0.12); padding: 10px 16px; border-radius: 10px; display: flex; align-items: center; gap: 10px; ">
        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #34d399; "></span>
        <span style="font-size: 12px; font-weight: 700; color: #fff;">GTA V Canlı Harita & Oyuncu Konumları</span>
      </div>
      <div id="active-players-map" style="width: 100%; height: 620px; background: #0c1626;"></div>
    </div>
  </div>
</section>

<div id="live-screen-modal" onclick="onLiveScreenBackdropClick(event)" style="display: none; position: fixed; inset: 0; background: rgba(5, 7, 12, 0.85);  z-index: 999999; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.25s ease;">
  <div class="modal-content" onclick="event.stopPropagation()" style="background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12); width: 1080px; max-width: 96vw; max-height: 94vh; border-radius: 18px;  overflow: hidden; transform: scale(0.94); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; pointer-events: auto;">
    <div style="padding: 16px 22px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.02); flex-wrap: wrap; gap: 12px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 10px; border-radius: 20px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;  animation: livePulseAnim 1.4s infinite;"></span>
          <span style="font-size: 11px; font-weight: 600; color: #34d399; ">CANLI YAYIN</span>
        </div>
        <div style="font-size: 15px; font-weight: 700; color: #fff;">
          <span id="live-screen-player-name">Oyuncu</span>
          <span id="live-screen-player-id" style="font-size: 12px; color: var(--primary); font-family: var(--font-mono); margin-left: 6px; background: rgba(59, 130, 246, 0.15); padding: 2px 8px; border-radius: 6px; border: 1px solid rgba(59, 130, 246, 0.3);">#0</span>
        </div>
        <span id="live-screen-ping" style="font-size: 11px; font-family: var(--font-mono); color: #34d399; background: rgba(255, 255, 255, 0.04); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.08);">
          <i class="fa-solid fa-bolt" style="margin-right: 3px;"></i>0ms
        </span>
      </div>

      <div style="display: flex; align-items: center; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); padding: 4px 10px; border-radius: 8px; font-size: 11px; color: #94a3b8; font-family: var(--font-mono);">
          <span>FPS: <strong id="live-screen-fps-stat" style="color: #38bdf8;">60.0</strong></span>
          <span style="opacity: 0.3;">|</span>
          <span>Gecikme: <strong id="live-screen-lag-stat" style="color: #34d399;">Ultra Düşük</strong></span>
          <span style="opacity: 0.3;">|</span>
          <span style="color: #a78bfa;"><i class="fa-solid fa-shield" style="font-size: 11px; margin-right: 2px;"></i>Full HD Donmasız</span>
        </div>

        <select id="live-screen-speed-select" onchange="changeLiveScreenSpeed(this.value)" style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; font-size: 11px; padding: 5px 8px; border-radius: 8px; outline: none; cursor: pointer;">
          <option value="16" selected>60 FPS (Maksimum Akıcılık - Full HD)</option>
          <option value="33">30 FPS (Ultra Akıcı - Full HD)</option>
          <option value="66">15 FPS (Akıcı)</option>
          <option value="200">5 FPS (Dengeli)</option>
          <option value="850">1.2 FPS (Ultra Hafif)</option>
        </select>

        <button type="button" onclick="downloadLiveScreenSnapshot()" title="Anlık Ekranı İndir (Fotoğraf)" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); color: #e2e8f0; padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-camera"></i> Fotoğraf
        </button>

        <button type="button" onclick="toggleLiveScreenFullscreen()" title="Tam Ekran" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); color: #e2e8f0; padding: 6px 10px; border-radius: 8px; font-size: 12px; cursor: pointer;">
          <i class="fa-solid fa-expand"></i>
        </button>

        <button id="live-screen-close-btn" type="button" onclick="closeLiveScreenModal(event)" title="Yayını Kapat" style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 6px 12px; border-radius: 8px; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <div id="live-screen-container" style="position: relative; width: 100%; height: 560px; max-height: 65vh; background: #07090e; display: flex; align-items: center; justify-content: center; overflow: hidden;">
      <div id="live-screen-loader" style="position: absolute; inset: 0; background: rgba(7, 9, 14, 0.92); z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;">
        <div style="width: 44px; height: 44px; border: 3px solid rgba(16, 185, 129, 0.2); border-top-color: #10b981; border-radius: 50%; animation: spinAnim 0.8s linear infinite;"></div>
        <div style="font-size: 13px; font-weight: 600; color: #e2e8f0;">Oyuncunun ekranına bağlanılıyor...</div>
        <div style="font-size: 11px; color: #94a3b8; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-gauge-high" style="color: #34d399;"></i> Full HD MJPEG Donanım Yayını • 0 FPS Drop Koruması
        </div>
      </div>

      <img id="live-screen-viewport" src="" alt="Canlı Yayın" style="max-width: 100%; max-height: 100%; object-fit: contain; display: block; border-radius: 4px;  background: #000;" />

      <div style="position: absolute; bottom: 12px; left: 16px; z-index: 5; background: rgba(0,0,0,0.6);  border: 1px solid rgba(255,255,255,0.08); padding: 4px 10px; border-radius: 6px; font-family: var(--font-mono); font-size: 11px; color: #cbd5e1; display: flex; align-items: center; gap: 10px; pointer-events: none;">
        <span>SHIELD SPECTATE</span>
        <span style="opacity: 0.3;">•</span>
        <span id="live-screen-hud-time">--:--:--</span>
        <span style="opacity: 0.3;">•</span>
        <span id="live-screen-hud-resolution">1920x1080 (Full HD)</span>
      </div>
    </div>

    <div style="padding: 12px 22px; background: rgba(0, 0, 0, 0.4); border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-muted); ">
          <i class="fa-solid fa-gamepad" style="margin-right: 4px;"></i> Hızlı Aksiyon:
        </span>
        <button onclick="quickActionScreenRevive()" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <i class="fa-solid fa-heart-pulse"></i> Canlandır
        </button>
        <button onclick="quickActionScreenKill()" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <i class="fa-solid fa-skull"></i> Öldür
        </button>
        <button onclick="quickActionScreenDm()" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <i class="fa-solid fa-message"></i> Mesaj Gönder
        </button>
        <button onclick="openKickModal(currentStreamingPlayerId, document.getElementById('live-screen-player-name')?.innerText)" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <i class="fa-solid fa-user-xmark"></i> Kickle
        </button>
        <button onclick="openBanModal(currentStreamingPlayerId, document.getElementById('live-screen-player-name')?.innerText)" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <i class="fa-solid fa-gavel"></i> Banla
        </button>
      </div>

      <div style="font-size: 11px; color: #64748b; display: flex; align-items: center; gap: 6px;">
        <i class="fa-solid fa-circle-check" style="color: #10b981;"></i>
        <span>Pencere kapandığında oyuncu yayını anında sonlanır ve hiçbir FPS kaybı yaşanmaz.</span>
      </div>
    </div>
  </div>
</div>

<!-- KICK MODAL (Sebep Gerektiren Modal) -->
<div id="active-player-kick-modal" class="modal-backdrop" onclick="onActivePlayerKickBackdropClick(event)"
  style="display: none; position: fixed; inset: 0; background: rgba(5, 7, 12, 0.88);   z-index: 1000002; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.25s ease;">
  <div class="modal-content" onclick="event.stopPropagation()"
    style="background: rgba(18, 20, 28, 0.98); border: 1px solid rgba(245, 158, 11, 0.35); width: 540px; max-width: 94vw; border-radius: 16px;  overflow: hidden; transform: scale(0.94); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column;">
    
    <!-- Modal Header -->
    <div style="padding: 18px 22px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center; background: rgba(245, 158, 11, 0.06);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); display: flex; align-items: center; justify-content: center;">
          <i class="fa-solid fa-user-xmark" style="color: #fbbf24; font-size: 16px;"></i>
        </div>
        <div>
          <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: #fff;">Oyuncuyu Sunucudan At (Kick)</h3>
          <p style="margin: 2px 0 0; font-size: 11px; color: var(--text-muted);">FiveM sunucu bağlantısını anında sonlandırır</p>
        </div>
      </div>
      <button type="button" onclick="closeActivePlayerKickModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 18px; padding: 4px 8px; border-radius: 6px; transition: all 0.2s;">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div style="padding: 22px; display: flex; flex-direction: column; gap: 16px;">
      <!-- Player Info Card -->
      <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 10px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="font-size: 13px; font-weight: 700; color: #fff;">
            <span id="kick-modal-player-name">Oyuncu Adı</span>
            <span id="kick-modal-player-id" style="font-family: var(--font-mono); font-size: 11px; color: var(--primary); background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); padding: 2px 8px; border-radius: 6px; margin-left: 6px;">#0</span>
          </div>
        </div>
        <div style="font-size: 11px; color: var(--text-muted); font-family: var(--font-mono);" id="kick-modal-discord-id">
          Discord: -
        </div>
      </div>

      <!-- Kick Reason Textarea -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label style="font-size: 12px; font-weight: 700; color: #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
          <span><i class="fa-solid fa-comment-dots" style="color: #fbbf24; margin-right: 6px;"></i>Kick Nedeni / Gerekçesi <strong style="color: #ef4444;">*</strong></span>
          <span style="font-size: 11px; color: #f87171; font-weight: 600;">(Zorunlu)</span>
        </label>
        <textarea id="kick-modal-reason-input" rows="3" class="form-input" placeholder="Oyuncunun neden kicklendiğini detaylıca belirtiniz... (Oyuncu ekranında bu açıklama görünecektir)" style="resize: vertical; border-radius: 8px; font-size: 12px; padding: 10px 12px; width: 100%; min-height: 80px;"></textarea>
      </div>

      <!-- Quick Reason Chips -->
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">Hızlı Sebep Şablonları:</span>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <button type="button" onclick="setKickReasonPreset('Yetkili Çağrısına Uymama (Destek Talebi)')" class="reason-preset-btn">Yetkili Çağrısı</button>
          <button type="button" onclick="setKickReasonPreset('Troll Davranış / Uygunsuz Hareketler')" class="reason-preset-btn">Troll Davranış</button>
          <button type="button" onclick="setKickReasonPreset('Rol Bölme / Rol Dışı (Fail RP)')" class="reason-preset-btn">Rol Bölme (Fail RP)</button>
          <button type="button" onclick="setKickReasonPreset('Uygunsuz Karakter / Karakter İsmi Değişimi')" class="reason-preset-btn">Karakter / Nick</button>
          <button type="button" onclick="setKickReasonPreset('Mikrofon / Kulaklık / Ses İletişim Sorunu')" class="reason-preset-btn">Mikrofon Sorunu</button>
          <button type="button" onclick="setKickReasonPreset('OOC Konuşma / Kural Hatırlatması')" class="reason-preset-btn">OOC Konuşma</button>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div style="padding: 14px 22px; background: rgba(0, 0, 0, 0.4); border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: flex-end; align-items: center; gap: 10px;">
      <button type="button" onclick="closeActivePlayerKickModal()" style="background: rgba(255, 255, 255, 0.06); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.1); padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: background 0.2s;">
        Vazgeç
      </button>
      <button type="button" id="btn-submit-active-player-kick" onclick="executeKickPlayer()" style="background: #f59e0b; color: #000; border: none; padding: 8px 18px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;  transition: all 0.2s;">
        <i class="fa-solid fa-user-xmark"></i> Oyuncuyu Kickle
      </button>
    </div>
  </div>
</div>

<!-- BAN MODAL (Sebep ve Süre Seçimi İçeren Sistem) -->
<div id="active-player-ban-modal" class="modal-backdrop" onclick="onActivePlayerBanBackdropClick(event)"
  style="display: none; position: fixed; inset: 0; background: rgba(5, 7, 12, 0.9);   z-index: 1000002; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.25s ease;">
  <div class="modal-content" onclick="event.stopPropagation()"
    style="background: rgba(18, 20, 28, 0.98); border: 1px solid rgba(239, 68, 68, 0.4); width: 560px; max-width: 94vw; border-radius: 16px;  overflow: hidden; transform: scale(0.94); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column;">
    
    <!-- Modal Header -->
    <div style="padding: 18px 22px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center; background: rgba(239, 68, 68, 0.08);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.35); display: flex; align-items: center; justify-content: center;">
          <i class="fa-solid fa-gavel" style="color: #f87171; font-size: 16px;"></i>
        </div>
        <div>
          <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: #fff;">Oyuncuyu Sunucudan Yasakla (Ban)</h3>
          <p style="margin: 2px 0 0; font-size: 11px; color: var(--text-muted);">FiveM & Whitelist ceza sistemine anında işlenir</p>
        </div>
      </div>
      <button type="button" onclick="closeActivePlayerBanModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 18px; padding: 4px 8px; border-radius: 6px; transition: all 0.2s;">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div style="padding: 22px; display: flex; flex-direction: column; gap: 16px; max-height: 75vh; overflow-y: auto;">
      <!-- Player Info Card -->
      <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 10px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="font-size: 13px; font-weight: 700; color: #fff;">
            <span id="ban-modal-player-name">Oyuncu Adı</span>
            <span id="ban-modal-player-id" style="font-family: var(--font-mono); font-size: 11px; color: var(--danger); background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); padding: 2px 8px; border-radius: 6px; margin-left: 6px;">#0</span>
          </div>
        </div>
        <div style="font-size: 11px; color: var(--text-muted); font-family: var(--font-mono);" id="ban-modal-discord-id">
          Discord: -
        </div>
      </div>

      <!-- Ban Duration Selection System -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label style="font-size: 12px; font-weight: 700; color: #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
          <span><i class="fa-solid fa-clock" style="color: #f87171; margin-right: 6px;"></i>Yasaklama Süresi <strong style="color: #ef4444;">*</strong></span>
          <span id="ban-duration-summary-badge" style="font-size: 11px; color: #f87171; font-weight: 700; background: rgba(239,68,68,0.15); padding: 2px 8px; border-radius: 6px; border: 1px solid rgba(239,68,68,0.3);">3 Gün</span>
        </label>
        
        <!-- Duration Dropdown -->
        <select id="ban-modal-duration-select" onchange="onBanModalDurationSelectChange(this.value)" class="form-input" style="height: 38px; border-radius: 8px; font-size: 12px; width: 100%; cursor: pointer;">
          <option value="1_hour">1 Saat</option>
          <option value="3_hours">3 Saat</option>
          <option value="6_hours">6 Saat</option>
          <option value="12_hours">12 Saat</option>
          <option value="1_day">1 Gün (24 Saat)</option>
          <option value="3_days" selected>3 Gün</option>
          <option value="7_days">7 Gün (1 Hafta)</option>
          <option value="14_days">14 Gün (2 Hafta)</option>
          <option value="30_days">30 Gün (1 Ay)</option>
          <option value="perma">⛔ Kalıcı / Sınırsız (Perma Ban)</option>
          <option value="custom">⚙️ Özel Süre Belirle...</option>
        </select>

        <!-- Fast Duration Preset Chips -->
        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px;">
          <button type="button" onclick="setBanDurationPreset('1_hour')" class="duration-preset-btn">1 Saat</button>
          <button type="button" onclick="setBanDurationPreset('1_day')" class="duration-preset-btn">1 Gün</button>
          <button type="button" onclick="setBanDurationPreset('3_days')" class="duration-preset-btn active">3 Gün</button>
          <button type="button" onclick="setBanDurationPreset('7_days')" class="duration-preset-btn">7 Gün</button>
          <button type="button" onclick="setBanDurationPreset('14_days')" class="duration-preset-btn">14 Gün</button>
          <button type="button" onclick="setBanDurationPreset('30_days')" class="duration-preset-btn">30 Gün</button>
          <button type="button" onclick="setBanDurationPreset('perma')" class="duration-preset-btn perma">⛔ Kalıcı</button>
        </div>

        <!-- Custom Duration Inputs (Conditional) -->
        <div id="ban-modal-custom-duration-wrap" style="display: none; margin-top: 8px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); padding: 10px 12px; border-radius: 8px; gap: 8px; align-items: center;">
          <span style="font-size: 11px; color: var(--text-muted); flex-shrink: 0;">Özel Miktar:</span>
          <input type="number" id="ban-modal-custom-value" min="1" placeholder="Miktar" class="form-input" style="height: 32px; width: 100px; font-size: 12px; padding: 0 10px;">
          <select id="ban-modal-custom-unit" class="form-input" style="height: 32px; font-size: 12px; flex: 1;">
            <option value="hours">Saat</option>
            <option value="days" selected>Gün</option>
          </select>
        </div>
      </div>

      <!-- Ban Reason Textarea -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label style="font-size: 12px; font-weight: 700; color: #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
          <span><i class="fa-solid fa-comment-dots" style="color: #f87171; margin-right: 6px;"></i>Yasaklama Sebebi / İhlal Gerekçesi <strong style="color: #ef4444;">*</strong></span>
          <span style="font-size: 11px; color: #f87171; font-weight: 600;">(Zorunlu)</span>
        </label>
        <textarea id="ban-modal-reason-input" rows="3" class="form-input" placeholder="Oyuncunun sunucudan neden yasaklandığını detaylıca yazınız... (Oyuncu giriş yapmaya çalıştığında bu sebep gösterilecektir)" style="resize: vertical; border-radius: 8px; font-size: 12px; padding: 10px 12px; width: 100%; min-height: 80px;"></textarea>
      </div>

      <!-- Quick Reason Chips -->
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">Hızlı Ceza Maddeleri:</span>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
          <button type="button" onclick="setBanReasonPreset('Hile / 3. Parti Zararlı Yazılım Kullanımı')" class="reason-preset-btn danger">Hile / 3. Parti</button>
          <button type="button" onclick="setBanReasonPreset('RDM / VDM (Toplu Katliam & Kural İhlali)')" class="reason-preset-btn danger">RDM / VDM</button>
          <button type="button" onclick="setBanReasonPreset('Ağır Hakaret / Ailevi Değerlere Küfür / Toksisite')" class="reason-preset-btn danger">Ağır Hakaret / Küfür</button>
          <button type="button" onclick="setBanReasonPreset('Bug Abuse / Dupe / Ekonomi İstismarı')" class="reason-preset-btn danger">Bug Abuse / Dupe</button>
          <button type="button" onclick="setBanReasonPreset('Sunucu Düzenini & Rol Ortamını Kasten Bozma')" class="reason-preset-btn danger">Sunucu Düzeni</button>
          <button type="button" onclick="setBanReasonPreset('Ağır Rol Bölme / İnisiyatif İhlali (Fail RP)')" class="reason-preset-btn danger">Ağır Fail RP</button>
        </div>
      </div>

      <!-- Integration Option -->
      <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 8px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="ban-modal-sync-discord" checked style="accent-color: #ef4444; width: 16px; height: 16px; cursor: pointer;">
          <label for="ban-modal-sync-discord" style="font-size: 12px; color: #e2e8f0; cursor: pointer;">
            Discord & Whitelist Ceza Listesine ve Ceza Paneline Kaydet
          </label>
        </div>
        <span style="font-size: 11px; color: #34d399; font-weight: 600;"><i class="fa-solid fa-circle-check" style="margin-right: 3px;"></i>Otomatik</span>
      </div>
    </div>

    <!-- Modal Footer -->
    <div style="padding: 14px 22px; background: rgba(0, 0, 0, 0.4); border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: flex-end; align-items: center; gap: 10px;">
      <button type="button" onclick="closeActivePlayerBanModal()" style="background: rgba(255, 255, 255, 0.06); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.1); padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: background 0.2s;">
        Vazgeç
      </button>
      <button type="button" id="btn-submit-active-player-ban" onclick="executeBanPlayer()" style="background: #ef4444; color: #fff; border: none; padding: 8px 20px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;  transition: all 0.2s;">
        <i class="fa-solid fa-gavel"></i> Oyuncuyu Banla
      </button>
    </div>
  </div>
</div>

<style>
@keyframes livePulseAnim {
  0% { transform: scale(0.95); opacity: 0.8;  }
  70% { transform: scale(1.15); opacity: 1;  }
  100% { transform: scale(0.95); opacity: 0.8;  }
}
@keyframes spinAnim {
  to { transform: rotate(360deg); }
}

.reason-preset-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #cbd5e1;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 11px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.reason-preset-btn:hover {
  background: rgba(245, 158, 11, 0.15);
  border-color: rgba(245, 158, 11, 0.35);
  color: #fbbf24;
}
.reason-preset-btn.danger:hover {
  background: rgba(239, 68, 68, 0.18);
  border-color: rgba(239, 68, 68, 0.4);
  color: #fca5a5;
}

.duration-preset-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}
.duration-preset-btn:hover, .duration-preset-btn.active {
  background: rgba(239, 68, 68, 0.18);
  border-color: rgba(239, 68, 68, 0.4);
  color: #f87171;
}
.duration-preset-btn.perma:hover, .duration-preset-btn.perma.active {
  background: rgba(239, 68, 68, 0.3);
  border-color: #ef4444;
  color: #fff;
}
</style>

<script>
  let activePlayersCached = [];
  let activeDetailsPlayerId = null;
  let leafletActiveMap = null;
  let leafletMapMarkers = {};
  let currentActivePlayersView = 'table';

  document.addEventListener("DOMContentLoaded", () => {
    var section = document.getElementById("active-players-mgmt");
    if (section) {
      var observer = new MutationObserver(function() {
        if (section.classList.contains('active')) {
          fetchActivePlayersWithCharacters();
        }
      });
      observer.observe(section, { attributes: true, attributeFilter: ['class', 'style'] });
    }

    if (window.location.hash === "#active-players-mgmt") {
      fetchActivePlayersWithCharacters();
    }

    setInterval(function() {
      var sec = document.getElementById("active-players-mgmt");
      if (sec && sec.classList.contains('active')) {
        fetchActivePlayersWithCharacters();
      }
    }, 8000);
  });

  window.switchActivePlayersView = function(view) {
    currentActivePlayersView = view;
    const tableWrap = document.getElementById("active-players-table-wrapper");
    const mapWrap = document.getElementById("active-players-map-wrapper");
    const btnTable = document.getElementById("btn-view-table");
    const btnMap = document.getElementById("btn-view-map");

    if (view === 'map') {
      tableWrap.style.display = "none";
      mapWrap.style.display = "block";
      btnMap.style.background = "rgba(0, 113, 227, 0.2)";
      btnMap.style.color = "#fff";
      btnMap.style.borderColor = "rgba(0, 113, 227, 0.4)";

      btnTable.style.background = "rgba(255, 255, 255, 0.04)";
      btnTable.style.color = "var(--text-muted)";
      btnTable.style.borderColor = "var(--border-color)";

      initLeafletFiveMMap();
    } else {
      tableWrap.style.display = "block";
      mapWrap.style.display = "none";
      btnTable.style.background = "rgba(0, 113, 227, 0.2)";
      btnTable.style.color = "#fff";
      btnTable.style.borderColor = "rgba(0, 113, 227, 0.4)";

      btnMap.style.background = "rgba(255, 255, 255, 0.04)";
      btnMap.style.color = "var(--text-muted)";
      btnMap.style.borderColor = "var(--border-color)";
    }
  };

  function initLeafletFiveMMap() {
    if (leafletActiveMap || typeof L === 'undefined') {
      if (leafletActiveMap) {
        leafletActiveMap.invalidateSize();
        updateLeafletMapMarkers();
      }
      return;
    }

    // GTA V Coordinate Space: X (-4000 to +4000), Y (-4000 to +8000)
    const gtavBounds = [[-4000, -4000], [8000, 4000]];

    leafletActiveMap = L.map('active-players-map', {
      crs: L.CRS.Simple,
      minZoom: -3,
      maxZoom: 4,
      zoomSnap: 0.5
    });

    // GTA V High Definition Atlas Map Overlay (Local Asset)
    const gtavMapOverlayUrl = '/images/gta_map.png';

    L.imageOverlay(gtavMapOverlayUrl, gtavBounds, {
      opacity: 0.95,
      attribution: 'FiveM GTA V Atlas Map'
    }).addTo(leafletActiveMap);

    leafletActiveMap.fitBounds(gtavBounds);
    leafletActiveMap.setView([1500, 0], -1);

    updateLeafletMapMarkers();
  }

  function updateLeafletMapMarkers() {
    if (!leafletActiveMap || typeof L === 'undefined') return;

    const currentIds = new Set(activePlayersCached.map(p => p.id));
    Object.keys(leafletMapMarkers).forEach(id => {
      if (!currentIds.has(Number(id)) && !currentIds.has(id)) {
        leafletActiveMap.removeLayer(leafletMapMarkers[id]);
        delete leafletMapMarkers[id];
      }
    });

    activePlayersCached.forEach((p, idx) => {
      // GTA V coordinates [latitude=Y, longitude=X]
      let lat = (p.coords && typeof p.coords.y === 'number') ? p.coords.y : (Math.sin(idx + 1) * 1400 + 1000);
      let lng = (p.coords && typeof p.coords.x === 'number') ? p.coords.x : (Math.cos(idx + 1) * 1400);

      const charName = (p.characterNames || []).join(', ') || 'Karakter Yok';
      const tooltipContent = escapeHtml(`#${p.id} ${p.name || 'Oyuncu'} (${charName})`);

      const popupHtml = `
        <div style="font-family: 'Inter', sans-serif; padding: 6px; color: #fff; min-width: 180px;">
          <div style="font-weight: 600; font-size: 14px; color: var(--primary); margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-gamepad"></i> #${escapeHtml(p.id)} ${escapeHtml(p.name || 'Oyuncu')}
          </div>
          <div style="font-size: 12px; color: #cbd5e1; margin-bottom: 4px;">
            <strong>Karakter:</strong> ${charName}
          </div>
          <div style="font-size: 11px; color: #94a3b8; margin-bottom: 10px;">
            <strong>Ping:</strong> <span style="color: ${p.ping < 50 ? '#34d399' : '#f87171'};">${p.ping || 0}ms</span>
          </div>
          <div style="display: flex; gap: 6px; margin-top: 6px;">
            <button onclick="openLiveScreenModal('${p.id}', '${(p.name || '').replace(/'/g, "\\'")}', '${p.ping || 0}')" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; display: flex; align-items: center; justify-content: center; gap: 4px;">
              <i class="fa-solid fa-desktop"></i> Ekran İzle
            </button>
            <button onclick="viewPlayerDetails('${p.discordId || ''}', '${p.id}', '${(p.name || '').replace(/'/g, "\\'")}')" style="background: var(--primary); color: #fff; border: none; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer; flex: 1; display: flex; align-items: center; justify-content: center; gap: 4px;">
              <i class="fa-solid fa-circle-info"></i> Detay
            </button>
          </div>
        </div>
      `;

      if (leafletMapMarkers[p.id]) {
        leafletMapMarkers[p.id].setLatLng([lat, lng]);
        leafletMapMarkers[p.id].setTooltipContent(tooltipContent);
      } else {
        const marker = L.circleMarker([lat, lng], {
          radius: 8,
          fillColor: '#10b981',
          color: '#ffffff',
          weight: 2.5,
          opacity: 1,
          fillOpacity: 0.95
        }).addTo(leafletActiveMap);

        marker.bindTooltip(tooltipContent, {
          permanent: false,
          direction: 'top',
          offset: [0, -6],
          className: 'gtav-map-tooltip'
        });

        marker.bindPopup(popupHtml);
        leafletMapMarkers[p.id] = marker;
      }
    });
  }

  let activePlayersBridge = null;

  function renderActivePlayersBridgeState(errorMessage) {
    const box = document.getElementById("active-players-bridge-state");
    const badge = document.getElementById("active-players-total-badge");
    const sub = document.getElementById("active-players-subline");
    const b = activePlayersBridge;
    if (errorMessage) {
      box.innerHTML = `<div class="state-error" style="margin-bottom: 16px;"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><div><strong>${escapeHtml(errorMessage)}</strong> Liste son başarılı okumaya aittir.</div></div>`;
      return;
    }
    if (!b || !b.online) {
      badge.className = "pill pill-negative";
      badge.textContent = "Sunucu çevrimdışı";
      sub.textContent = b && b.lastPollAt ? `FiveM sunucusundan son veri ${Console.formatDateTime(b.lastPollAt)} tarihinde geldi.` : "FiveM köprüsü bu panel açıldığından beri bağlanmadı.";
      box.innerHTML = "";
    } else {
      badge.className = "pill pill-positive";
      badge.textContent = b.maxPlayers ? `${b.playersCount} / ${b.maxPlayers} oyuncu` : `${b.playersCount} oyuncu`;
      sub.textContent = `Son güncelleme ${Console.relativeTime(b.lastPollAt)}. Liste her 8 saniyede yenilenir.`;
      box.innerHTML = b.reportsResults ? "" : '<div class="notice info" style="margin-bottom: 16px;"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>Oyun sunucusundaki köprü eski sürüm: komutların sonucu doğrulanamaz.</span></div>';
    }
  }

  async function fetchActivePlayersWithCharacters() {
    const tbody = document.getElementById("active-players-table-body");
    if (!tbody) return;

    try {
      const res = await fetch("/api/fivem/active-players-characters");
      const data = await res.json();
      if (data.success) {
        activePlayersBridge = data.bridge || null;
        activePlayersCached = data.players || [];
        renderActivePlayersBridgeState();
        filterActivePlayersTable();
        updateLeafletMapMarkers();
      } else {
        renderActivePlayersBridgeState(data.message || "Oyuncu listesi alınamadı.");
      }
    } catch (err) {
      renderActivePlayersBridgeState("Panel sunucusuna ulaşılamadı.");
    }
  }

  function filterActivePlayersTable() {
    const rawQuery = document.getElementById("search-active-players-input").value.toLowerCase().trim();
    const cleanIdQuery = rawQuery.startsWith("#") ? rawQuery.substring(1) : rawQuery;
    const tbody = document.getElementById("active-players-table-body");
    const badge = document.getElementById("active-players-total-badge");


    const filtered = activePlayersCached.filter(p => {
      const charStr = (p.characterNames || []).join(", ").toLowerCase();
      const inGameIdStr = String(p.id != null ? p.id : "").toLowerCase();
      const hashedIdStr = "#" + inGameIdStr;
      const pName = (p.name || "").toLowerCase();
      const pDiscordId = (p.discordId || "").toLowerCase();
      const identifiersMatch = (p.identifiers || []).some(id => String(id).toLowerCase().includes(rawQuery));

      return (
        inGameIdStr === cleanIdQuery ||
        hashedIdStr.includes(rawQuery) ||
        inGameIdStr.includes(cleanIdQuery) ||
        pName.includes(rawQuery) ||
        pDiscordId.includes(rawQuery) ||
        charStr.includes(rawQuery) ||
        identifiersMatch
      );
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6"><div class="state-empty">${activePlayersCached.length ? "Aramayla eşleşen oyuncu yok." : (activePlayersBridge && activePlayersBridge.online ? "Sunucuda şu anda oyuncu yok." : "Oyuncu listesi yok: FiveM sunucusu çevrimdışı.")}</div></td></tr>`;
      return;
    }

    const dash = '<span class="dash">—</span>';
    tbody.innerHTML = filtered.map(p => {
      const names = (p.characterNames || []).filter(Boolean);
      const characters = names.length ? names.map(cn => escapeHtml(cn)).join(", ") : '<span class="dash" title="Panelde bu Discord hesabına bağlı karakter yok">—</span>';
      const ping = Number.isFinite(Number(p.ping)) ? `${escapeHtml(p.ping)}<span class="unit"> ms</span>` : dash;
      return `
        <tr>
          <td class="num" style="font-family: var(--font-mono);">${escapeHtml(p.id)}</td>
          <td style="font-weight: 500;">${p.name ? escapeHtml(p.name) : dash}</td>
          <td class="sensitive-info" style="font-family: var(--font-mono); font-size: 12px; color: var(--muted);">${p.discordId ? escapeHtml(p.discordId) : dash}</td>
          <td>${characters}</td>
          <td class="num">${ping}</td>
          <td style="text-align: right; white-space: nowrap;">
            <div style="display: inline-flex; gap: 6px;">
              <button type="button" class="btn" style="height: 30px; padding: 0 12px;" onclick="openLiveScreenModal(${jsArg(p.id)}, ${jsArg(p.name || "")}, ${jsArg(p.ping || 0)})">Ekran</button>
              <button type="button" class="btn" style="height: 30px; padding: 0 12px;" onclick="viewPlayerDetails(${jsArg(p.discordId || "")}, ${jsArg(p.id)}, ${jsArg(p.name || "")})">Detay</button>
              <button type="button" class="btn" style="height: 30px; padding: 0 12px;" onclick="openKickModal(${jsArg(p.id)}, ${jsArg(p.name || "")}, ${jsArg(p.discordId || "")})">Kick</button>
              <button type="button" class="btn btn-danger" style="height: 30px; padding: 0 12px;" onclick="openBanModal(${jsArg(p.id)}, ${jsArg(p.name || "")}, ${jsArg(p.discordId || "")})">Ban</button>
            </div>
          </td>
        </tr>`;
    }).join("");
  }

  window.copyModalIdentifier = function(elemId, btn) {
    const el = document.getElementById(elemId);
    if (!el) return;
    const val = el.getAttribute("data-real-ip") || el.getAttribute("data-full-val") || el.innerText;
    if (!val || val === "-" || val === "Bulunamadı") return;
    navigator.clipboard.writeText(val).then(() => {
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-check" style="color: #34d399;"></i>';
      setTimeout(() => {
        btn.innerHTML = orig;
      }, 1500);
    });
  };

  window.toggleModalIpVisibility = function(btn) {
    const el = document.getElementById("modal-ident-ip");
    if (!el) return;
    const realIp = el.getAttribute("data-real-ip");
    if (!realIp || realIp === "-" || realIp === "Bulunamadı") return;
    const isHidden = el.getAttribute("data-hidden") === "true";
    if (isHidden) {
      el.innerText = realIp;
      el.setAttribute("data-hidden", "false");
      btn.innerHTML = '<i class="fa-solid fa-eye-slash"></i>';
    } else {
      el.innerText = "••••••••••••";
      el.setAttribute("data-hidden", "true");
      btn.innerHTML = '<i class="fa-solid fa-eye"></i>';
    }
  };

  function setModalIdentValue(elemId, val) {
    const el = document.getElementById(elemId);
    const btn = document.getElementById(elemId + "-btn");
    if (!el) return;
    if (val && String(val).trim().length > 0) {
      el.innerText = String(val).trim();
      el.setAttribute("data-full-val", String(val).trim());
      el.style.color = "#e2e8f0";
      el.style.fontStyle = "normal";
      if (btn) btn.style.display = "inline-flex";
    } else {
      el.innerText = "Bulunamadı";
      el.removeAttribute("data-full-val");
      el.style.color = "var(--text-muted)";
      el.style.fontStyle = "italic";
      if (btn) btn.style.display = "none";
    }
  }

  function setModalIdentIp(val) {
    const el = document.getElementById("modal-ident-ip");
    const toggleBtn = document.getElementById("modal-ident-ip-toggle-btn");
    const copyBtn = document.getElementById("modal-ident-ip-btn");
    if (!el) return;
    if (val && String(val).trim().length > 0) {
      const cleanIp = String(val).trim();
      el.setAttribute("data-real-ip", cleanIp);
      el.setAttribute("data-hidden", "true");
      el.innerText = "••••••••••••";
      el.style.color = "#e2e8f0";
      el.style.fontStyle = "normal";
      if (toggleBtn) {
        toggleBtn.style.display = "inline-flex";
        toggleBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';
      }
      if (copyBtn) copyBtn.style.display = "inline-flex";
    } else {
      el.innerText = "Bulunamadı";
      el.removeAttribute("data-real-ip");
      el.setAttribute("data-hidden", "false");
      el.style.color = "var(--text-muted)";
      el.style.fontStyle = "italic";
      if (toggleBtn) toggleBtn.style.display = "none";
      if (copyBtn) copyBtn.style.display = "none";
    }
  }

  function renderPlayerIdentifiers(playerObj, fallbackDiscordId = "") {
    const info = (playerObj && playerObj.generalInfo) ? playerObj.generalInfo : {};
    const identifiersList = (playerObj && Array.isArray(playerObj.identifiers)) ? playerObj.identifiers : [];

    const getVal = (key) => {
      let val = "";
      if (info && info[key]) {
        val = info[key];
      } else {
        const match = identifiersList.find(id => typeof id === "string" && id.toLowerCase().startsWith(key.toLowerCase() + ":"));
        if (match) {
          const colonIdx = match.indexOf(":");
          val = match.substring(colonIdx + 1);
        } else if (playerObj && playerObj[key] !== undefined && playerObj[key] !== null) {
          val = String(playerObj[key]);
        }
      }
      if (val && typeof val === "string" && val.toLowerCase().startsWith(key.toLowerCase() + ":")) {
        val = val.substring(key.length + 1);
      }
      return val ? String(val).trim() : "";
    };

    const fivem = getVal("fivem");
    const discord = getVal("discord") || (playerObj ? playerObj.discordId : "") || fallbackDiscordId || "";
    const license2 = getVal("license2") || getVal("licanse2");
    const license = getVal("license") || getVal("licanse");
    const steam = getVal("steam");
    const xbl = getVal("xbl") || getVal("live");
    const ip = getVal("ip") || (playerObj && playerObj.endpoint ? String(playerObj.endpoint).split(":")[0] : "") || (playerObj && playerObj.ip ? String(playerObj.ip) : "");

    setModalIdentValue("modal-ident-fivem", fivem);
    setModalIdentValue("modal-ident-discord", discord);
    setModalIdentValue("modal-ident-license2", license2);
    setModalIdentValue("modal-ident-license", license);
    setModalIdentValue("modal-ident-steam", steam);
    setModalIdentValue("modal-ident-xbl", xbl);
    setModalIdentIp(ip);
  }

  async function viewPlayerDetails(discordId, serverId, serverName) {
    const modal = document.getElementById("player-details-modal");
    if (!modal) return;

    activeDetailsPlayerId = serverId;

    const elJob = document.getElementById("cmd-setjob-job");
    if (elJob) elJob.value = "";
    const elGrade = document.getElementById("cmd-setjob-grade");
    if (elGrade) elGrade.value = "";
    const elGang = document.getElementById("cmd-setgang-gang");
    if (elGang) elGang.value = "";
    const elGangGrade = document.getElementById("cmd-setgang-grade");
    if (elGangGrade) elGangGrade.value = "";
    const elItem = document.getElementById("cmd-giveitem-item");
    if (elItem) elItem.value = "";
    const elAmount = document.getElementById("cmd-giveitem-amount");
    if (elAmount) elAmount.value = "";
    const elDm = document.getElementById("cmd-dm-message");
    if (elDm) elDm.value = "";
    const elPed = document.getElementById("cmd-pedver-model");
    if (elPed) elPed.value = "";
    const elPlate = document.getElementById("cmd-vreturn-plate");
    if (elPlate) elPlate.value = "";

    document.getElementById("modal-player-title").innerText = `${serverName} Detayları`;
    document.getElementById("modal-player-id").innerText = serverId;
    document.getElementById("modal-player-name").innerText = serverName;
    
    let playerObj = Array.isArray(activePlayersCached)
      ? activePlayersCached.find(p => String(p.id) === String(serverId) || (discordId && p.discordId && String(p.discordId) === String(discordId)))
      : null;

    document.getElementById("modal-player-ping").innerHTML = (playerObj && playerObj.ping !== undefined && playerObj.ping !== null)
      ? `<i class="fa-solid fa-bolt"></i> ${playerObj.ping}ms` 
      : "-";

    renderPlayerIdentifiers(playerObj, discordId);

    document.getElementById("modal-discord-loading").style.display = "block";
    document.getElementById("modal-discord-content").style.display = "none";
    document.getElementById("modal-characters-loading").style.display = "block";
    
    const charContent = document.getElementById("modal-characters-content");
    charContent.innerHTML = "";

    // Show modal
    modal.style.display = "flex";
    modal.style.pointerEvents = "auto";
    setTimeout(() => {
      modal.style.opacity = "1";
      modal.querySelector(".modal-content").style.transform = "scale(1)";
    }, 10);

    if (!discordId) {
      document.getElementById("modal-discord-loading").style.display = "none";
      document.getElementById("modal-discord-content").style.display = "block";
      document.getElementById("modal-discord-username").innerText = "Yok";
      document.getElementById("modal-discord-id").innerText = "Bulunamadı";
      document.getElementById("modal-discord-avatar").src = "";
      document.getElementById("modal-discord-whitelist").innerHTML = `<span style="color: #ef4444;"><i class="fa-solid fa-circle-xmark"></i> Whitelist Yok</span>`;
      document.getElementById("modal-discord-warnings").innerText = "0";
      
      document.getElementById("modal-characters-loading").style.display = "none";
      charContent.innerHTML = `<div style="text-align: center; color: var(--text-muted); font-style: italic; padding: 16px;">Bu oyuncuya bağlı Discord hesabı bulunmadığı için karakter bilgisi çekilemedi.</div>`;
      return;
    }

    try {
      const res = await fetch(`/api/fivem/player-detail/${encodeURIComponent(discordId)}?serverId=${encodeURIComponent(serverId || "")}`);
      const data = await res.json();
      
      document.getElementById("modal-discord-loading").style.display = "none";
      
      if (data.success) {
        if (data.onlinePlayer) {
          renderPlayerIdentifiers(data.onlinePlayer, discordId);
          if (data.onlinePlayer.ping !== undefined && data.onlinePlayer.ping !== null) {
            document.getElementById("modal-player-ping").innerHTML = `<i class="fa-solid fa-bolt"></i> ${data.onlinePlayer.ping}ms`;
          }
        }
        // Discord User Info
        document.getElementById("modal-discord-content").style.display = "block";
        const du = data.discordUser;
        if (du) {
          document.getElementById("modal-discord-username").innerText = du.username || "Bilinmiyor";
          document.getElementById("modal-discord-id").innerText = du.discordId;
          document.getElementById("modal-discord-avatar").src = du.avatarUrl || "";
          document.getElementById("modal-discord-whitelist").innerHTML = du.isWhitelist 
            ? `<span style="color: #34d399;"><i class="fa-solid fa-circle-check"></i> Whitelist Var</span>`
            : `<span style="color: #ef4444;"><i class="fa-solid fa-circle-xmark"></i> Whitelist Yok</span>`;
          document.getElementById("modal-discord-warnings").innerText = du.warnings || "0";
        } else {
          document.getElementById("modal-discord-username").innerText = "Bilinmeyen Discord Kullanıcısı";
          document.getElementById("modal-discord-id").innerText = discordId;
          document.getElementById("modal-discord-whitelist").innerHTML = `<span style="color: #ef4444;"><i class="fa-solid fa-circle-xmark"></i> Whitelist Yok (Kayıtsız)</span>`;
          document.getElementById("modal-discord-warnings").innerText = "0";
        }

        // Characters Info
        document.getElementById("modal-characters-loading").style.display = "none";
        const chars = data.characters || [];
        if (chars.length > 0 && chars[0].license) {
          const licEl = document.getElementById("modal-ident-license");
          if (licEl && (licEl.innerText === "Bulunamadı" || licEl.innerText === "-")) {
            setModalIdentValue("modal-ident-license", chars[0].license.replace(/^license:/i, ""));
          }
        }
        if (chars.length === 0) {
          charContent.innerHTML = `<div style="text-align: center; color: var(--text-muted); font-style: italic; padding: 16px;">Karakter veritabanında bu oyuncuya ait karakter kaydı bulunamadı.</div>`;
