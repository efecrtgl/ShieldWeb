  async function deleteCharacterFromModal(characterId, citizenid, charName) {
    const confirmed = confirm(
      `"${charName}" (${citizenid}) isimli karakteri veritabanından kalıcı olarak silmek istediğinize emin misiniz?\n\nBu işlem geri alınamaz!`
    );
    if (!confirmed) return;

    try {
      const res = await fetch("/api/fivem/character/delete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ characterId, citizenid })
      });
      const data = await res.json();
      if (data.success) {
        toastForResult(data);
        // Modalı yenile: aynı oyuncunun detaylarını tekrar çek
        const playerObj = Array.isArray(activePlayersCached) ? activePlayersCached.find(p => String(p.id) === String(activeDetailsPlayerId)) : null;
        if (playerObj && playerObj.discordId) {
          viewPlayerDetails(playerObj.discordId, playerObj.id, playerObj.name);
        } else {
          // Karakter bölümünü temizle
          const charContent = document.getElementById("modal-characters-content");
          if (charContent) {
            const deletedCard = charContent.querySelector(`[data-citizenid='${citizenid}']`);
            if (deletedCard) deletedCard.remove();
          }
        }
      } else {
        showToast(data.message || "Karakter silinirken hata oluştu.", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Sunucuya erişilemedi.", "error");
    }
  }

