  window.openLiveScreenModal = async function(playerId, playerName, ping) {
    if (!playerId) return;
    currentStreamingPlayerId = String(playerId);

    const modal = document.getElementById("live-screen-modal");
    const modalContent = modal ? modal.querySelector(".modal-content") : null;
    const loader = document.getElementById("live-screen-loader");
    const viewport = document.getElementById("live-screen-viewport");
    const nameEl = document.getElementById("live-screen-player-name");
    const idEl = document.getElementById("live-screen-player-id");
    const pingEl = document.getElementById("live-screen-ping");
    const fpsStat = document.getElementById("live-screen-fps-stat");
    const lagStat = document.getElementById("live-screen-lag-stat");
    const hudTime = document.getElementById("live-screen-hud-time");
    const hudRes = document.getElementById("live-screen-hud-resolution");

    if (nameEl) nameEl.innerText = playerName || "Oyuncu";
    if (idEl) idEl.innerText = "#" + playerId;
    if (pingEl) pingEl.innerHTML = '<i class="fa-solid fa-bolt" style="margin-right: 3px;"></i>' + (ping || 0) + 'ms';
    if (loader) loader.style.display = "flex";
    if (fpsStat) fpsStat.innerText = "60.0";
    if (lagStat) lagStat.innerText = "Ultra Düşük";
    if (hudRes) hudRes.innerText = "1920x1080 (Full HD)";

    if (modal) {
      modal.style.display = "flex";
      requestAnimationFrame(() => {
        modal.style.opacity = "1";
        if (modalContent) modalContent.style.transform = "scale(1)";
      });
    }

    if (screenHudClockTimer) clearInterval(screenHudClockTimer);
    screenHudClockTimer = setInterval(() => {
      if (hudTime) hudTime.innerText = new Date().toLocaleTimeString();
    }, 1000);
    if (hudTime) hudTime.innerText = new Date().toLocaleTimeString();

    const speedSelect = document.getElementById("live-screen-speed-select");
    const interval = speedSelect ? parseInt(speedSelect.value, 10) : 16;
    const quality = interval <= 20 ? 0.60 : (interval <= 40 ? 0.65 : 0.70);

    try {
      await fetch("/api/fivem/screen/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          targetPlayer: playerId,
          interval: interval,
          quality: quality
        })
      });
    } catch (err) {}

    if (viewport) {
      viewport.onload = function() {
        if (loader) loader.style.display = "none";
        if (hudRes && viewport.naturalWidth) {
          hudRes.innerText = viewport.naturalWidth + "x" + viewport.naturalHeight + " (Full HD)";
        }
      };
      viewport.src = "/api/fivem/screen/mjpeg/" + playerId + "?t=" + Date.now();
      setTimeout(() => {
        if (loader && viewport.complete && viewport.naturalWidth > 0) {
          loader.style.display = "none";
        }
      }, 1200);
    }
  };

  window.closeLiveScreenModal = async function(event) {
    if (event && event.stopPropagation) {
      event.stopPropagation();
    }
    const modal = document.getElementById("live-screen-modal");
    const modalContent = modal ? modal.querySelector(".modal-content") : null;
    const viewport = document.getElementById("live-screen-viewport");
    const targetPlayer = currentStreamingPlayerId;

    if (screenHudClockTimer) {
      clearInterval(screenHudClockTimer);
      screenHudClockTimer = null;
    }

    if (viewport) {
      viewport.onload = null;
      viewport.onerror = null;
      viewport.src = "";
    }

    currentStreamingPlayerId = null;

    if (modal) {
      modal.style.opacity = "0";
      if (modalContent) modalContent.style.transform = "scale(0.94)";
      setTimeout(() => {
        modal.style.display = "none";
      }, 200);
