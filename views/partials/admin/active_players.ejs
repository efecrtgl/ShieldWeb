  window.downloadLiveScreenSnapshot = function() {
    const viewport = document.getElementById("live-screen-viewport");
    if (!viewport || !viewport.naturalWidth) {
      showToast("Görüntü karesi henüz yüklenmedi.", "error");
      return;
    }
    try {
      const c = document.createElement("canvas");
      c.width = viewport.naturalWidth || 1920;
      c.height = viewport.naturalHeight || 1080;
      const ctx = c.getContext("2d");
      ctx.drawImage(viewport, 0, 0);
      const link = document.createElement("a");
      link.href = c.toDataURL("image/jpeg", 0.95);
      link.download = "shield_player_" + (currentStreamingPlayerId || "screen") + "_" + Date.now() + ".jpg";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("Full HD ekran fotoğrafı kaydedildi.", "success");
    } catch (err) {
      showToast("Fotoğraf alınırken hata oluştu.", "error");
    }
  };

