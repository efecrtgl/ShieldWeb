  async function submitTeleport() {
    if (!activeDetailsPlayerId) return;

    const raw         = (document.getElementById('cmd-tp-coords').value || '').trim();
    const locationKey = window._selectedTpLocationKey || null;

    // Ne location key ne de koordinat girilmişse uyar
    if (!locationKey && !raw) {
      alert('Koordinat giriniz veya hazır konum seçiniz!');
      return;
    }

    let body = { action: 'teleport', targetPlayer: activeDetailsPlayerId };
    let toastMsg = '';

    if (raw) {
      // Manuel XYZ koordinatı öncelikli
      const parts = raw.split(',').map(v => parseFloat(v.trim()));
      if (parts.length < 3 || parts.some(isNaN)) {
        alert('Geçerli koordinat formatı: X, Y, Z (örn: -1034.72, -2733.09, 20.17)');
        return;
      }
      const [x, y, z] = parts;
      body.x = x; body.y = y; body.z = z;
      toastMsg = `Oyuncu ışınlandı → ${x}, ${y}, ${z}`;
    } else {
      // Lokasyon key'i kullan
      body.location = locationKey;
      const label = document.getElementById('tp-dropdown-label').textContent || locationKey;
      toastMsg = `Oyuncu ışınlandı → ${label}`;
    }

    try {
      const res = await fetch('/api/fivem/bridge/command', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (data.success) {
        toastForResult(data);
        // Sıfırla
        document.getElementById('cmd-tp-coords').value = '';
        document.getElementById('cmd-tp-coords').placeholder = 'Koordinat (örn: -1034.72, -2733.09, 20.17)';
        const lbl = document.getElementById('tp-dropdown-label');
        if (lbl) lbl.textContent = 'Hazır konum seçin (opsiyonel)';
        window._selectedTpLocationKey = null;
      } else {
        showToast(data.message || 'Hata oluştu.', 'error');
      }
    } catch (err) {
      showToast('Sunucuya erişilemedi.', 'error');
    }
  }

