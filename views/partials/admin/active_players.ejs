  // Custom Dropdown: Işınlama konum seçici
  function toggleTpDropdown() {
    const list   = document.getElementById('tp-dropdown-list');
    const arrow  = document.getElementById('tp-dropdown-arrow');
    const trigger = document.getElementById('tp-dropdown-trigger');
    if (!list) return;
    const isOpen = list.style.display === 'block';
    list.style.display  = isOpen ? 'none' : 'block';
    arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
