    try {
      const res = await fetch("/api/fivem/bridge/command", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "setjob",
          targetPlayer: activeDetailsPlayerId,
          job: job,
          grade: grade
