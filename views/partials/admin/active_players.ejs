  window.executeBanPlayer = async function() {
    if (!targetBanPlayerId) {
      showToast("Hedef oyuncu seçilmedi.", "error");
      return;
    }
    const reasonInput = document.getElementById("ban-modal-reason-input");
    const reason = (reasonInput ? reasonInput.value : "").trim();
    if (!reason) {
      showToast("Lütfen bir banlama sebebi belirtiniz! (Zorunlu)", "error");
      if (reasonInput) reasonInput.focus();
      return;
    }

    const durationSelect = document.getElementById("ban-modal-duration-select");
    const durationVal = durationSelect ? durationSelect.value : "3_days";
    
    let durationText = "";
    let durationSeconds = 0;
    let isPerma = false;

    if (durationVal === "custom") {
      const customNum = parseInt(document.getElementById("ban-modal-custom-value")?.value, 10);
      const customUnit = document.getElementById("ban-modal-custom-unit")?.value || "days";
      if (isNaN(customNum) || customNum <= 0) {
        showToast("Lütfen geçerli bir özel süre miktarı giriniz!", "error");
        document.getElementById("ban-modal-custom-value")?.focus();
        return;
      }
      if (customUnit === "hours") {
        durationSeconds = customNum * 3600;
        durationText = `${customNum} Saat`;
      } else {
        durationSeconds = customNum * 86400;
        durationText = `${customNum} Gün`;
      }
    } else if (durationVal === "perma") {
      isPerma = true;
      durationText = "Kalıcı (Perma)";
      durationSeconds = 0;
    } else {
      const durationMap = {
        "1_hour": { sec: 3600, label: "1 Saat" },
        "3_hours": { sec: 3 * 3600, label: "3 Saat" },
        "6_hours": { sec: 6 * 3600, label: "6 Saat" },
        "12_hours": { sec: 12 * 3600, label: "12 Saat" },
        "1_day": { sec: 86400, label: "1 Gün" },
        "3_days": { sec: 3 * 86400, label: "3 Gün" },
        "7_days": { sec: 7 * 86400, label: "7 Gün" },
        "14_days": { sec: 14 * 86400, label: "14 Gün" },
        "30_days": { sec: 30 * 86400, label: "30 Gün" }
      };
      const mapped = durationMap[durationVal] || { sec: 3 * 86400, label: "3 Gün" };
      durationSeconds = mapped.sec;
      durationText = mapped.label;
    }

    const syncDiscord = document.getElementById("ban-modal-sync-discord")?.checked ?? true;

    const btn = document.getElementById("btn-submit-active-player-ban");
    const origBtnText = btn ? btn.innerHTML : "";
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Yasaklanıyor...';
    }

    try {
      const res = await fetch("/api/fivem/bridge/command", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "ban",
          targetPlayer: targetBanPlayerId,
          playerName: targetBanPlayerName,
          discordId: targetBanDiscordId,
          reason: reason,
          duration: durationVal,
          durationText: durationText,
          durationSeconds: durationSeconds,
          isPerma: isPerma,
          syncDiscord: syncDiscord
        })
      });
      const data = await res.json();
      if (data.success) {
        toastForResult(data);
        closeActivePlayerBanModal();
        if (typeof closePlayerDetailsModal === "function") {
          closePlayerDetailsModal();
        }
        if (typeof fetchActivePlayersWithCharacters === "function") {
          setTimeout(fetchActivePlayersWithCharacters, 800);
        }
      } else {
        showToast(data.message || "Banlama işlemi başarısız oldu.", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("Sunucuya bağlanırken hata oluştu.", "error");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origBtnText;
      }
    }
  };

</script>
