    // Seçilen lokasyon key'ini sakla
    window._selectedTpLocationKey = locationKey || null;

    const input = document.getElementById('cmd-tp-coords');
    if (locationKey) {
      // Preset seçildiğinde koordinat kutusunu temizle ve placeholder güncelle
      if (input) {
        input.value = '';
        input.placeholder = `"${label}" lokasyonu seçildi — veya buraya XYZ girin`;
      }
