      const data = await res.json();
      if (data.success) {
        toastForResult(data);
        document.getElementById("cmd-setjob-job").value = "";
        document.getElementById("cmd-setjob-grade").value = "";
      } else {
        showToast(data.message || "Hata oluştu.", "error");
      }
    } catch (err) {
      showToast("Sunucuya erişilemedi.", "error");
    }
  }

