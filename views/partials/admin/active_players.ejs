  function setMoneyType(type) {
    selectedMoneyType = type;
    const cashBtn = document.getElementById('givemoney-type-cash');
    const bankBtn = document.getElementById('givemoney-type-bank');
    if (!cashBtn || !bankBtn) return;
    if (type === 'cash') {
      cashBtn.style.background = 'rgba(52,211,153,0.25)';
      cashBtn.style.color = '#34d399';
      bankBtn.style.background = 'transparent';
      bankBtn.style.color = 'var(--text-muted)';
    } else {
      bankBtn.style.background = 'rgba(96,165,250,0.25)';
      bankBtn.style.color = '#60a5fa';
      cashBtn.style.background = 'transparent';
      cashBtn.style.color = 'var(--text-muted)';
    }
  }

