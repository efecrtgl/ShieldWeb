<section id="fivem-gangs-content" class="admin-section-inner" style="font-family: 'Outfit', sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-people-group text-primary"></i> FiveM Çete Listesi</h2>
    <span id="fivem-gangs-total" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 700;">0 Tanımlı Çete</span>
  </div>

  <div class="content-panel" style="padding: 24px;">
    <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px;">
      <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
        <div style="position: relative; width: 320px; max-width: 100%;">
          <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 13px; z-index: 2;"></i>
          <input type="text" id="search-fivem-gangs" oninput="filterFiveMGangs()" placeholder="Çete adı veya kod ara..." class="form-input" style="padding-left: 38px !important; height: 40px; border-radius: 8px; font-size: 13px; width: 100%;">
        </div>
      </div>
    </div>

    <div id="fivem-gangs-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
      <div style="grid-column: 1 / -1; text-align: center; color: var(--text-muted); font-size: 13px; padding: 40px 0;">
        <i class="fa-solid fa-spinner fa-spin" style="font-size: 24px; margin-bottom: 12px; color: var(--primary);"></i><br>Çete verileri alınıyor...
      </div>
    </div>
  </div>
</section>

<script>
  let fivemGangsCached = {};

  document.addEventListener("DOMContentLoaded", () => {
    const tabLink = document.querySelector('.sidebar-link[href="#fivem-gangs"]');
    if (tabLink) {
      tabLink.addEventListener("click", fetchFiveMGangs);
    }
    if (window.location.hash === "#fivem-gangs") {
      fetchFiveMGangs();
    }
  });

  async function fetchFiveMGangs() {
    try {
      const res = await fetch("/api/fivem/shared-data");
      const data = await res.json();
      if (data.success && data.gangs) {
        fivemGangsCached = data.gangs;
        filterFiveMGangs();
      }
    } catch (err) {
      console.error(err);
    }
  }

  function filterFiveMGangs() {
    const query = document.getElementById("search-fivem-gangs").value.toLowerCase().trim();
    const grid = document.getElementById("fivem-gangs-grid");
    if (!grid) return;

    const gangEntries = Object.entries(fivemGangsCached);
    const filtered = gangEntries.filter(([code, gang]) => {
      return code.toLowerCase().includes(query) || (gang.label || "").toLowerCase().includes(query);
    });

    document.getElementById("fivem-gangs-total").innerText = `${filtered.length} Tanımlı Çete`;

    if (filtered.length === 0) {
      grid.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; color: var(--text-muted); font-size: 13px; padding: 40px 0;">Çete bulunamadı.</div>
      `;
      return;
    }

    let html = '';
    filtered.forEach(([code, gang]) => {
      let gradesHtml = '';
      if (gang.grades) {
        Object.entries(gang.grades).forEach(([gradeLevel, g]) => {
          const name = g.name || g.label || `Grade ${gradeLevel}`;
          gradesHtml += `
            <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.15); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02); font-size: 11px;">
              <span style="font-weight: 600; color: #fff;"><span style="color: var(--primary); font-family: monospace; font-weight: 800; margin-right: 6px;">[${gradeLevel}]</span>${name}</span>
            </div>
          `;
        });
      }

      html += `
        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 14px; transition: transform 0.2s;">
          <div style="display: flex; align-items: center; gap: 12px; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 10px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center;">
              <i class="fa-solid fa-people-group text-primary" style="font-size: 16px;"></i>
            </div>
            <div>
              <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #fff;">${gang.label || code}</h4>
              <span style="font-family: monospace; font-size: 11px; color: var(--text-muted);">${code}</span>
            </div>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <div style="color: var(--text-muted); font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 2px;">Rütbeler</div>
            ${gradesHtml || '<div style="font-style: italic; color: var(--text-muted); font-size: 11px;">Rütbe bilgisi bulunamadı.</div>'}
          </div>
        </div>
      `;
    });

    grid.innerHTML = html;
  }
</script>
