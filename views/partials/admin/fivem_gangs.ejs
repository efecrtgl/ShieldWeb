<section class="admin-section-inner" data-catalog="gangs" aria-labelledby="catalog-gangs-title">
  <div class="section-head">
    <div>
      <h2 id="catalog-gangs-title">Çeteler</h2>
      <p>Sunucunun tanımlı çeteleri ve kademeleri. Veri yalnızca FiveM sunucusundan gelir.</p>
    </div>
    <div class="actions">
      <span class="freshness" data-catalog-count></span>
      <button type="button" class="btn" data-catalog-refresh><i class="fa-solid fa-rotate" aria-hidden="true"></i> Yenile</button>
    </div>
  </div>
  <div class="content-panel">
    <div class="catalog-toolbar">
      <label class="catalog-search">
        <span class="sr-only">Çete adı veya kodu ara</span>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" class="form-input" placeholder="Çete adı veya kodu ara" autocomplete="off">
      </label>
      <div data-catalog-status></div>
    </div>
    <div class="catalog-grid" aria-live="polite"></div>
  </div>
</section>
