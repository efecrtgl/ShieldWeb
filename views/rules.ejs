        <li><a href="#section-index" class="rules-menu-link"><i class="fa-solid fa-list-ol"></i> EK-C. Hızlı Cevap İndeksi</a></li>
        <li><a href="#section-penalty-matrix" class="rules-menu-link"><i class="fa-solid fa-gavel"></i> BÖLÜM IV. Ceza Yönetmeliği</a></li>
      </ul>
