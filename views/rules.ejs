<%- include('partials/header') %>

<style>
  .rules-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    margin-top: 40px;
    align-items: start;
  }

  .rules-sidebar {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    background: rgba(12, 13, 16, 0.5);
    
    
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 20px;
  }

  .rules-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .rules-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
  }

  .rules-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rules-menu-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .rules-menu-link:hover, .rules-menu-link.active {
    background: rgba(255, 255, 255, 0.03);
    color: var(--primary);
  }
  
  .rules-menu-link.active {
    border-left: 2px solid var(--primary);
    border-radius: 0 8px 8px 0;
    padding-left: 10px;
  }

  .rules-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .rule-section {
    scroll-margin-top: 100px;
  }

  .rule-card {
    background: rgba(12, 13, 16, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px;
  }

  .rule-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    margin-top: 0;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rule-title span {
    background: var(--primary);
    
    color: #fff;
    font-size: 13px;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rules-list li {
    font-size: 14px;
    color: var(--text-main);
    line-height: 1.6;
    position: relative;
    padding-left: 20px;
  }

  .rules-list li::before {
    content: "•";
    color: var(--primary);
    font-weight: bold;
    position: absolute;
    left: 0;
    top: 0;
  }

  .robbery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .robbery-card {
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
  }

  .robbery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 10px;
    margin-bottom: 12px;
  }

  .robbery-level {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(var(--accent-rgb), 0.15);
    color: var(--primary-light);
  }

  .robbery-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    font-size: 12px;
    margin-bottom: 12px;
  }

  .robbery-detail-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .robbery-detail-label {
    color: var(--text-muted);
    font-size: 11px;
    
  }

  .robbery-detail-val {
    color: #fff;
    font-weight: 600;
  }

  .rules-alert {
    background: rgba(245, 158, 11, 0.03);
    border: 1px solid rgba(245, 158, 11, 0.15);
    padding: 16px;
    border-radius: 10px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .rules-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  .rules-table th, .rules-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    font-size: 13px;
  }
  .rules-table th {
    color: var(--text-muted);
    font-weight: 600;
  }

  @media (max-width: 991px) {
    .rules-container {
      grid-template-columns: 1fr;
    }
    .rules-sidebar {
      position: static;
      max-height: 300px;
    }
  }
</style>

