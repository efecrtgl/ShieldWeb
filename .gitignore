# ==========================================
# Shield Software — .gitignore
# Hassas Veriler, Bağımlılıklar ve Loglar
# ==========================================

# 1. Hassas Çevre ve Kimlik Doğrulama Dosyaları (Environment & Secrets)
.env
.env.*
!.env.example
.mcp.json
.mcp.json.bak

# 2. Bağımlılıklar (Node Modules)
node_modules/
**/node_modules/

# 3. Loglar ve Geçici Çalışma Verileri (Logs & Runtime)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# 4. Yüklenen Medya ve Arşiv Dosyaları (Uploads & Archives)
shared_data.json
*.bak
public/uploads/*
!public/uploads/.gitkeep
*.zip
*.rar
ps-web.zip
pswebOptimized.rar

# 5. IDE, Editör ve OS Özel Dosyaları
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# 6. Yapay Zeka & Agent Konfigürasyonları (Personalized Rules & BrainSync)
.agent/
.agent-mem/
.agents/
.brainsync/
.cursor/
.gemini/
.cline/
AGENT.md
CLAUDE.md
.cursorrules
.clineRules
.windsurfrules

# Auto-generated agent rules (personalized per developer)
.brainsync/agent-rules.md

# 7. Yerel araç ayarları ve FiveM köprü gizli anahtarı
.claude/
# shield-software/config.json holds the bridge secret; copy config.example.json and fill it in
shield-software/config.json

# 8. Design tooling output (inspector screenshots, direction sheet)
.taste-skill/
