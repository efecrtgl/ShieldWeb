# =====================================================================
# Shield Software — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# =====================================================================

# --- General ---------------------------------------------------------
NODE_ENV=development
PROJECT_NAME=Shield Software
SERVER_NAME=Shield Software
FOOTER_TEXT=Developed by realflexd & kai7m | Shield Software
# Public URL of the panel (CSRF origin checks, FiveM screen-upload URLs); same origin as the OAuth redirect_uri
SITE_URL=http://localhost:3000
# HTTP port of the gateway (GATEWAY_PORT wins over PORT)
GATEWAY_PORT=3000

# --- Database & sessions (required) ----------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/Shield
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=

# --- Discord OAuth2 login (required) ---------------------------------
# The ONE canonical login URL: Discord Developer Portal > OAuth2 > URL Generator (scopes: identify guilds).
# client_id, redirect_uri and scope are read from it. redirect_uri must:
#   - be registered under OAuth2 > Redirects exactly (scheme, host, port, path),
#   - end with /auth/callback and be the public address users open the panel on.
# Do not add a state parameter; a fresh one is generated for every login.
DISCORD_OAUTH_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&response_type=code&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Fauth%2Fcallback&scope=identify+guilds
DISCORD_CLIENT_SECRET=
# Optional legacy values; if set they must match DISCORD_OAUTH_URL
# DISCORD_CLIENT_ID=
# DISCORD_REDIRECT_URI=
# Session cookie SameSite: lax (default) | strict | none (none = Discord Activity embedding, HTTPS only)
SESSION_COOKIE_SAMESITE=lax

# Comma-separated Discord user ids with full panel access (MASTER_USERS is an accepted alias)
SUPERUSERS=

# --- Discord bot tokens (a bot without a token is not started) -------
BOT1_TOKEN=
BOT2_TOKEN=
BOT3_TOKEN=
BOT4_TOKEN=
BOT5_TOKEN=
# "true" when PM2 (or another supervisor) runs the bots instead of the gateway
PM2_DISCORD_SEPARATE=false

# --- Discord guild / role / channel ids ------------------------------
# Defaults only; most can be overridden at runtime in Admin > Developer settings.
DISCORD_GUILD_ID=
DISCORD_LOGGER_GUILD_ID=
DISCORD_WHITELIST_ROLE_ID=
DISCORD_UNREGISTERED_ROLE_ID=
DISCORD_STAFF_ROLE_ID=
DISCORD_VOICE_SUPPORT_ROLE_ID=
DISCORD_ILLEGAL_CATEGORY_ID=
DISCORD_LEGAL_CATEGORY_ID=
DISCORD_BUSINESS_CATEGORY_ID=
DISCORD_BOSS_ROLE_ID=
DISCORD_HIGH_COMMAND_ROLE_ID=
DISCORD_WL_PUNISHED_ROLE_ID=
DISCORD_WIPE_PUNISH_ROLE_ID=
DISCORD_ILLEGAL_BIRIM_ROLE_ID=
DISCORD_APPLICATION_LOG_CHANNEL_ID=
DISCORD_PUNISHMENT_LOG_CHANNEL_ID=
DISCORD_STREAMER_ANNOUNCE_CHANNEL_ID=

# --- FiveM bridge -----------------------------------------------------
# Shared HMAC secret; must match "secretKey" in shield-software/config.json on the game server
FIVEM_BRIDGE_SECRET=
# Comma-separated IPs allowed to call the bridge (localhost is always allowed)
FIVEM_BRIDGE_ALLOWED_IP=localhost

# --- Security ----------------------------------------------------------
# Extra origins allowed to send admin POST requests (comma-separated, e.g. a reverse-proxy domain)
CSRF_TRUSTED_ORIGINS=

# --- AI (IC name check) ------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Logging -----------------------------------------------------------
# LOG_DIR=./logs
LOG_RETENTION_DAYS=14
